+  }
+
+  if (section === 'tools') {
+    return (
+      <div className="grid gap-4 md:grid-cols-3">
+        {[
+          ['Terminal and process tools', 'Run local commands with exact working-directory visibility.', IconTerminal2, '/tui'],
+          ['Capabilities and skills', 'Inspect installed skills and local toolsets.', IconTool, '/skills'],
+          ['Desktop chat', 'Use file, browser, memory and agent tools through Hermes.', IconRocket, '/']
+        ].map(([label, detail, Icon, path]) => (
+          <button
+            className="rounded-xl border border-(--ui-stroke-secondary) bg-(--ui-panel-surface-background) p-5 text-left hover:border-(--ui-accent)/40"
+            key={String(label)}
+            onClick={() => onNavigate(path as string)}
+            type="button"
+          >
+            <Icon className="size-5 text-(--ui-accent)" stroke={1.7} />
+            <h3 className="mt-3 text-sm font-semibold">{label as string}</h3>
