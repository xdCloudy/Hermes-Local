+export type LocalAction =
+  | 'backup'
+  | 'benchmark'
+  | 'diagnostics'
+  | 'repair'
+  | 'restart'
+  | 'security'
+  | 'start'
+  | 'stop'
+  | 'test'
+  | 'update'
+
+export type LocalLog = 'dashboard' | 'hermes' | 'launcher' | 'model' | 'security' | 'supervisor'
+
+export interface LocalActionTask {
+  action: LocalAction
+  completedAt: null | string
+  exitCode: null | number
+  id: string
+  output: string
+  startedAt: string
+  status: 'failed' | 'running' | 'succeeded'
+}
+
+export interface LocalInferenceProfile {
+  batch: {
+    logical: number
+    physical: number
+  }
+  contextTokens: number
+  description: string
+  experimental?: boolean
+  flashAttention: boolean
+  gpu: {
+    layers: 'auto' | number
+    vramReserveMiB: number
+  }
+  kvCache: {
+    keyType: 'f16' | 'q4_0' | 'q8_0'
+    valueType: 'f16' | 'q4_0' | 'q8_0'
+  }
+  name: string
+  promptCache: boolean
+  seed?: number
+  speculativeDecoding: boolean
+  threads: {
+    batch: number
+    generation: number
+  }
+}
+
+export interface LocalWorkstationSnapshot {
+  actions: Record<LocalAction, boolean>
+  generatedAt: string
+  gpu: null | {
+    memoryFreeMiB: number
+    memoryTotalMiB: number
+    memoryUsedMiB: number
+    name: string
+    powerWatts: number
+    temperatureCelsius: number
+    utilizationPercent: number
+  }
+  hardware: {
+    cpu: string
+    logicalProcessors: number
+    memoryFreeBytes: number
+    memoryTotalBytes: number
+  }
+  health: {
+    dashboard: boolean
+    hermes: boolean
+    model: boolean
+  }
+  model: null | {
+    benchmarkProfile: string
+    context: {
+      experimentalMaximumTokens: number
+      extendedTokens: number
+      kvKeyType: string
+      kvValueType: string
+      selectedTokens: number
+    }
+    filename: string
+    localPath: string
+    metadata: {
+      architecture: string
+      modelMaximumContextTokens: number
+      nativeToolCalling: boolean
+      quantization: string
+      reasoning: string
+    }
+    revision: string
+    sha256: string
+    sizeBytes: number
+  }
+  profiles: null | {
+    profiles: LocalInferenceProfile[]
+    schemaVersion: number
+    selected: string
+    selectionStatus: string
+  }
+  reports: {
+    benchmark: boolean
+    security: boolean
+  }
+  root: string
+  storage: {
+    memoryFiles: number
+    stateDatabaseBytes: number
+  }
+  taskLedger: string
+  runtime: {
+    controllerAlive: boolean
+    controllerPid?: null | number
+    hermes?: {
+      healthy: boolean
+      pid: null | number
+      url: string
+    }
+    hermesAlive: boolean
+    message?: string
+    model?: {
+      healthy: boolean
+      pid: null | number
+      url: string
+    }
+    modelAlive: boolean
+    phase?: string
+    profile?: string
+    restartCount?: number
+    startedAt?: string
+    updatedAt?: string
+  }
+  version: null | {
+    product: {
+      name: string
+      status: string
+      version: string
+    }
+    sources: {
+      hermesAgent: { commit: string }
+      llamaCpp: { commit: string }
+    }
+  }
+}
+
+export interface LocalLogResult {
+  content: string
+  name: LocalLog
+  path: string
+}
