+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+vi.mock('electron', () => ({
+  ipcMain: { handle: vi.fn() },
+  shell: {
+    openExternal: vi.fn(),
+    openPath: vi.fn()
+  }
+}))
+
+import { hermesLocalControlTest } from './hermes-local-control'
+
+const originalRoot = process.env.HERMES_LOCAL_ROOT
+
+function validProfile() {
+  return {
+    batch: { logical: 1024, physical: 256 },
+    contextTokens: 65_536,
+    description: 'Interactive local profile',
+    flashAttention: true,
+    gpu: { layers: 'auto', vramReserveMiB: 1536 },
+    kvCache: { keyType: 'q8_0', valueType: 'q8_0' },
+    name: 'Daily',
+    promptCache: true,
+    speculativeDecoding: false,
+    threads: { batch: 14, generation: 8 }
+  }
+}
+
+describe('Hermes Local Electron boundary', () => {
+  beforeEach(() => {
+    process.env.HERMES_LOCAL_ROOT = 'D:\\Hermes-Local'
+  })
+
+  afterEach(() => {
+    if (originalRoot === undefined) {
+      delete process.env.HERMES_LOCAL_ROOT
+    } else {
+      process.env.HERMES_LOCAL_ROOT = originalRoot
+    }
+  })
+
+  it('rejects relative roots and paths that escape the fixed workstation root', () => {
+    process.env.HERMES_LOCAL_ROOT = 'relative-root'
+    expect(() => hermesLocalControlTest.localRoot()).toThrow(/must be absolute/i)
+
+    process.env.HERMES_LOCAL_ROOT = 'D:\\Hermes-Local'
+    expect(() => hermesLocalControlTest.resolveUnderRoot('..\\outside.txt')).toThrow(/escapes/i)
+    expect(hermesLocalControlTest.resolveUnderRoot('logs\\launcher\\launcher.log')).toBe(
+      'D:\\Hermes-Local\\logs\\launcher\\launcher.log'
+    )
+  })
+
+  it('redacts bearer tokens, named secrets, and long credential-like values', () => {
+    const secret = 'A'.repeat(64)
+
+    const output = hermesLocalControlTest.redacted(
+      `Authorization: Bearer abc.def.ghi token=${secret} password=hunter2 visible=healthy`
+    )
+
+    expect(output).not.toContain('abc.def.ghi')
+    expect(output).not.toContain(secret)
+    expect(output).not.toContain('hunter2')
+    expect(output).toContain('visible=healthy')
+  })
+
+  it('returns only the profile fields that the supervisor understands', () => {
+    const sanitized = hermesLocalControlTest.sanitizeEditableProfile({
+      ...validProfile(),
+      command: 'Remove-Item',
+      env: { PATH: 'unsafe' },
+      seed: 3407
+    }) as Record<string, unknown>
+
+    expect(sanitized).toMatchObject(validProfile())
+    expect(sanitized.seed).toBe(3407)
+    expect(sanitized).not.toHaveProperty('command')
+    expect(sanitized).not.toHaveProperty('env')
+  })
+
+  it('rejects unsafe names and out-of-range resource settings', () => {
+    expect(() =>
+      hermesLocalControlTest.sanitizeEditableProfile({ ...validProfile(), name: '..\\escape' })
+    ).toThrow(/invalid profile name/i)
+    expect(() =>
+      hermesLocalControlTest.sanitizeEditableProfile({ ...validProfile(), contextTokens: 1024 })
+    ).toThrow(/context must be an integer/i)
+  })
+})
diff --git a/apps/desktop/electron/hermes-local-control.ts b/apps/desktop/electron/hermes-local-control.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8a206a37af20d533dbdb6be54f5dfb9ea45ec9c3
--- /dev/null
+++ b/apps/desktop/electron/hermes-local-control.ts
@@ -0,0 +1,605 @@
+import { type ChildProcessWithoutNullStreams, execFile, execFileSync, spawn } from 'node:child_process'
+import crypto from 'node:crypto'
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+import { promisify } from 'node:util'
+
+import { ipcMain, shell } from 'electron'
+
+const execFileAsync = promisify(execFile)
+const DEFAULT_ROOT = 'D:\\Hermes-Local'
+const MAX_TASK_OUTPUT = 128 * 1024
+const MAX_LOG_BYTES = 512 * 1024
+const PROFILE_NAME = /^[A-Za-z][A-Za-z0-9 ]{0,31}$/
+
+const ACTION_SCRIPTS = {
+  backup: 'Backup-Hermes-Local.ps1',
+  benchmark: 'Benchmark-Hermes-Local.ps1',
+  diagnostics: 'Export-Hermes-Diagnostics.ps1',
+  repair: 'Repair-Hermes-Local.ps1',
+  restart: 'Restart-Hermes-Local.ps1',
+  security: 'Security-Scan-Hermes-Local.ps1',
+  start: 'Start-Hermes-Local.ps1',
+  stop: 'Stop-Hermes-Local.ps1',
+  test: 'Test-Hermes-Local.ps1',
+  update: 'Update-Hermes-Local.ps1'
+} as const
+
+const LOG_FILES = {
+  dashboard: 'logs\\dashboard\\dashboard.log',
+  hermes: 'data\\hermes\\logs\\gui.log',
+  launcher: 'logs\\launcher\\launcher.log',
+  model: 'logs\\model-server\\llama-server.log',
+  security: 'logs\\security\\security.log',
+  supervisor: 'logs\\supervisor\\supervisor.log'
+} as const
+
+type ActionName = keyof typeof ACTION_SCRIPTS
+type LogName = keyof typeof LOG_FILES
+
+interface ActionTask {
+  action: ActionName
+  child: ChildProcessWithoutNullStreams
+  completedAt: null | string
+  exitCode: null | number
+  id: string
+  output: string
+  startedAt: string
+  status: 'failed' | 'running' | 'succeeded'
+}
+
+const tasks = new Map<string, ActionTask>()
+const runningActions = new Map<ActionName, string>()
+
+function powershellExecutable(): string {
+  const systemRoot = process.env.SystemRoot || 'C:\\Windows'
+
+  const candidates = [
+    process.env.HERMES_LOCAL_PWSH,
+    path.join(process.env.ProgramFiles || 'C:\\Program Files', 'PowerShell', '7', 'pwsh.exe')
+  ]
+
+  try {
+    const where = path.join(systemRoot, 'System32', 'where.exe')
+
+    const discovered = execFileSync(where, ['pwsh.exe'], {
+      encoding: 'utf8',
+      maxBuffer: 16 * 1024,
+      timeout: 5000,
+      windowsHide: true
+    })
+
+    candidates.push(...discovered.split(/\r?\n/).map(value => value.trim()))
+  } catch {
+    // Continue to the built-in Windows PowerShell fallback.
+  }
+
+  candidates.push(path.join(systemRoot, 'System32', 'WindowsPowerShell', 'v1.0', 'powershell.exe'))
+
+  const resolved = candidates.find(candidate => candidate && path.isAbsolute(candidate) && fs.existsSync(candidate))
+
+  if (!resolved) {
+    throw new Error('PowerShell is not installed')
+  }
+
+  return resolved
+}
+
+function localRoot(): string {
+  const configured = String(process.env.HERMES_LOCAL_ROOT || DEFAULT_ROOT).trim()
+
+  if (!path.isAbsolute(configured)) {
+    throw new Error('HERMES_LOCAL_ROOT must be absolute')
+  }
+
+  return path.resolve(configured)
+}
+
+function resolveUnderRoot(relativePath: string): string {
+  const root = localRoot()
+  const resolved = path.resolve(root, relativePath)
+  const prefix = `${root.toLocaleLowerCase()}${path.sep}`
+
+  if (resolved.toLocaleLowerCase() !== root.toLocaleLowerCase() && !resolved.toLocaleLowerCase().startsWith(prefix)) {
+    throw new Error('Path escapes the Hermes Local root')
+  }
+
+  return resolved
+}
+
+function readJson<T>(relativePath: string): null | T {
+  const filePath = resolveUnderRoot(relativePath)
+
+  try {
+    return JSON.parse(fs.readFileSync(filePath, 'utf8')) as T
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') {
+      return null
+    }
+
+    throw error
+  }
+}
+
+function redacted(text: string): string {
+  return text
+    .replace(/(authorization\s*[:=]\s*bearer\s+)[^\s"']+/gi, '$1[REDACTED]')
+    .replace(/((?:api[_-]?key|password|secret|token)\s*[:=]\s*)[^\s,"']+/gi, '$1[REDACTED]')
+    .replace(/[A-Za-z0-9_-]{48,}/g, '[REDACTED-LONG-VALUE]')
+}
+
+function appendTaskOutput(task: ActionTask, chunk: Buffer | string): void {
+  const next = `${task.output}${redacted(String(chunk))}`
+  task.output = next.length > MAX_TASK_OUTPUT ? next.slice(next.length - MAX_TASK_OUTPUT) : next
+}
+
+function publicTask(task: ActionTask) {
+  return {
+    action: task.action,
+    completedAt: task.completedAt,
+    exitCode: task.exitCode,
+    id: task.id,
+    output: task.output,
+    startedAt: task.startedAt,
+    status: task.status
+  }
+}
+
+function validProfileName(value: unknown): string {
+  const profile = String(value || 'Daily').trim()
+
+  if (!PROFILE_NAME.test(profile)) {
+    throw new Error('Invalid profile name')
+  }
+
+  return profile
+}
+
+function startActionTask(actionValue: unknown, input: unknown) {
+  const action = String(actionValue || '') as ActionName
+  const scriptRelative = ACTION_SCRIPTS[action]
+
+  if (!scriptRelative) {
+    throw new Error('Unsupported Hermes Local action')
+  }
+
+  const existingId = runningActions.get(action)
+  const existing = existingId ? tasks.get(existingId) : null
+
+  if (existing?.status === 'running') {
+    return publicTask(existing)
+  }
+
+  const scriptPath = resolveUnderRoot(scriptRelative)
+
+  if (!fs.existsSync(scriptPath)) {
+    throw new Error(`${scriptRelative} is not installed`)
+  }
+
+  const executable = powershellExecutable()
+  const args = ['-NoLogo', '-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Bypass', '-File', scriptPath]
+  const payload = input && typeof input === 'object' ? (input as Record<string, unknown>) : {}
+
+  if (action === 'start' || action === 'restart') {
+    args.push('-Profile', validProfileName(payload.profile))
+  }
+
+  if (action === 'update') {
+    args.push('-Mode', 'Check')
+  }
+
+  args.push('-NonInteractive')
+
+  const child = spawn(executable, args, {
+    cwd: localRoot(),
+    env: {
+      ...process.env,
+      HERMES_LOCAL_ROOT: localRoot()
+    },
+    shell: false,
+    windowsHide: true
+  })
+
+  const id = crypto.randomUUID()
+
+  const task: ActionTask = {
+    action,
+    child,
+    completedAt: null,
+    exitCode: null,
+    id,
+    output: '',
+    startedAt: new Date().toISOString(),
+    status: 'running'
+  }
+
+  tasks.set(id, task)
+  runningActions.set(action, id)
+  child.stdout.on('data', chunk => appendTaskOutput(task, chunk))
+  child.stderr.on('data', chunk => appendTaskOutput(task, chunk))
+  child.on('error', error => appendTaskOutput(task, `\n${error.message}\n`))
+  child.on('close', code => {
+    task.completedAt = new Date().toISOString()
+    task.exitCode = code
+    task.status = code === 0 ? 'succeeded' : 'failed'
+    runningActions.delete(action)
+  })
+
+  return publicTask(task)
+}
+
+function getActionTask(taskId: unknown) {
+  const task = tasks.get(String(taskId || ''))
+
+  if (!task) {
+    throw new Error('Hermes Local task not found')
+  }
+
+  return publicTask(task)
+}
+
+async function health(url: string): Promise<boolean> {
+  try {
+    const response = await fetch(url, { signal: AbortSignal.timeout(2500) })
+
+    return response.ok
+  } catch {
+    return false
+  }
+}
+
+async function gpuSnapshot() {
+  if (process.platform !== 'win32') {
+    return null
+  }
+
+  try {
+    const { stdout } = await execFileAsync(
+      'nvidia-smi.exe',
+      [
+        '--query-gpu=name,memory.total,memory.used,memory.free,utilization.gpu,temperature.gpu,power.draw',
+        '--format=csv,noheader,nounits'
+      ],
+      { timeout: 5000, windowsHide: true }
+    )
+
+    const values = stdout
+      .trim()
+      .split(',')
+      .map(value => value.trim())
+
+    if (values.length < 7) {
+      return null
+    }
+
+    return {
+      memoryFreeMiB: Number(values[3]) || 0,
+      memoryTotalMiB: Number(values[1]) || 0,
+      memoryUsedMiB: Number(values[2]) || 0,
+      name: values[0],
+      powerWatts: Number(values[6]) || 0,
+      temperatureCelsius: Number(values[5]) || 0,
+      utilizationPercent: Number(values[4]) || 0
+    }
+  } catch {
+    return null
+  }
+}
+
+function processAlive(pid: unknown): boolean {
+  const value = Number(pid)
+
+  if (!Number.isSafeInteger(value) || value <= 0) {
+    return false
+  }
+
+  try {
+    process.kill(value, 0)
+
+    return true
+  } catch {
+    return false
+  }
+}
+
+async function workstationSnapshot() {
+  const state = readJson<Record<string, any>>('data\\runtime\\status.json')
+  const profiles = readJson<Record<string, any>>('config\\profiles\\profiles.json')
+  const model = readJson<Record<string, any>>('models\\manifests\\Laguna-XS-2.1-Q4_K_M.json')
+  const version = readJson<Record<string, any>>('VERSION.json')
+
+  const [modelHealthy, hermesHealthy, dashboardHealthy, gpu] = await Promise.all([
+    health('http://127.0.0.1:8011/health'),
+    health('http://127.0.0.1:9119/api/health'),
+    health('http://127.0.0.1:9119/api/health'),
+    gpuSnapshot()
+  ])
+
+  const actions = Object.fromEntries(
+    Object.entries(ACTION_SCRIPTS).map(([name, relativePath]) => [name, fs.existsSync(resolveUnderRoot(relativePath))])
+  )
+
+  return {
+    actions,
+    generatedAt: new Date().toISOString(),
+    hardware: {
+      cpu: os.cpus()[0]?.model || 'Unknown CPU',
+      logicalProcessors: os.cpus().length,
+      memoryFreeBytes: os.freemem(),
+      memoryTotalBytes: os.totalmem()
+    },
+    health: {
+      dashboard: dashboardHealthy,
+      hermes: hermesHealthy,
+      model: modelHealthy
+    },
+    model,
+    profiles,
+    reports: {
+      benchmark: fs.existsSync(resolveUnderRoot('benchmarks\\reports\\LATEST.md')),
+      security: fs.existsSync(resolveUnderRoot('security\\reports\\SECURITY_REPORT.md'))
+    },
+    root: localRoot(),
+    storage: {
+      memoryFiles: fs.existsSync(resolveUnderRoot('data\\memory'))
+        ? fs.readdirSync(resolveUnderRoot('data\\memory'), { withFileTypes: true }).filter(entry => entry.isFile()).length
+        : 0,
+      stateDatabaseBytes: fs.existsSync(resolveUnderRoot('data\\hermes\\state.db'))
+        ? fs.statSync(resolveUnderRoot('data\\hermes\\state.db')).size
+        : 0
+    },
+    taskLedger: fs.existsSync(resolveUnderRoot('TASKS.md'))
+      ? fs.readFileSync(resolveUnderRoot('TASKS.md'), 'utf8').slice(0, 128 * 1024)
+      : '',
+    runtime: {
+      ...state,
+      controllerAlive: processAlive(state?.controllerPid),
+      hermesAlive: processAlive(state?.hermes?.pid),
+      modelAlive: processAlive(state?.model?.pid)
+    },
+    version,
+    gpu
+  }
+}
+
+function readLog(nameValue: unknown, requestedLines: unknown) {
+  const name = String(nameValue || '') as LogName
+  const relativePath = LOG_FILES[name]
+
+  if (!relativePath) {
+    throw new Error('Unsupported log')
+  }
+
+  const filePath = resolveUnderRoot(relativePath)
+
+  if (!fs.existsSync(filePath)) {
+    return { content: '', name, path: filePath }
+  }
+
+  const stats = fs.statSync(filePath)
+  const length = Math.min(stats.size, MAX_LOG_BYTES)
+  const handle = fs.openSync(filePath, 'r')
+  const buffer = Buffer.alloc(length)
+
+  try {
+    fs.readSync(handle, buffer, 0, length, Math.max(0, stats.size - length))
+  } finally {
+    fs.closeSync(handle)
+  }
+
+  const lineCount = Math.min(2000, Math.max(20, Number(requestedLines) || 400))
+  const content = redacted(buffer.toString('utf8').split(/\r?\n/).slice(-lineCount).join('\n'))
+
+  return { content, name, path: filePath }
+}
+
+function sanitizeEditableProfile(value: unknown) {
+  if (!value || typeof value !== 'object') {
+    throw new Error('Profile must be an object')
+  }
+
+  const candidate = structuredClone(value as Record<string, unknown>)
+  const name = validProfileName(candidate.name)
+
+  const integer = (candidate: unknown, minimum: number, maximum: number, label: string) => {
+    const parsed = Number(candidate)
+
+    if (!Number.isSafeInteger(parsed) || parsed < minimum || parsed > maximum) {
+      throw new Error(`${label} must be an integer from ${minimum} to ${maximum}`)
+    }
+
+    return parsed
+  }
+
+  const batch = candidate.batch && typeof candidate.batch === 'object' ? candidate.batch as Record<string, unknown> : {}
+  const gpu = candidate.gpu && typeof candidate.gpu === 'object' ? candidate.gpu as Record<string, unknown> : {}
+  const kvCache = candidate.kvCache && typeof candidate.kvCache === 'object' ? candidate.kvCache as Record<string, unknown> : {}
+  const threads = candidate.threads && typeof candidate.threads === 'object' ? candidate.threads as Record<string, unknown> : {}
+  const description = String(candidate.description || '').trim().slice(0, 240)
+
+  const keyType = typeof kvCache.keyType === 'string' && ['f16', 'q8_0', 'q4_0'].includes(kvCache.keyType)
+    ? kvCache.keyType
+    : 'q8_0'
+
+  const valueType = typeof kvCache.valueType === 'string' && ['f16', 'q8_0', 'q4_0'].includes(kvCache.valueType)
+    ? kvCache.valueType
+    : 'q8_0'
+
+  const profile: Record<string, unknown> = {
+    batch: {
+      logical: integer(batch.logical, 32, 4096, 'Batch size'),
+      physical: integer(batch.physical, 16, 1024, 'Micro-batch size')
+    },
+    contextTokens: integer(candidate.contextTokens, 4096, 262144, 'Context'),
+    description,
+    flashAttention: Boolean(candidate.flashAttention),
+    gpu: {
+      layers:
+        gpu.layers === 'auto'
+        ? 'auto'
+        : integer(gpu.layers, 0, 999, 'GPU layers'),
+      vramReserveMiB: integer(gpu.vramReserveMiB, 512, 8192, 'VRAM reserve')
+    },
+    kvCache: { keyType, valueType },
+    name,
+    promptCache: Boolean(candidate.promptCache),
+    speculativeDecoding: Boolean(candidate.speculativeDecoding),
+    threads: {
+      batch: integer(threads.batch, 1, 20, 'Batch threads'),
+      generation: integer(threads.generation, 1, 20, 'Generation threads')
+    }
+  }
+
+  if (candidate.experimental === true) {
+    profile.experimental = true
+  }
+
+  if (candidate.seed !== undefined) {
+    profile.seed = integer(candidate.seed, 0, 2_147_483_647, 'Seed')
+  }
+
+  return profile
+}
+
+function saveProfile(value: unknown) {
+  const profile = sanitizeEditableProfile(value)
+  const profilesPath = resolveUnderRoot('config\\profiles\\profiles.json')
+  const document = readJson<Record<string, any>>('config\\profiles\\profiles.json')
+
+  if (!document || !Array.isArray(document.profiles)) {
+    throw new Error('Profiles configuration is unavailable')
+  }
+
+  const index = document.profiles.findIndex((entry: Record<string, unknown>) => entry?.name === profile.name)
+
+  if (index < 0) {
+    throw new Error('Only existing profiles can be edited')
+  }
+
+  document.profiles[index] = profile
+  const temporary = `${profilesPath}.${process.pid}.${Date.now()}.tmp`
+  fs.writeFileSync(temporary, `${JSON.stringify(document, null, 2)}\n`, { encoding: 'utf8', flag: 'wx' })
+  fs.renameSync(temporary, profilesPath)
+
+  return profile
+}
+
+function selectProfile(nameValue: unknown) {
+  const name = validProfileName(nameValue)
+  const profilesPath = resolveUnderRoot('config\\profiles\\profiles.json')
+  const document = readJson<Record<string, any>>('config\\profiles\\profiles.json')
+
+  if (!document || !Array.isArray(document.profiles)) {
+    throw new Error('Profiles configuration is unavailable')
+  }
+
+  if (!document.profiles.some((profile: Record<string, unknown>) => profile?.name === name)) {
+    throw new Error('Profile does not exist')
+  }
+
+  document.selected = name
+  document.selectionStatus = 'user-selected'
+  const temporary = `${profilesPath}.${process.pid}.${Date.now()}.tmp`
+  fs.writeFileSync(temporary, `${JSON.stringify(document, null, 2)}\n`, { encoding: 'utf8', flag: 'wx' })
+  fs.renameSync(temporary, profilesPath)
+
+  return { name }
+}
+
+export function hermesLocalTuiLaunch() {
+  const root = localRoot()
+  const scriptPath = resolveUnderRoot('scripts\\launch\\Start-Hermes-Tui.ps1')
+
+  if (!fs.existsSync(scriptPath)) {
+    throw new Error('Hermes Local TUI launcher is not installed')
+  }
+
+  const command = powershellExecutable()
+
+  return {
+    args: ['-NoLogo', '-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', scriptPath],
+    command,
+    cwd: resolveUnderRoot('data\\user'),
+    env: {
+      ...process.env,
+      HERMES_HOME: resolveUnderRoot('data\\hermes'),
+      HERMES_LOCAL_ROOT: root
+    },
+    name: 'Hermes TUI'
+  }
+}
+
+export function configureHermesLocalDesktopEnvironment(): boolean {
+  if (process.platform !== 'win32') {
+    return false
+  }
+
+  const root = localRoot()
+  const tokenScript = resolveUnderRoot('scripts\\launch\\Get-Hermes-Local-Token.ps1')
+  const hermesHome = resolveUnderRoot('data\\hermes')
+  const sourceRoot = resolveUnderRoot('source\\hermes-agent')
+
+  if (!fs.existsSync(tokenScript) || !fs.existsSync(sourceRoot)) {
+    return false
+  }
+
+  process.env.HERMES_LOCAL_ROOT = root
+  process.env.HERMES_HOME = hermesHome
+  process.env.HERMES_DESKTOP_CWD = resolveUnderRoot('data\\user')
+  process.env.HERMES_DESKTOP_HERMES_ROOT = sourceRoot
+
+  if (!process.env.HERMES_DESKTOP_REMOTE_URL) {
+    const pwsh = powershellExecutable()
+
+    const token = execFileSync(
+      pwsh,
+      ['-NoLogo', '-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Bypass', '-File', tokenScript],
+      {
+        encoding: 'utf8',
+        maxBuffer: 4096,
+        timeout: 10_000,
+        windowsHide: true
+      }
+    ).trim()
+
+    if (!/^[A-Za-z0-9_-]{40,128}$/.test(token)) {
+      throw new Error('Hermes Local returned an invalid protected session token')
+    }
+
+    process.env.HERMES_DESKTOP_REMOTE_TOKEN = token
+    process.env.HERMES_DESKTOP_REMOTE_URL = 'http://127.0.0.1:9119'
+  }
+
+  return true
+}
+
+export function registerHermesLocalControlIpc(): void {
+  ipcMain.handle('hermes:local:snapshot', workstationSnapshot)
+  ipcMain.handle('hermes:local:action:start', (_event, action, input) => startActionTask(action, input))
+  ipcMain.handle('hermes:local:action:status', (_event, taskId) => getActionTask(taskId))
+  ipcMain.handle('hermes:local:logs', (_event, name, lines) => readLog(name, lines))
+  ipcMain.handle('hermes:local:profile:save', (_event, profile) => saveProfile(profile))
+  ipcMain.handle('hermes:local:profile:select', (_event, name) => selectProfile(name))
+  ipcMain.handle('hermes:local:dashboard:open', async () => {
+    const url = 'http://127.0.0.1:9119'
+
+    await shell.openExternal(url)
+
+    return { url }
+  })
+  ipcMain.handle('hermes:local:root:open', async () => {
+    const error = await shell.openPath(localRoot())
+
+    return { error, ok: !error }
+  })
+}
+
+export const hermesLocalControlTest = {
+  configureHermesLocalDesktopEnvironment,
+  localRoot,
+  powershellExecutable,
+  redacted,
+  resolveUnderRoot,
+  sanitizeEditableProfile
+}
