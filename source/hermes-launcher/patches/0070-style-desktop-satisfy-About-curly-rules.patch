From 8888888888888888888888888888888888888888 Mon Sep 17 00:00:00 2001
From: OpenAI <openai@localhost>
Date: Fri, 7 Aug 2026 19:52:00 +0100
Subject: [PATCH] style(desktop): satisfy About curly rules

---
 apps/desktop/src/app/local-workstation/about-hub.tsx | 10 ++++++++--
 apps/desktop/src/app/settings/startup-settings.tsx    |  4 +++-
 2 files changed, 11 insertions(+), 3 deletions(-)

diff --git a/apps/desktop/src/app/local-workstation/about-hub.tsx b/apps/desktop/src/app/local-workstation/about-hub.tsx
--- a/apps/desktop/src/app/local-workstation/about-hub.tsx
+++ b/apps/desktop/src/app/local-workstation/about-hub.tsx
@@ -50,3 +50,5 @@ function size(value: number) {
-  if (!Number.isFinite(value) || value <= 0) return '0 B'
+  if (!Number.isFinite(value) || value <= 0) {
+    return '0 B'
+  }
   const units = ['B', 'KiB', 'MiB', 'GiB', 'TiB']
   let amount = value
@@ -87,4 +89,8 @@ export function detectInstallationType(snapshot: LocalWorkstationSnapshot) {
   const executable = snapshot.startup.executable.toLowerCase()
-  if (executable.includes('portable')) return 'Portable'
-  if (executable.endsWith('\\electron.exe') || executable.includes('\\node_modules\\electron\\')) return 'Development checkout'
+  if (executable.includes('portable')) {
+    return 'Portable'
+  }
+  if (executable.endsWith('\\electron.exe') || executable.includes('\\node_modules\\electron\\')) {
+    return 'Development checkout'
+  }
   return 'Installed'
 }
diff --git a/apps/desktop/src/app/settings/startup-settings.tsx b/apps/desktop/src/app/settings/startup-settings.tsx
--- a/apps/desktop/src/app/settings/startup-settings.tsx
+++ b/apps/desktop/src/app/settings/startup-settings.tsx
@@ -30,3 +30,5 @@ export function StartupSettings() {
-    if (!status?.available || saving) return
+    if (!status?.available || saving) {
+      return
+    }
 
     setSaving(true)
-- 
