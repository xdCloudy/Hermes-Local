diff --git a/tests/security/test_xml_hardening.py b/tests/security/test_xml_hardening.py
new file mode 100644
index 000000000..542891cc5
--- /dev/null
+++ b/tests/security/test_xml_hardening.py
@@ -0,0 +1,61 @@
+"""Regression tests for untrusted network XML parsing."""
+
+from __future__ import annotations
+
+import importlib.util
+import sys
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+from defusedxml.common import DefusedXmlException
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+ENTITY_XML = (
+    b'<?xml version="1.0"?>'
+    b'<!DOCTYPE feed [<!ENTITY injected "EXPANDED">]>'
+    b"<feed><entry><id>&injected;</id></entry></feed>"
+)
+
+
+def _load_script(name: str, relative_path: str):
+    path = REPO_ROOT / relative_path
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec and spec.loader
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_rss_watcher_rejects_entity_expansion():
+    watcher = _load_script(
+        "security_test_watch_rss",
+        "optional-skills/devops/watchers/scripts/watch_rss.py",
+    )
+
+    with pytest.raises(SystemExit) as exc_info:
+        watcher._parse_feed(ENTITY_XML)
+
+    assert exc_info.value.code == 2
+
+
+def test_arxiv_parser_rejects_entity_expansion():
+    arxiv = _load_script(
+        "security_test_search_arxiv",
+        "skills/research/arxiv/scripts/search_arxiv.py",
+    )
+
+    class Response:
+        def __enter__(self):
+            return self
+
+        def __exit__(self, *_args):
+            return False
+
+        def read(self):
+            return ENTITY_XML
+
+    with patch.object(arxiv.urllib.request, "urlopen", return_value=Response()):
+        with pytest.raises(DefusedXmlException):
+            arxiv.search(query="security-regression")
