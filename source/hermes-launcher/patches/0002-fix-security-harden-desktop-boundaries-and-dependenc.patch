+  assert.equal(
+    shouldAllowRendererPermission(
+      {
+        details: { mediaTypes: ['audio'] },
+        hasWindowOwner: true,
+        permission: 'media',
+        url: packaged.packagedRendererUrl,
+      },
+      packaged,
+    ),
+    true,
+  )
+})
+
+test('denies video and non-media permissions by default', () => {
+  for (const request of [
