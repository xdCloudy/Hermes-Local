+def _set_session_project(
+    session: dict, project_id: str | None
+) -> tuple[str | None, dict | None, str]:
+    """Atomically attach/switch/detach a session by stable Project identity."""
+    selected = str(project_id or "").strip() or None
+    if selected is None:
+        _clear_session_cwd(session)
+        return None, None, ""
+
+    project = _project_info_for_id(selected, session)
+    if project is None:
+        raise ValueError(f"project is unavailable or does not exist: {selected}")
+
+    project_cwd = str(project.get("primary_path") or "").strip()
+    if not project_cwd:
+        raise ValueError(f"project has no usable primary folder: {selected}")
+
+    resolved = _set_session_cwd(session, project_cwd)
+    session["project_id"] = selected
+    with _session_db(session) as db:
+        if db is not None:
+            try:
+                db.update_session_project(session.get("session_key", ""), selected)
+            except Exception:
+                logger.debug("failed to persist session project", exc_info=True)
+    return selected, project, resolved
+
