+def test_desktop_session_project_switch_persists_stable_identity(monkeypatch, tmp_path):
+    first = tmp_path / "first-project"
+    second = tmp_path / "second-project"
+    first.mkdir()
+    second.mkdir()
+    first_project = _call(
+        "projects.create", {"name": "First project", "folders": [str(first)]}
+    )["project"]
+    second_project = _call(
+        "projects.create", {"name": "Second project", "folders": [str(second)]}
+    )["project"]
+
+    monkeypatch.setattr(server, "_schedule_agent_build", lambda *_args, **_kwargs: None)
+    monkeypatch.setattr(server, "_schedule_session_cap_enforcement", lambda: None)
+
+    created = _call(
+        "session.create",
+        {
+            "source": "desktop",
+            # Deliberately conflicts with the chosen stable identity. The
+            # project id must win and choose the registered project root.
+            "cwd": str(first),
+            "project_id": second_project["id"],
+        },
+    )
+    sid = created["session_id"]
+    stored_id = created["stored_session_id"]
+
+    try:
+        assert created["info"]["project_id"] == second_project["id"]
+        assert created["info"]["cwd"] == str(second)
+        assert created["info"]["project"]["id"] == second_project["id"]
+
+        # Materialise the lazy session row so the switch proves durable state,
+        # not merely the in-memory runtime dictionary.
+        server._get_db().create_session(stored_id, "desktop")
+
+        switched = _call(
+            "session.cwd.set",
+            {
+                "session_id": sid,
+                "cwd": str(second),
+                "project_id": first_project["id"],
+            },
+        )
+        assert switched["project_id"] == first_project["id"]
+        assert switched["cwd"] == str(first)
+        assert server._get_db().get_session(stored_id)["project_id"] == first_project["id"]
+
+        # A raw cwd change is execution context only; it must detach the stable
+        # project instead of silently path-matching the same folder back in.
+        raw = _call("session.cwd.set", {"session_id": sid, "cwd": str(first)})
+        assert raw["project_id"] is None
+        assert raw["project"] is None
+        assert raw["branch"] == ""
+        assert server._get_db().get_session(stored_id)["project_id"] is None
+
+        detached = _call(
+            "session.cwd.set",
+            {"session_id": sid, "cwd": "", "project_id": None},
+        )
+        assert detached["project_id"] is None
+        assert detached["project"] is None
+        assert detached["cwd"] == ""
+    finally:
+        server._sessions.pop(sid, None)
