From: OpenAI <openai@localhost>
Date: Fri, 7 Aug 2026 20:12:00 +0100
Subject: [PATCH] test(desktop): cover bounded About path reveal

---
 apps/desktop/src/app/local-workstation/about-hub.test.tsx | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/apps/desktop/src/app/local-workstation/about-hub.test.tsx b/apps/desktop/src/app/local-workstation/about-hub.test.tsx
--- a/apps/desktop/src/app/local-workstation/about-hub.test.tsx
+++ b/apps/desktop/src/app/local-workstation/about-hub.test.tsx
@@ -148,19 +148,20 @@
 function installBridge() {
+  const openPath = vi.fn(async (relativePath: string) => ({ error: '', ok: true, path: `D:\\Hermes-Local\\${relativePath}` }))
   const openRoot = vi.fn(async () => ({ error: '', ok: true }))
   const openExternal = vi.fn(async () => true)
   const writeText = vi.fn(async () => undefined)
 
   Object.defineProperty(window, 'hermesDesktop', {
     configurable: true,
     value: {
-      localWorkstation: { openRoot },
+      localWorkstation: { openPath, openRoot },
       openExternal
     }
   })
   Object.defineProperty(navigator, 'clipboard', {
     configurable: true,
     value: { writeText }
   })
 
-  return { openExternal, openRoot, writeText }
+  return { openExternal, openPath, openRoot, writeText }
 }
@@ -204,3 +205,11 @@
   })
 
+  it('reveals each important path through the bounded path bridge', () => {
+    const { openPath } = installBridge()
+    render(<AboutHub onNavigate={vi.fn()} onRun={vi.fn()} snapshot={makeSnapshot()} />)
+
+    fireEvent.click(screen.getByRole('button', { name: 'Reveal Models' }))
+    expect(openPath).toHaveBeenCalledWith('models')
+  })
+
   it('routes project links through the desktop external-link boundary', () => {
