From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hermes Local Integration <hermes-local-ci@localhost>
Date: Mon, 10 Aug 2026 21:10:20 +0100
Subject: [PATCH] feat(projects): add Project Centre lifecycle RPCs

diff --git a/tui_gateway/server.py b/tui_gateway/server.py
--- a/tui_gateway/server.py
+++ b/tui_gateway/server.py
@@ -11342,8 +11342,68 @@ def _(rid, params, pdb, conn) -> dict:
     return _ok(rid, _projects_payload(conn))
 
 
+@_projects_method("projects.centre")
+def _(rid, params, pdb, conn) -> dict:
+    return _ok(rid, _project_centre_payload(conn))
+
+
+@_projects_method("projects.pin")
+def _(rid, params, pdb, conn) -> dict:
+    from hermes_cli import project_lifecycle
+
+    proj = _require_project(pdb, conn, params)
+    project_lifecycle.set_project_pinned(conn, proj.id, bool(params.get("pinned")))
+    return _ok(rid, _project_centre_payload(conn))
+
+
+@_projects_method("projects.clone")
+def _(rid, params, pdb, conn) -> dict:
+    from hermes_cli import project_lifecycle
+
+    proj = project_lifecycle.clone_project(
+        conn,
+        repository_url=str(params.get("repository_url") or ""),
+        parent_path=str(params.get("parent_path") or ""),
+        directory_name=params.get("directory_name"),
+        name=str(params.get("name") or ""),
+    )
+    if params.get("use"):
+        pdb.set_active(conn, proj.id)
+    return _ok(rid, {"project": proj.to_dict()})
+
+
+@_projects_method("projects.remove")
+def _(rid, params, pdb, conn) -> dict:
+    from hermes_cli import project_lifecycle
+
+    proj = _require_project(pdb, conn, params)
+    pdb.delete_project(conn, proj.id)
+    project_lifecycle.clear_project_pin(conn, proj.id)
+    return _ok(rid, _project_centre_payload(conn))
+
+
+@_projects_method("projects.delete_files")
+def _(rid, params, pdb, conn) -> dict:
+    from hermes_cli import project_lifecycle
+
+    proj = _require_project(pdb, conn, params)
+    deleted_paths = project_lifecycle.delete_registered_files(
+        proj, str(params.get("confirmation") or "")
+    )
+    pdb.delete_project(conn, proj.id)
+    project_lifecycle.clear_project_pin(conn, proj.id)
+    payload = _project_centre_payload(conn)
+    payload["deleted_paths"] = deleted_paths
+    return _ok(rid, payload)
+
+
 @_projects_method("projects.delete")
 def _(rid, params, pdb, conn) -> dict:
+    # Backward-compatible registration-only removal. Filesystem deletion is
+    # intentionally exclusive to projects.delete_files + typed confirmation.
+    from hermes_cli import project_lifecycle
+
     proj = _require_project(pdb, conn, params)
     pdb.delete_project(conn, proj.id)
+    project_lifecycle.clear_project_pin(conn, proj.id)
     return _ok(rid, _projects_payload(conn))
