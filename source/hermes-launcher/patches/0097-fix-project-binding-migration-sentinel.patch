From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hermes Local Integration <hermes-local-ci@localhost>
Date: Sat, 8 Aug 2026 18:42:00 +0100
Subject: [PATCH] fix(projects): preserve explicit projectless bindings

Use NULL as the legacy/unmigrated project binding and the empty string as the
durable explicit-projectless sentinel. This lets existing sessions keep their
cwd-based one-time migration while ensuring a chat the user detached never
silently reattaches to a project after restart.
---
 apps/desktop/src/app/chat/sidebar/projects/workspace-groups.ts | 8 +++++---
 hermes_state.py                                                | 8 ++++----
 tests/tui_gateway/test_project_tree.py                         | 14 ++++++++++++++
 tests/tui_gateway/test_projects_rpc.py                         | 2 +-
 tui_gateway/methods_session.py                                 | 14 ++++++++++----
 tui_gateway/project_tree.py                                    | 2 +-
 tui_gateway/server.py                                          | 17 ++++++++++++-----
 7 files changed, 47 insertions(+), 18 deletions(-)

diff --git a/hermes_state.py b/hermes_state.py
--- a/hermes_state.py
+++ b/hermes_state.py
@@ -3610,7 +3610,7 @@ class SessionDB(SessionSearchMixin, SessionSchemaMixin, SessionPortabilityMixin):
         def _do(conn):
             conn.execute(
                 "UPDATE sessions SET cwd = NULL, git_branch = NULL, git_repo_root = NULL, "
-                "project_id = NULL WHERE id = ?",
+                "project_id = '' WHERE id = ?",
                 (session_id,),
             )
 
@@ -3619,8 +3619,8 @@ class SessionDB(SessionSearchMixin, SessionSchemaMixin, SessionPortabilityMixin):
     def update_session_project(self, session_id: str, project_id: Optional[str]) -> None:
-        """Persist the stable Project owning a session, or detach it."""
+        """Persist a stable Project id, or '' for an explicit projectless binding."""
         if not session_id:
             return
-        value = str(project_id or "").strip() or None
+        value = str(project_id or "").strip()
 
         def _do(conn):
             conn.execute(
diff --git a/tui_gateway/server.py b/tui_gateway/server.py
--- a/tui_gateway/server.py
+++ b/tui_gateway/server.py
@@ -2722,8 +2722,8 @@ def _ensure_session_db_row(session: dict) -> None:
             # means the launch/default profile (matches run_agent's convention).
             profile_name=Path(profile_home).name if profile_home else None,
         )
-        project_id = str(session.get("project_id") or "").strip()
-        if project_id:
-            db.update_session_project(key, project_id)
+        # Presence is authority: None means the user explicitly chose No project.
+        if "project_id" in session:
+            db.update_session_project(key, session.get("project_id"))
     except Exception as exc:
         # Disk-full is not a soft failure: if we swallow it here, prompt.submit
@@ -2953,11 +2953,17 @@ def _session_project_identity(
     key = str(session.get("session_key") or "").strip()
     if key:
         try:
             with _session_db(session) as db:
                 row = db.get_session(key) if db is not None else None
-            selected = str((row or {}).get("project_id") or "").strip() or None
-            if selected:
+            raw_persisted = (row or {}).get("project_id") if row is not None else None
+            # NULL is the legacy/unmigrated state. Empty string is a durable,
+            # explicit No-project binding and must never fall through to cwd.
+            if row is not None and raw_persisted is not None:
+                selected = str(raw_persisted or "").strip() or None
                 session["project_id"] = selected
-                return selected, _project_info_for_id(selected, session)
+                return (
+                    selected,
+                    _project_info_for_id(selected, session) if selected else None,
+                )
         except Exception:
             logger.debug("failed to read persisted session project", exc_info=True)
 
diff --git a/tui_gateway/methods_session.py b/tui_gateway/methods_session.py
--- a/tui_gateway/methods_session.py
+++ b/tui_gateway/methods_session.py
@@ -380,8 +380,10 @@ def _(rid, params: dict) -> dict:
             found = db.get_session(target) or found
 
     stored_cwd = str(found.get("cwd") or "").strip()
-    stored_project_id = str(found.get("project_id") or "").strip() or None
-    if stored_cwd and not stored_project_id:
+    stored_project_raw = found.get("project_id")
+    project_binding_known = stored_project_raw is not None
+    stored_project_id = str(stored_project_raw or "").strip() or None
+    if not project_binding_known and stored_cwd:
         migration_session = {
             "cwd": stored_cwd,
             "explicit_cwd": True,
@@ -392,8 +394,11 @@ def _(rid, params: dict) -> dict:
             "source": found.get("source") or "desktop",
         }
         stored_project_id, _ = _session_project_identity(migration_session, stored_cwd)
-        if stored_project_id:
-            found["project_id"] = stored_project_id
+    if not project_binding_known:
+        # Mark migration complete even when no registered Project owns the cwd;
+        # otherwise every resume could later reinterpret the same chat.
+        db.update_session_project(target, stored_project_id)
+        found["project_id"] = stored_project_id or ""
     profile_resume_cwd = stored_cwd or _profile_configured_cwd(
         profile_home
     )
