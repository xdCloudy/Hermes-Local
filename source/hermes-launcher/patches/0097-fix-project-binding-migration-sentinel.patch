diff --git a/apps/desktop/src/app/chat/sidebar/projects/workspace-groups.ts b/apps/desktop/src/app/chat/sidebar/projects/workspace-groups.ts
--- a/apps/desktop/src/app/chat/sidebar/projects/workspace-groups.ts
+++ b/apps/desktop/src/app/chat/sidebar/projects/workspace-groups.ts
@@ -381,10 +381,11 @@ function isPathUnder(folder: string, target: string): boolean {
  * only the repo-root AUTO-project fallback needs cwd-under-root confidence.
  */
 export function liveSessionProjectId(session: SessionInfo, explicitProjects: ProjectInfo[]): null | string {
-  const stableProjectId = session.project_id?.trim()
+  const rawProjectId = session.project_id
+  const stableProjectId = rawProjectId?.trim()
 
-  if (stableProjectId) {
-    return explicitProjects.some(project => !project.archived && project.id === stableProjectId)
+  if (rawProjectId === '' || stableProjectId) {
+    return stableProjectId && explicitProjects.some(project => !project.archived && project.id === stableProjectId)
       ? stableProjectId
       : null
   }
