Subject: [PATCH] feat(agent): sync MCP trust identities

---
 hermes_cli/mcp_config.py | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/hermes_cli/mcp_config.py b/hermes_cli/mcp_config.py
index 0f5f55ba3..44626fadc 100644
--- a/hermes_cli/mcp_config.py
+++ b/hermes_cli/mcp_config.py
@@ -26,6 +26,11 @@ from hermes_cli.config import (
 from hermes_cli.colors import Colors, color
 from hermes_constants import display_hermes_home
 from hermes_cli.mcp_security import validate_mcp_server_entry
+from hermes_cli.hermes_local_trust import (
+    mark_mcp_server_removed,
+    sync_mcp_inventory,
+    sync_mcp_server_identity,
+)
 from tools.mcp_tool import _ENV_VAR_PATTERN, _env_ref_name
 
 logger = logging.getLogger(__name__)
@@ -101,6 +106,7 @@ def _save_mcp_server(name: str, server_config: dict) -> bool:
     config = load_config()
     config.setdefault("mcp_servers", {})[name] = server_config
     save_config(config)
+    sync_mcp_server_identity(name, server_config)
     return True
 
 
@@ -114,6 +120,7 @@ def _remove_mcp_server(name: str) -> bool:
     if not servers:
         config.pop("mcp_servers", None)
     save_config(config)
+    mark_mcp_server_removed(name)
     return True
 
 
@@ -147,6 +154,7 @@ def _replace_mcp_servers(servers: Dict[str, dict]) -> Tuple[bool, List[str]]:
     else:
         config.pop("mcp_servers", None)
     save_config(config)
+    sync_mcp_inventory(servers)
     return True, []
 
 
