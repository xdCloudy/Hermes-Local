From 5555555555555555555555555555555555555555 Mon Sep 17 00:00:00 2001
From: OpenAI <openai@localhost>
Date: Wed, 5 Aug 2026 11:28:00 +0100
Subject: [PATCH] fix(desktop): align download action types

---
 .../src/app/local-workstation/task-centre.tsx | 8 ++++----
 apps/desktop/src/global.d.ts                  | 1 +
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/apps/desktop/src/app/local-workstation/task-centre.tsx b/apps/desktop/src/app/local-workstation/task-centre.tsx
--- a/apps/desktop/src/app/local-workstation/task-centre.tsx
+++ b/apps/desktop/src/app/local-workstation/task-centre.tsx
@@ -196,8 +196,8 @@ interface TaskCentreProps {
   onError: (message: string) => void
   onNavigate: (path: string) => void
   onOpenResult: (taskId: string) => Promise<void>
-  onPause: (taskId: string) => Promise<void>
-  onResume: (taskId: string) => Promise<void>
+  onPause?: (taskId: string) => Promise<void>
+  onResume?: (taskId: string) => Promise<void>
   onRetry: (taskId: string) => Promise<void>
   profileName: string
   tasks: LocalActionTask[]
@@ -405,7 +405,7 @@ export function TaskCentre({
                   <Button
                     className="h-8 gap-1.5 px-3 text-xs"
                     disabled={!selected.capabilities.pause || Boolean(pendingControl)}
-                    onClick={() => void invoke('pause', () => onPause(selected.id))}
+                    onClick={() => void invoke('pause', () => (onPause ? onPause(selected.id) : Promise.resolve()))}
                     size="sm"
                     title={selected.capabilities.pause ? 'Pause after the current safe write boundary' : 'Pause is unavailable in this stage'}
                     variant="outline"
@@ -416,7 +416,7 @@ export function TaskCentre({
                   <Button
                     className="h-8 gap-1.5 px-3 text-xs"
                     disabled={!selected.capabilities.resume || Boolean(pendingControl)}
-                    onClick={() => void invoke('resume', () => onResume(selected.id))}
+                    onClick={() => void invoke('resume', () => (onResume ? onResume(selected.id) : Promise.resolve()))}
                     size="sm"
                     title={selected.capabilities.resume ? 'Resume this task from its retained partial data' : 'Resume is unavailable'}
                     variant="outline"
diff --git a/apps/desktop/src/global.d.ts b/apps/desktop/src/global.d.ts
--- a/apps/desktop/src/global.d.ts
+++ b/apps/desktop/src/global.d.ts
@@ -164,6 +164,7 @@ declare global {
             profile?: string
             targetBranch?: string
             targetCommit?: string
+            [key: string]: unknown
           }
         ) => Promise<LocalActionTask>
         retryAction: (taskId: string) => Promise<LocalActionTask>
-- 
2.47.3

