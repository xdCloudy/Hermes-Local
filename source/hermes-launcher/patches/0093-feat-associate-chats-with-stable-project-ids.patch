+def test_stable_project_id_beats_cwd_heuristics():
+    projects = [
+        {"id": "p_one", "name": "One", "folders": [{"path": "/one"}]},
+        {"id": "p_two", "name": "Two", "folders": [{"path": "/two"}]},
+    ]
+    session = {
+        "id": "chat", "project_id": "p_two", "cwd": "/one/src",
+        "git_repo_root": "", "git_branch": "", "started_at": 1, "last_active": 2,
+    }
+    tree = pt.build_tree(projects, [session], [], resolve=lambda _cwd: None, hydrate=True)
+    one_project = next(node for node in tree["projects"] if node["id"] == "p_one")
+    two_project = next(node for node in tree["projects"] if node["id"] == "p_two")
+    assert one_project["sessionCount"] == 0
+    assert two_project["sessionCount"] == 1
+
+
+def test_stale_stable_project_id_does_not_path_fallback():
+    projects = [{"id": "p_one", "name": "One", "folders": [{"path": "/one"}]}]
+    session = {
+        "id": "chat", "project_id": "deleted-project", "cwd": "/one/src",
+        "git_repo_root": "", "git_branch": "", "started_at": 1, "last_active": 2,
+    }
+    tree = pt.build_tree(projects, [session], [], resolve=lambda _cwd: None, hydrate=True)
+    one_project = next(node for node in tree["projects"] if node["id"] == "p_one")
+    assert one_project["sessionCount"] == 0
+    assert "chat" not in tree["scoped_session_ids"]
