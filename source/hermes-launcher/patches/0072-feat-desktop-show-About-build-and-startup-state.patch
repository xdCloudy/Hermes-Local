From aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa Mon Sep 17 00:00:00 2001
From: OpenAI <openai@localhost>
Date: Fri, 7 Aug 2026 20:15:00 +0100
Subject: [PATCH] feat(desktop): show About build and startup state

---
 apps/desktop/src/app/local-workstation/about-hub.tsx | 16 +++++++++++++---
 1 file changed, 13 insertions(+), 3 deletions(-)

diff --git a/apps/desktop/src/app/local-workstation/about-hub.tsx b/apps/desktop/src/app/local-workstation/about-hub.tsx
--- a/apps/desktop/src/app/local-workstation/about-hub.tsx
+++ b/apps/desktop/src/app/local-workstation/about-hub.tsx
@@ -151,3 +151,10 @@ export function AboutHub({ onNavigate, onRun, snapshot }: Props) {
   const copy = (value: string) => void navigator.clipboard.writeText(value)
-  const openRoot = () => void window.hermesDesktop.localWorkstation.openRoot()
+  const openRelative = (relativePath: string) => void window.hermesDesktop.localWorkstation.openPath(relativePath)
   const external = (url: string) => void window.hermesDesktop.openExternal(url)
+  const expectedIntegrationTree = version?.sources?.hermesAgent?.integrationTree
+  const workingIntegrationTree = snapshot.updates.installed.integrationTree
+  const integrationDiffers = Boolean(expectedIntegrationTree && workingIntegrationTree && expectedIntegrationTree !== workingIntegrationTree)
+  let publishedBuildState = 'Unverified'
+  if (expectedIntegrationTree && workingIntegrationTree) {
+    publishedBuildState = integrationDiffers ? 'Working integration differs' : 'Matches published integration'
+  }
@@ -195,3 +202,5 @@ export function AboutHub({ onNavigate, onRun, snapshot }: Props) {
               <Value label="Patch series" value={`${snapshot.updates.installed.patchCount} patches`} />
-              <Value label="Published-build match" value={snapshot.updates.installed.integrationTree ? 'Verified integration metadata' : 'Unverified'} />
+              <Value label="Published-build match" value={publishedBuildState} />
+              <Value label="Launch at sign-in" value={snapshot.startup.available ? snapshot.startup.enabled ? 'Enabled' : 'Disabled' : 'Unavailable'} />
+              <Value label="Executable" value={snapshot.startup.executable || 'Unavailable'} />
               <Value label="Last update check" value={latest?.updatedAt || latest?.requestedAt || 'Never'} />
@@ -198,3 +207,4 @@ export function AboutHub({ onNavigate, onRun, snapshot }: Props) {
             </dl>
+            {integrationDiffers && <p className="mt-3 rounded-lg border border-amber-500/25 p-3 text-xs text-amber-500">Working integration tree differs from the build pinned in VERSION.json.</p>}
           </div>
           <div className="flex flex-wrap content-start gap-2">
@@ -202,3 +212,3 @@ export function AboutHub({ onNavigate, onRun, snapshot }: Props) {
             <Button onClick={() => copy(snapshot.updates.installed.integrationCommit || '')} size="sm" variant="outline">Copy build</Button>
-            <Button onClick={openRoot} size="sm" variant="outline"><IconFolder className="size-3.5" /> Open installation folder</Button>
+            <Button onClick={() => openRelative('.')} size="sm" variant="outline"><IconFolder className="size-3.5" /> Open installation folder</Button>
           </div>
-- 
