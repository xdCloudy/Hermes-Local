+
+  if (!document || !evidence) {
+    return null
+  }
+
+  const result = outcome(document)
+
+  return {
+    ...evidence,
+    exitCode: result.status === 'succeeded' ? 0 : 1,
+    failure: result.failure || null,
+    status: result.status
+  }
