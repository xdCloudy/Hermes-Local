+      replaceTaskRecord(task, recovered)
+      changed = true
+
+      if (isTaskTerminal(task.status)) {
+        task.events.emit('terminal', task)
+      }
+    }
+  }
+
+  if (changed) {
+    pruneCompletedTasks()
+    drainQueuedTasks()
+    persistTaskRegistrySafely()
+  }
+}
