+function runningTask(
+  requestedAction: ActionName,
+  actionIds: Map<ActionName, string> = runningActions,
+  taskMap: Map<string, ActionTask> = tasks
+): ActionTask | null {
+  const requestedId = actionIds.get(requestedAction)
+  const requested = requestedId ? taskMap.get(requestedId) : null
+
+  if (requested?.status === 'running') {
+    return requested
+  }
+
+  for (const taskId of actionIds.values()) {
+    const task = taskMap.get(taskId)
+
+    if (task?.status === 'running') {
+      return task
+    }
+  }
+
+  return null
+}
+
+function pruneCompletedTasks(taskMap: Map<string, ActionTask> = tasks, maximum = MAX_COMPLETED_TASKS): void {
+  let completed = [...taskMap.values()].filter(task => task.status !== 'running').length
+
+  if (completed <= maximum) {
+    return
+  }
+
+  for (const [taskId, task] of taskMap) {
+    if (task.status !== 'running') {
+      taskMap.delete(taskId)
+      completed -= 1
+    }
+
+    if (completed <= maximum) {
+      return
+    }
+  }
+}
