From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hermes Local Compatibility CI <hermes-local-ci@localhost>
Date: Tue, 4 Aug 2026 18:52:00 +0100
Subject: [PATCH 37/37] fix(desktop): allow update checks during startup

The Desktop "update" task invokes Update-Hermes-Local.ps1 with -Mode Check.
It is observational and must not take the exclusive workstation lock used by
repair, restart, stop, or actual update activation. Otherwise the launcher's
automatic update check races normal workstation startup and rejects itself.

Add a regression test covering the startup/check overlap reported by the
Windows launcher.

---
 .../electron/hermes-local-task-model.test.ts  | 6 ++++++
 apps/desktop/electron/hermes-local-task-model.ts | 4 +++-
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/apps/desktop/electron/hermes-local-task-model.test.ts b/apps/desktop/electron/hermes-local-task-model.test.ts
--- a/apps/desktop/electron/hermes-local-task-model.test.ts
+++ b/apps/desktop/electron/hermes-local-task-model.test.ts
@@ -75,5 +75,11 @@ describe('Hermes Local task model', () => {
     expect(admitTask('security', [update])).toMatchObject({ kind: 'start' })
   })
 
+  it('allows an automatic update check while workstation startup is in progress', () => {
+    const start = running('start')
+
+    expect(admitTask('update', [start])).toMatchObject({ kind: 'start' })
+  })
+
   it('queues automatic readiness but rejects disruptive conflicts', () => {
     const repair = running('repair')
diff --git a/apps/desktop/electron/hermes-local-task-model.ts b/apps/desktop/electron/hermes-local-task-model.ts
--- a/apps/desktop/electron/hermes-local-task-model.ts
+++ b/apps/desktop/electron/hermes-local-task-model.ts
@@ -113,7 +113,9 @@ export const TASK_POLICIES = {
     conflictPolicy: 'reject',
     resources: [sharedWorkstation, { mode: 'shared', resource: 'model-runtime' }]
   },
-  update: { cancellable: false, conflictPolicy: 'reject', resources: [exclusiveWorkstation] }
+  // This action only runs Update-Hermes-Local.ps1 -Mode Check. Update
+  // activation is coordinated separately and retains its exclusive locks.
+  update: { cancellable: false, conflictPolicy: 'reject', resources: [] }
 } as const satisfies Record<TaskAction, TaskPolicy>
 
 const TASK_TRANSITIONS: Readonly<Record<TaskState, readonly TaskState[]>> = {
