diff --git a/tui_gateway/methods_session.py b/tui_gateway/methods_session.py
index 774525e6f..17ce66f37 100644
--- a/tui_gateway/methods_session.py
+++ b/tui_gateway/methods_session.py
@@ -395,8 +395,10 @@ def _(rid, params: dict) -> dict:
             found = db.get_session(target) or found
 
     stored_cwd = str(found.get("cwd") or "").strip()
-    stored_project_id = str(found.get("project_id") or "").strip() or None
-    if stored_cwd and not stored_project_id:
+    stored_project_raw = found.get("project_id")
+    project_binding_known = stored_project_raw is not None
+    stored_project_id = str(stored_project_raw or "").strip() or None
+    if not project_binding_known and stored_cwd:
         migration_session = {
             "cwd": stored_cwd,
             "explicit_cwd": True,
@@ -405,8 +407,11 @@ def _(rid, params: dict) -> dict:
             "source": found.get("source") or "desktop",
         }
         stored_project_id, _ = _session_project_identity(migration_session, stored_cwd)
-        if stored_project_id:
-            found["project_id"] = stored_project_id
+    if not project_binding_known:
+        # Mark migration complete even when no registered Project owns the cwd;
+        # otherwise every resume could later reinterpret the same chat.
+        db.update_session_project(target, stored_project_id)
+        found["project_id"] = stored_project_id or ""
     profile_resume_cwd = stored_cwd or _profile_configured_cwd(
         profile_home
     )
