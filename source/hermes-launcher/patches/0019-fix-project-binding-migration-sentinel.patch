diff --git a/tui_gateway/server.py b/tui_gateway/server.py
index d2eb16f54..8898adcbd 100644
--- a/tui_gateway/server.py
+++ b/tui_gateway/server.py
@@ -2722,9 +2722,9 @@ def _ensure_session_db_row(session: dict) -> None:
             # means the launch/default profile (matches run_agent's convention).
             profile_name=Path(profile_home).name if profile_home else None,
         )
-        project_id = str(session.get("project_id") or "").strip()
-        if project_id:
-            db.update_session_project(key, project_id)
+        # Presence is authority: None means the user explicitly chose No project.
