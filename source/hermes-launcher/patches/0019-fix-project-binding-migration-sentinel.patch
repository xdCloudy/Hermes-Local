From 520a4312cd8de283c076040a94e50770cde954dc Mon Sep 17 00:00:00 2001
From: Hermes Local Integration <hermes-local-ci@localhost>
Date: Sat, 8 Aug 2026 18:42:00 +0100
Subject: [PATCH] fix(projects): preserve explicit projectless bindings

Use NULL as the legacy/unmigrated project binding and the empty string as the
durable explicit-projectless sentinel. This lets existing sessions keep their
cwd-based one-time migration while ensuring a chat the user detached never
silently reattaches to a project after restart.
---
 hermes_state.py                        |  6 +++---
 tests/tui_gateway/test_project_tree.py | 14 +++++++++++++-
 tests/tui_gateway/test_projects_rpc.py |  2 +-
 tui_gateway/methods_session.py         | 13 +++++++++----
 tui_gateway/project_tree.py            |  2 +-
 tui_gateway/server.py                  | 18 ++++++++++++------
 6 files changed, 39 insertions(+), 16 deletions(-)

diff --git a/hermes_state.py b/hermes_state.py
index e932eb3ec..9df4fe9dd 100644
--- a/hermes_state.py
+++ b/hermes_state.py
@@ -3611,17 +3611,17 @@ class SessionDB(SessionSearchMixin, SessionSchemaMixin, SessionPortabilityMixin)
         def _do(conn):
             conn.execute(
                 "UPDATE sessions SET cwd = NULL, git_branch = NULL, git_repo_root = NULL, "
-                "project_id = NULL WHERE id = ?",
+                "project_id = '' WHERE id = ?",
                 (session_id,),
             )
 
         self._execute_write(_do)
 
     def update_session_project(self, session_id: str, project_id: Optional[str]) -> None:
-        """Persist the stable Project owning a session, or detach it."""
+        """Persist a stable Project id, or '' for an explicit projectless binding."""
         if not session_id:
             return
-        value = str(project_id or "").strip() or None
+        value = str(project_id or "").strip()
 
         def _do(conn):
             conn.execute(
diff --git a/tests/tui_gateway/test_project_tree.py b/tests/tui_gateway/test_project_tree.py
index 1447eef21..ab87e2816 100644
--- a/tests/tui_gateway/test_project_tree.py
+++ b/tests/tui_gateway/test_project_tree.py
@@ -579,10 +579,22 @@ def test_stale_stable_project_id_does_not_path_fallback():
 def test_explicit_projectless_session_does_not_path_fallback():
     projects = [{"id": "p_one", "name": "One", "folders": [{"path": "/one"}]}]
     session = {
-        "id": "chat", "project_id": None, "cwd": "/one/src",
+        "id": "chat", "project_id": "", "cwd": "/one/src",
         "git_repo_root": "/one", "git_branch": "main", "started_at": 1, "last_active": 2,
     }
     tree = pt.build_tree(projects, [session], [], resolve=lambda _cwd: "/one", hydrate=True)
     one_project = next(node for node in tree["projects"] if node["id"] == "p_one")
     assert one_project["sessionCount"] == 0
     assert "chat" in tree["scoped_session_ids"]
+
+
+def test_legacy_null_project_id_still_migrates_by_path():
+    projects = [{"id": "p_one", "name": "One", "folders": [{"path": "/one"}]}]
+    session = {
+        "id": "legacy", "project_id": None, "cwd": "/one/src",
+        "git_repo_root": "/one", "git_branch": "main", "started_at": 1, "last_active": 2,
+    }
+    tree = pt.build_tree(projects, [session], [], resolve=lambda _cwd: "/one", hydrate=True)
+    one_project = next(node for node in tree["projects"] if node["id"] == "p_one")
+    assert one_project["sessionCount"] == 1
+    assert "legacy" in tree["scoped_session_ids"]
