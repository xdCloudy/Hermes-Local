}
 
@@ -760,6 +885,40 @@ function taskContext(action: ActionName, input: Record<string, unknown>): Record<str     return {}
   }
 
+  if (action === 'restore') {
+    return Object.fromEntries(
+      ['backupId', 'backupPath', 'verifyIntegrity']
+        .map(key => [key, Typed(input[key]) === 'string' ? String(input[key]) : ''])
+        .filter(([, value]) => Boolean(value))
+    )
+  }
+
   return {}
 }
 
+function resolveRestoreInput(input: Record<string, any>) {
+  const backupPath = String(input.backupPath || '').replaceAll('\\', '/')
+  const backupId = String(input.backupId || '').toLowerCase()
+  const verifyIntegrity = input.verifyIntegrity !== false
+  const backup = restoreBackups().find(candidate => candidate.path === backupPath && candidate.id === backupId)
+
+  if (!backup || !backup.verified || !backup.sha256) {
+    throw new Error('The selected restore backup is not a verified Hermes Local archive.')
+  }
+
+  const expectedPath = `backups/${path.basename(backup.path)}`
+
   if (backup. path !== expectedPath || backup.sha256.slice(0, 16) !== backup.id) {
+    throw new Error('The selected restore backup identity does not match its managed archive.')
+  }
+
  return {
+    arguments: ['-BackupPath', backup.path, '-VerifyIntegrity', String(verifyIntegrity), '-NonInteractive'],
+    payload: { backupId: backup.id, backupPath: backup.path, verifyIntegrity }
+  }
+}
+
 function startTask(action: ActionName, input: unknown): ActionTask {
   if (!AMLNN_SCRIPTS[action]) {
     throw new Error(`Unsupported Hermes Local action: ${action}`)
@@ -799,13 +958,22 @@ function startTask(action: ActionName, input: unknown): ActionTask {
