+def test_session_create_keeps_implicit_desktop_cwd_out_of_live_project_info(
+    monkeypatch, tmp_path
+):
+    """The gateway may execute in a neutral directory without attaching it.
+
+    A packaged desktop launched from a directory nested beneath a Git checkout
+    used to report that internal cwd (and its parent branch) as session.info,
+    exposing the installation repository in the composer and Review.
+    """
+    install_repo = tmp_path / "Hermes-Local"
+    neutral_cwd = install_repo / "data" / "user"
+    neutral_cwd.mkdir(parents=True)
+
+    monkeypatch.setattr(server, "_completion_cwd", lambda params=None: str(neutral_cwd))
+    monkeypatch.setattr(server, "_schedule_agent_build", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_schedule_session_cap_enforcement", lambda: None)
+    monkeypatch.setattr(server, "_git_branch_for_cwd", lambda cwd: "main" if cwd else "")
+    monkeypatch.setattr(
+        server,
+        "_project_info_for_cwd",
+        lambda cwd: {"id": "installation"} if cwd else None,
+    )
+
+    resp = server.handle_request(
+        {
+            "id": "projectless-create",
+            "method": "session.create",
+            "params": {"cols": 80, "source": "desktop"},
+        }
+    )
+    sid = resp["result"]["session_id"]
+
+    try:
+        assert server._sessions[sid]["cwd"] == str(neutral_cwd)
+        assert server._sessions[sid]["explicit_cwd"] is False
+        assert resp["result"]["info"]["cwd"] == ""
+        assert resp["result"]["info"]["branch"] == ""
+        assert resp["result"]["info"]["project"] is None
+    finally:
+        server._sessions.pop(sid, None)
+
+
+def test_session_create_reports_an_explicit_desktop_workspace(monkeypatch, tmp_path):
+    workspace = tmp_path / "selected-project"
+    workspace.mkdir()
+
+    monkeypatch.setattr(server, "_completion_cwd", lambda params=None: str(workspace))
+    monkeypatch.setattr(server, "_schedule_agent_build", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_schedule_session_cap_enforcement", lambda: None)
+    monkeypatch.setattr(server, "_git_branch_for_cwd", lambda cwd: "feature" if cwd else "")
+    monkeypatch.setattr(
+        server,
+        "_project_info_for_cwd",
+        lambda cwd: {"id": "selected"} if cwd else None,
+    )
+
+    resp = server.handle_request(
+        {
+            "id": "attached-create",
+            "method": "session.create",
+            "params": {
+                "cols": 80,
+                "cwd": str(workspace),
+                "source": "desktop",
+            },
+        }
+    )
+    sid = resp["result"]["session_id"]
+
+    try:
+        assert server._sessions[sid]["explicit_cwd"] is True
+        assert resp["result"]["info"]["cwd"] == str(workspace)
+        assert resp["result"]["info"]["branch"] == "feature"
+        assert resp["result"]["info"]["project"] == {"id": "selected"}
+    finally:
+        server._sessions.pop(sid, None)
+
+
+def test_live_reconnect_keeps_implicit_desktop_cwd_projectless(monkeypatch, tmp_path):
+    """The already-live resume path uses fallback info while the agent builds."""
+    neutral_cwd = tmp_path / "Hermes-Local" / "data" / "user"
+    neutral_cwd.mkdir(parents=True)
+    session = {
+        "agent": None,
+        "cwd": str(neutral_cwd),
+        "explicit_cwd": False,
+        "source": "desktop",
+    }
+
+    monkeypatch.setattr(server, "_git_branch_for_cwd", lambda cwd: "main" if cwd else "")
+    monkeypatch.setattr(
+        server,
+        "_project_info_for_cwd",
+        lambda cwd: {"id": "installation"} if cwd else None,
+    )
+
+    info = server._fallback_session_info(session)
+
+    assert info["cwd"] == ""
+    assert info["branch"] == ""
+    assert info["project"] is None
+    assert info["desktop_contract"] == server.DESKTOP_BACKEND_CONTRACT
+
+
