+      ? ` ${taskProgress.bytesCompleted}/${taskProgress.bytesTotal} bytes`
+      : ` ${taskProgress.bytesCompleted} bytes`
+  return `Model download: ${String(progress.stage || 'running')}${bytes} · ${String(progress.message || '')}`.trim()
