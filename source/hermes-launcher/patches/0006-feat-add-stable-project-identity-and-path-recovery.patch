+def _path_key(path: str) -> str:
+    """Stable comparison key for a canonical path on the current platform."""
+    return os.path.normcase(os.path.realpath(_normalize_path(path)))
+
+
+def _path_state(path: str) -> str:
+    """Return available, missing or inaccessible without mutating the path."""
+    try:
+        os.stat(path)
+        return "available"
+    except FileNotFoundError:
+        return "missing"
+    except (PermissionError, OSError):
+        return "inaccessible"
+
+
+def normalize_repository_identity(identity: Optional[str]) -> Optional[str]:
+    """Normalize an optional repository identity for duplicate/move detection.
+
+    Callers normally supply a remote URL or another stable repository token.
+    Local paths remain valid identities, but are normalized through ``_path_key``.
+    """
+    if identity is None:
+        return None
+    value = str(identity).strip()
+    if not value:
+        return None
+    if re.match(r"^[A-Za-z]:[\\/]", value) or value.startswith(("/", "~")):
+        return "path:" + _path_key(value)
+    scp = re.match(r"^(?:[^@]+@)?([^:]+):(.+)$", value)
+    if scp and "://" not in value:
+        value = f"{scp.group(1)}/{scp.group(2)}"
+    value = re.sub(r"^[a-z][a-z0-9+.-]*://", "", value, flags=re.I)
+    value = value.split("#", 1)[0].split("?", 1)[0]
+    value = re.sub(r"^[^/@]+@", "", value).strip().rstrip("/")
+    if value.lower().endswith(".git"):
+        value = value[:-4]
+    return value.lower() or None
+
+
+def _is_under(parent: str, child: str) -> bool:
+    parent_key = _path_key(parent)
+    child_key = _path_key(child)
+    return child_key == parent_key or child_key.startswith(parent_key + os.sep)
+
+
