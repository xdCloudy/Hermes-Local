+def _project_state_from_folder_states(states: Iterable[str]) -> str:
+    values = list(states)
+    if "moved" in values:
+        return "moved"
+    if "available" in values:
+        return "available"
+    if "inaccessible" in values:
+        return "inaccessible"
+    return "missing"
+
+
+def _refresh_project_state_locked(conn: sqlite3.Connection, project_id: str) -> str:
+    states = [
+        row["path_state"] or "missing"
+        for row in conn.execute(
+            "SELECT path_state FROM project_folders WHERE project_id = ?",
+            (project_id,),
+        ).fetchall()
+    ]
+    state = _project_state_from_folder_states(states)
+    conn.execute("UPDATE projects SET path_state = ? WHERE id = ?", (state, project_id))
+    return state
+
+
+def _assert_registry_identity_available(
+    conn: sqlite3.Connection,
+    project_id: str,
+    *,
+    path: Optional[str] = None,
+    repository_id: Optional[str] = None,
+) -> None:
+    if path:
+        key = _path_key(path)
+        row = conn.execute(
+            "SELECT project_id FROM project_folders WHERE path_key = ? AND project_id <> ? LIMIT 1",
+            (key, project_id),
+        ).fetchone()
+        if row is None:
+            row = conn.execute(
+                "SELECT project_id FROM project_path_aliases WHERE path_key = ? AND project_id <> ? LIMIT 1",
+                (key, project_id),
+            ).fetchone()
+        if row is not None:
+            raise ValueError(f"project path is already registered by {row['project_id']}: {path}")
+    repo = normalize_repository_identity(repository_id)
+    if repo:
+        row = conn.execute(
+            "SELECT project_id FROM project_folders "
+            "WHERE repository_id = ? AND project_id <> ? LIMIT 1",
+            (repo, project_id),
+        ).fetchone()
+        if row is None:
+            row = conn.execute(
+                "SELECT project_id FROM project_path_aliases "
+                "WHERE repository_id = ? AND project_id <> ? LIMIT 1",
+                (repo, project_id),
+            ).fetchone()
+        if row is not None:
+            raise ValueError(f"repository is already registered by {row['project_id']}: {repo}")
+
