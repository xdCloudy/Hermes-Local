+def project_for_repository(
+    conn: sqlite3.Connection, repository_id: str, *, include_archived: bool = False
+) -> Optional[Project]:
+    repo = normalize_repository_identity(repository_id)
+    if not repo:
+        return None
+    filters = "" if include_archived else " AND p.archived = 0"
+    row = conn.execute(
+        "SELECT pf.project_id AS pid FROM project_folders pf "
+        "JOIN projects p ON p.id = pf.project_id "
+        "WHERE pf.repository_id = ?" + filters + " LIMIT 1",
+        (repo,),
+    ).fetchone()
+    if row is None:
+        row = conn.execute(
+            "SELECT pa.project_id AS pid FROM project_path_aliases pa "
+            "JOIN projects p ON p.id = pa.project_id "
+            "WHERE pa.repository_id = ?" + filters + " LIMIT 1",
+            (repo,),
+        ).fetchone()
+    return get_project(conn, row["pid"]) if row else None
+
