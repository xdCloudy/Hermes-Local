+def refresh_registry(
+    conn: sqlite3.Connection, project_id: Optional[str] = None
+) -> List[Project]:
+    """Probe registered paths and persist available/missing/inaccessible state."""
+    now = _now()
+    params: tuple[object, ...] = ()
+    sql = "SELECT project_id, path FROM project_folders"
+    if project_id is not None:
+        sql += " WHERE project_id = ?"
+        params = (project_id,)
+    rows = conn.execute(sql, params).fetchall()
+    touched: set[str] = set()
+    with write_txn(conn):
+        for row in rows:
+            state = _path_state(row["path"])
+            conn.execute(
+                "UPDATE project_folders SET path_key = ?, path_state = ?, "
+                "last_checked_at = ? WHERE project_id = ? AND path = ?",
+                (_path_key(row["path"]), state, now, row["project_id"], row["path"]),
+            )
+            touched.add(row["project_id"])
+        for pid in touched:
+            _refresh_project_state_locked(conn, pid)
+    if project_id is not None:
+        project = get_project(conn, project_id)
+        return [project] if project else []
+    return list_projects(conn, include_archived=True)
+
+
+def repair_project_path(
+    conn: sqlite3.Connection,
+    project_id: str,
+    old_path: str,
+    new_path: str,
+    *,
+    repository_id: Optional[str] = None,
+) -> Project:
+    """Move one registered folder without changing the stable project id.
+
+    The old canonical path is retained as an alias so sessions, tasks and other
+    legacy references continue to resolve to the same project after relocation.
+    """
+    old_norm = _normalize_path(old_path)
+    new_norm = _normalize_path(new_path)
+    row = conn.execute(
+        "SELECT * FROM project_folders WHERE project_id = ? AND path = ?",
+        (project_id, old_norm),
+    ).fetchone()
+    if row is None:
+        raise ValueError(f"folder is not registered by {project_id}: {old_norm}")
+    repo = normalize_repository_identity(repository_id) or row["repository_id"]
+    duplicate = conn.execute(
+        "SELECT path FROM project_folders WHERE project_id = ? AND path_key = ? AND path <> ? LIMIT 1",
+        (project_id, _path_key(new_norm), old_norm),
+    ).fetchone()
+    if duplicate is not None:
+        raise ValueError(f"project path is already registered by {project_id}: {duplicate['path']}")
+    _assert_registry_identity_available(conn, project_id, path=new_norm, repository_id=repo)
+    now = _now()
+    with write_txn(conn):
+        conn.execute(
+            "INSERT INTO project_path_aliases "
+            "(project_id, path, path_key, repository_id, replaced_at) "
+            "VALUES (?, ?, ?, ?, ?) "
+            "ON CONFLICT(project_id, path_key) DO UPDATE SET "
+            "path = excluded.path, repository_id = excluded.repository_id, "
+            "replaced_at = excluded.replaced_at",
+            (project_id, old_norm, _path_key(old_norm), row["repository_id"], now),
+        )
+        conn.execute(
+            "UPDATE project_folders SET path = ?, path_key = ?, repository_id = ?, "
+            "path_state = 'moved', last_checked_at = ? "
+            "WHERE project_id = ? AND path = ?",
+            (new_norm, _path_key(new_norm), repo, now, project_id, old_norm),
+        )
+        if row["is_primary"]:
+            conn.execute(
+                "UPDATE projects SET primary_path = ?, path_state = 'moved', "
+                "last_opened_at = COALESCE(last_opened_at, ?) WHERE id = ?",
+                (new_norm, now, project_id),
+            )
+        else:
+            _refresh_project_state_locked(conn, project_id)
+    project = get_project(conn, project_id)
+    if project is None:
+        raise ValueError(f"no such project: {project_id}")
+    return project
+
+
+def migrate_legacy_references(
+    conn: sqlite3.Connection,
+    references: Iterable[str],
+    *,
+    installation_root: Optional[str] = None,
+) -> List[dict]:
+    """Resolve legacy cwd/workspace references without implicitly creating rows."""
+    results: List[dict] = []
+    install = _normalize_path(installation_root) if installation_root else None
+    for raw in references:
+        value = str(raw or "").strip()
+        if not value:
+            results.append({"path": value, "project_id": None, "status": "projectless"})
+            continue
+        path = _normalize_path(value)
+        project = project_for_path(conn, path, include_archived=True)
+        if project is not None:
+            results.append({"path": path, "project_id": project.id, "status": "resolved"})
+        elif install and _is_under(install, path):
+            results.append({"path": path, "project_id": None, "status": "installation-excluded"})
+        else:
+            results.append({"path": path, "project_id": None, "status": "projectless"})
+    return results
+
+
+def touch_project(
+    conn: sqlite3.Connection, project_id: str, *, opened: bool = False, active: bool = False
+) -> bool:
+    if not opened and not active:
+        return False
+    now = _now()
+    sets = []
+    params: List[object] = []
+    if opened or active:
+        sets.append("last_opened_at = ?")
+        params.append(now)
+    if active:
+        sets.append("last_active_at = ?")
+        params.append(now)
+    params.append(project_id)
+    with write_txn(conn):
+        cur = conn.execute(f"UPDATE projects SET {', '.join(sets)} WHERE id = ?", params)
+    return cur.rowcount > 0
+
