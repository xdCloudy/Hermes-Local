+    currentWindow?.contentView.removeChildView(view as never)
+    const contents = view.webContents
+    view = null
+    currentWindow = null
+
+    if (!contents.isDestroyed()) {
+      contents.close({ waitForBeforeUnload: false })
+    }
+  }
