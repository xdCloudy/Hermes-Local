+    const delay = RETRY_DELAYS_MS[Math.min(retryCount, RETRY_DELAYS_MS.length - 1)]
+    retryCount += 1
+    publish({ retryCount })
+    retryTimer = schedule(() => {
+      retryTimer = null
+      void ensureViewAndLoad(true)
+    }, delay)
+  }
