Subject: [PATCH] test(projects): cover Project Centre lifecycle flows

Cover folderless projects, persistent pinning, exact destructive confirmation
and argument-array Git clone registration.
---
 tests/hermes_cli/test_project_centre_flows.py | 96 +++++++++++++++++++
 1 file changed, 96 insertions(+)
 create mode 100644 tests/hermes_cli/test_project_centre_flows.py

diff --git a/tests/hermes_cli/test_project_centre_flows.py b/tests/hermes_cli/test_project_centre_flows.py
new file mode 100644
index 000000000..093e105ef
--- /dev/null
+++ b/tests/hermes_cli/test_project_centre_flows.py
@@ -0,0 +1,96 @@
+from __future__ import annotations
+
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import project_lifecycle as lifecycle
+from hermes_cli import projects_db as pdb
+
+
+def test_folderless_project_is_valid_and_persistent(tmp_path):
+    conn = pdb.connect(tmp_path / "projects.db")
+    try:
+        project_id = pdb.create_project(conn, name="Notes only", folders=[])
+        project = pdb.get_project(conn, project_id)
+        assert project is not None
+        assert project.primary_path is None
+        assert project.folders == []
+    finally:
+        conn.close()
+
+
+def test_project_pin_persists_in_registry_meta(tmp_path):
+    conn = pdb.connect(tmp_path / "projects.db")
+    try:
+        project_id = pdb.create_project(conn, name="Pinned")
+        lifecycle.set_project_pinned(conn, project_id, True)
+        assert lifecycle.list_pinned_project_ids(conn) == [project_id]
+
+        lifecycle.set_project_pinned(conn, project_id, False)
+        assert lifecycle.list_pinned_project_ids(conn) == []
+    finally:
+        conn.close()
+
+
+def test_delete_registered_files_requires_exact_confirmation(tmp_path):
+    project_dir = tmp_path / "project"
+    project_dir.mkdir()
+    marker = project_dir / "keep.txt"
+    marker.write_text("important", encoding="utf-8")
+
+    conn = pdb.connect(tmp_path / "projects.db")
+    try:
+        project_id = pdb.create_project(
+            conn,
+            name="Important project",
+            folders=[str(project_dir)],
+            primary_path=str(project_dir),
+        )
+        project = pdb.get_project(conn, project_id)
+        assert project is not None
+
+        with pytest.raises(ValueError, match="confirmation must exactly match"):
+            lifecycle.delete_registered_files(project, "DELETE")
+
+        assert marker.read_text(encoding="utf-8") == "important"
+        deleted = lifecycle.delete_registered_files(project, "DELETE Important project")
+        assert deleted == [str(project_dir)]
+        assert not project_dir.exists()
+    finally:
+        conn.close()
+
+
+def test_clone_project_uses_argument_array_and_registers_clone(monkeypatch, tmp_path):
+    parent = tmp_path / "repos"
+    parent.mkdir()
+    calls: list[tuple[list[str], str]] = []
+
+    def fake_run(argv, *, cwd, check, capture_output, text):
+        calls.append((list(argv), cwd))
+        Path(argv[-1]).mkdir()
+        return subprocess.CompletedProcess(argv, 0, "", "")
+
+    monkeypatch.setattr(lifecycle.subprocess, "run", fake_run)
+
+    conn = pdb.connect(tmp_path / "projects.db")
+    try:
+        project = lifecycle.clone_project(
+            conn,
+            repository_url="https://github.com/example/demo.git",
+            parent_path=str(parent),
+            name="Demo",
+        )
+        target = parent / "demo"
+        assert calls == [
+            (
+                ["git", "clone", "--", "https://github.com/example/demo.git", str(target)],
+                str(parent),
+            )
+        ]
+        assert project.primary_path == str(target)
+        assert project.folders[0].path == str(target)
+        assert project.folders[0].repository_id == "github.com/example/demo"
+    finally:
+        conn.close()
