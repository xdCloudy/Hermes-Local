diff --git a/tui_gateway/server.py b/tui_gateway/server.py
index e9f52d67b..d2eb16f54 100644
--- a/tui_gateway/server.py
+++ b/tui_gateway/server.py
@@ -2870,12 +2870,16 @@ def _set_session_cwd(session: dict, cwd: str) -> str:
     # A user's choice supersedes any earlier settle-adopted cwd: from here on
     # the terminal wandering must not move the workspace again.
     session["cwd_from_settle"] = False
-    session.pop("project_id", None)
+    # A raw cwd change is not a project selection. Mark the chat explicitly
+    # projectless so project identity cannot be re-inferred from the new path.
