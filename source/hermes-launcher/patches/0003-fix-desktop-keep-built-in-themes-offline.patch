From a23177398b6dc5dc34bc158a26578012b4b52d60 Mon Sep 17 00:00:00 2001
From: xdCloudy <52116030+xdCloudy@users.noreply.github.com>
Date: Tue, 28 Jul 2026 09:44:01 +0100
Subject: [PATCH 03/12] fix(desktop): keep built-in themes offline

---
 apps/desktop/src/themes/context.tsx     |  4 ++--
 apps/desktop/src/themes/presets.test.ts |  6 ++++++
 apps/desktop/src/themes/presets.ts      | 14 ++++++++------
 3 files changed, 16 insertions(+), 8 deletions(-)

diff --git a/apps/desktop/src/themes/context.tsx b/apps/desktop/src/themes/context.tsx
index e618534c3107a51331fe116ddcf6c433e8f2c464..62cdc8bcebc1725bfc98c11ad195e211a80d271a 100644
--- a/apps/desktop/src/themes/context.tsx
+++ b/apps/desktop/src/themes/context.tsx
@@ -237,14 +237,14 @@ function applyTheme(theme: DesktopTheme, mode: 'light' | 'dark') {
     foreground: c.foreground
   })
 
-  // Raw (non-JSON) keys read by the inline pre-paint script in index.html —
+  // Raw (non-JSON) keys read by the external pre-paint script in index.html —
   // they let a brand-new window paint the themed background on its very first
   // frame, before this module has even loaded.
   try {
     window.localStorage.setItem('hermes-boot-background', chromeBg)
     window.localStorage.setItem('hermes-boot-color-scheme', rendered)
   } catch {
-    // Storage may be unavailable (private mode / quota); the inline script
+    // Storage may be unavailable (private mode / quota); the pre-paint script
     // falls back to prefers-color-scheme.
   }
 
diff --git a/apps/desktop/src/themes/presets.test.ts b/apps/desktop/src/themes/presets.test.ts
index 9cb1b86efb051497eed5f89138f06ff087b29e80..56ab2c46eb87404a21da4ce90738d066103ea3be 100644
--- a/apps/desktop/src/themes/presets.test.ts
+++ b/apps/desktop/src/themes/presets.test.ts
@@ -30,4 +30,10 @@ describe('theme typography emoji fallback (#40364)', () => {
     expect(EMOJI_FALLBACK).toContain('Segoe UI Emoji')
     expect(EMOJI_FALLBACK).toContain('Noto Color Emoji')
   })
+
+  it('built-in themes do not fetch third-party font stylesheets', () => {
+    for (const theme of BUILTIN_THEME_LIST) {
+      expect(theme.typography?.fontUrl ?? '').not.toMatch(/^https?:/)
+    }
+  })
 })
diff --git a/apps/desktop/src/themes/presets.ts b/apps/desktop/src/themes/presets.ts
index 9cfb880c660feb8f82f9a5f1fda6bc697e4cae9d..c0effc11f5047584939b81ddf52a25b122afaf9f 100644
--- a/apps/desktop/src/themes/presets.ts
+++ b/apps/desktop/src/themes/presets.ts
@@ -92,8 +92,10 @@ export const nousTheme: DesktopTheme = {
   },
   typography: {
     fontSans: SYSTEM_SANS,
-    fontMono: `"Courier Prime", ${SYSTEM_MONO}`,
-    fontUrl: 'https://fonts.googleapis.com/css2?family=Courier+Prime:wght@400;700&display=swap'
+    // Keep the packaged workstation offline. Courier Prime remains the first
+    // choice when it is installed locally, with the bundled/system monospace
+    // stack providing the deterministic fallback.
+    fontMono: `"Courier Prime", ${SYSTEM_MONO}`
   }
 }
 
@@ -129,8 +131,7 @@ export const midnightTheme: DesktopTheme = {
     userBubbleBorder: '#242466'
   },
   typography: {
-    fontMono: `"JetBrains Mono", ${SYSTEM_MONO}`,
-    fontUrl: 'https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap'
+    fontMono: `"JetBrains Mono", ${SYSTEM_MONO}`
   }
 }
 
@@ -166,8 +167,9 @@ export const emberTheme: DesktopTheme = {
     userBubbleBorder: '#4a2010'
   },
   typography: {
-    fontMono: `"IBM Plex Mono", ${SYSTEM_MONO}`,
-    fontUrl: 'https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;700&display=swap'
+    // Use IBM Plex Mono when the user already has it, otherwise fall back
+    // without fetching a third-party stylesheet at runtime.
+    fontMono: `"IBM Plex Mono", ${SYSTEM_MONO}`
   }
 }
 
