From 8888888888888888888888888888888888888888 Mon Sep 17 00:00:00 2001
From: OpenAI <openai@localhost>
Date: Sat, 8 Aug 2026 02:41:00 +0100
Subject: [PATCH] feat(desktop): build Skills and MCP Trust Centre

---
 apps/desktop/src/app/local-workstation/trust-centre.tsx | 380 +++++++++++++++++
 1 file changed, 380 insertions(+)
 create mode 100644 apps/desktop/src/app/local-workstation/trust-centre.tsx

diff --git a/apps/desktop/src/app/local-workstation/trust-centre.tsx b/apps/desktop/src/app/local-workstation/trust-centre.tsx
new file mode 100644
--- /dev/null
+++ b/apps/desktop/src/app/local-workstation/trust-centre.tsx
@@ -0,0 +1,380 @@
+import { useCallback, useEffect, useMemo, useState, type ReactNode } from 'react'
+import { IconAlertTriangle, IconDownload, IconRefresh, IconShieldLock } from '@tabler/icons-react'
+
+import { Button } from '@/components/ui/button'
+import { cn } from '@/lib/utils'
+
+import type {
+  TrustCapability,
+  TrustCentreSnapshot,
+  TrustConfirmation,
+  TrustPolicyInput,
+  TrustScopeKind,
+  TrustState
+} from './trust-types'
+
+const MUTABLE_STATES: Array<Exclude<TrustState, 'built-in-verified'>> = [
+  'reviewed-managed',
+  'user-trusted',
+  'restricted',
+  'quarantined',
+  'disabled',
+  'unknown'
+]
+
+const CONFIRMATIONS: TrustConfirmation[] = [
+  'writes-or-side-effects',
+  'always',
+  'never',
+  'local-only'
+]
+
+const SCOPES: TrustScopeKind[] = ['global', 'project', 'session', 'profile', 'agent', 'user']
+
+function Panel({ children, title }: { children: ReactNode; title?: string }) {
+  return (
+    <section className="rounded-lg border border-(--ui-stroke-secondary) bg-(--ui-card-background)">
+      {title ? (
+        <header className="border-b border-(--ui-stroke-secondary) px-4 py-3 text-sm font-semibold">{title}</header>
+      ) : null}
+      <div className="p-4">{children}</div>
+    </section>
+  )
+}
+
+function shortHash(value?: string) {
+  if (!value) return 'not recorded'
+  return value.length > 20 ? `${value.slice(0, 12)}…${value.slice(-8)}` : value
+}
+
+function grantFor(snapshot: TrustCentreSnapshot, integrationId: string) {
+  return snapshot.activeGrants.find(
+    grant => grant.effect === 'allow' && grant.constraints.integrationIds?.includes(integrationId)
+  )
+}
+
+export function TrustCentre() {
+  const [snapshot, setSnapshot] = useState<TrustCentreSnapshot | null>(null)
+  const [selectedId, setSelectedId] = useState('')
+  const [capabilities, setCapabilities] = useState<TrustCapability[]>([])
+  const [state, setState] = useState<Exclude<TrustState, 'built-in-verified'>>('restricted')
+  const [confirmation, setConfirmation] = useState<TrustConfirmation>('writes-or-side-effects')
+  const [scopeKind, setScopeKind] = useState<TrustScopeKind>('global')
+  const [scopeId, setScopeId] = useState('')
+  const [busy, setBusy] = useState(false)
+  const [error, setError] = useState('')
+
+  const refresh = useCallback(async () => {
+    setError('')
+    try {
+      const next = await window.hermesDesktop.localWorkstation.trustSnapshot()
+      setSnapshot(next)
+      setSelectedId(current =>
+        current && next.integrations.some(item => item.identity.id === current)
+          ? current
+          : next.integrations[0]?.identity.id || ''
+      )
+    } catch (nextError) {
+      setError(nextError instanceof Error ? nextError.message : String(nextError))
+    }
+  }, [])
+
+  useEffect(() => {
+    void refresh()
+  }, [refresh])
+
+  const selected = useMemo(
+    () => snapshot?.integrations.find(item => item.identity.id === selectedId) || null,
+    [selectedId, snapshot]
+  )
+
+  useEffect(() => {
+    if (!snapshot || !selected) return
+    const grant = grantFor(snapshot, selected.identity.id)
+    setCapabilities(
+      snapshot.activeGrants
+        .filter(item => item.effect === 'allow' && item.constraints.integrationIds?.includes(selected.identity.id))
+        .map(item => item.capability)
+    )
+    setState(selected.identity.trustState === 'built-in-verified' ? 'restricted' : selected.identity.trustState)
+    setConfirmation(grant?.confirmation || 'writes-or-side-effects')
+    setScopeKind(grant?.scope.kind || 'global')
+    setScopeId(grant?.scope.id || '')
+  }, [selected, snapshot])
+
+  const managed = selected?.identity.integrationType.startsWith('mcp-') ?? false
+
+  const toggleCapability = (capability: TrustCapability) => {
+    setCapabilities(current =>
+      current.includes(capability)
+        ? current.filter(item => item !== capability)
+        : [...current, capability]
+    )
+  }
+
+  const applyPolicy = async (override?: Partial<TrustPolicyInput>) => {
+    if (!selected || !managed) return
+    const input: TrustPolicyInput = {
+      capabilities,
+      confirmation,
+      integrationId: selected.identity.id,
+      scope: scopeKind === 'global' ? { kind: 'global' } : { id: scopeId, kind: scopeKind },
+      state,
+      ...override
+    }
+    setBusy(true)
+    setError('')
+    try {
+      await window.hermesDesktop.localWorkstation.setTrustPolicy(input)
+      await refresh()
+    } catch (nextError) {
+      setError(nextError instanceof Error ? nextError.message : String(nextError))
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  if (!snapshot) {
+    return (
+      <Panel>
+        <div className="flex min-h-40 items-center justify-center text-sm text-(--ui-text-tertiary)">
+          {error || 'Loading Trust Centre…'}
+        </div>
+      </Panel>
+    )
+  }
+
+  return (
+    <div className="space-y-4">
+      <Panel>
+        <div className="flex flex-wrap items-start justify-between gap-4">
+          <div className="max-w-3xl">
+            <div className="mb-2 flex items-center gap-2">
+              <IconShieldLock className="size-5 text-(--ui-accent)" />
+              <h2 className="text-lg font-semibold">Skills and MCP Trust Centre</h2>
+            </div>
+            <p className="text-sm leading-6 text-(--ui-text-secondary)">
+              Review source identity, declared capabilities and scoped grants before Hermes starts or invokes
+              managed integrations. Native policy remains authoritative and unknown capability is denied.
+            </p>
+          </div>
+          <div className="flex gap-2">
+            <Button disabled={busy} onClick={() => void refresh()} size="sm" variant="outline">
+              <IconRefresh className="mr-1.5 size-3.5" />
+              Refresh
+            </Button>
+            <Button
+              disabled={busy}
+              onClick={() => void window.hermesDesktop.localWorkstation.exportTrustDiagnostics()}
+              size="sm"
+              variant="outline"
+            >
+              <IconDownload className="mr-1.5 size-3.5" />
+              Export diagnostics
+            </Button>
+          </div>
+        </div>
+        {error ? (
+          <div className="mt-3 rounded-md border border-red-500/30 bg-red-500/10 px-3 py-2 text-xs text-red-700 dark:text-red-300">
+            {error}
+          </div>
+        ) : null}
+        <div className="mt-4 grid gap-2 sm:grid-cols-4">
+          <div className="rounded-md border border-(--ui-stroke-secondary) p-3">
+            <div className="text-lg font-semibold">{snapshot.integrations.length}</div>
+            <div className="text-xs text-(--ui-text-tertiary)">Integrations</div>
+          </div>
+          <div className="rounded-md border border-(--ui-stroke-secondary) p-3">
+            <div className="text-lg font-semibold">{snapshot.activeGrants.length}</div>
+            <div className="text-xs text-(--ui-text-tertiary)">Active grants</div>
+          </div>
+          <div className="rounded-md border border-(--ui-stroke-secondary) p-3">
+            <div className="text-lg font-semibold">{snapshot.alerts.length}</div>
+            <div className="text-xs text-(--ui-text-tertiary)">Alerts</div>
+          </div>
+          <div className="rounded-md border border-(--ui-stroke-secondary) p-3">
+            <div className="text-lg font-semibold">{snapshot.auditSummary.recent.length}</div>
+            <div className="text-xs text-(--ui-text-tertiary)">Recent audit events</div>
+          </div>
+        </div>
+      </Panel>
+
+      <div className="grid gap-4 xl:grid-cols-[20rem_minmax(0,1fr)]">
+        <Panel title="Managed inventory">
+          <div className="max-h-[44rem] space-y-1 overflow-auto">
+            {snapshot.integrations.map(record => (
+              <button
+                className={cn(
+                  'w-full rounded-md border px-3 py-2 text-left',
+                  selectedId === record.identity.id
+                    ? 'border-(--ui-accent)/40 bg-(--ui-accent)/10'
+                    : 'border-transparent hover:bg-(--ui-control-hover-background)'
+                )}
+                key={record.identity.id}
+                onClick={() => setSelectedId(record.identity.id)}
+                type="button"
+              >
+                <div className="truncate text-xs font-semibold">{record.identity.displayName}</div>
+                <div className="mt-1 text-[0.6875rem] text-(--ui-text-tertiary)">
+                  {record.identity.integrationType} · {record.identity.trustState}
+                </div>
+              </button>
+            ))}
+          </div>
+        </Panel>
+
+        {selected ? (
+          <div className="space-y-4">
+            <Panel title={selected.identity.displayName}>
+              <dl className="grid gap-3 text-xs sm:grid-cols-2">
+                <div>
+                  <dt className="text-(--ui-text-tertiary)">Source</dt>
+                  <dd className="mt-1 break-all font-mono">
+                    {selected.identity.provenance.uri || selected.identity.provenance.provenanceId}
+                  </dd>
+                </div>
+                <div>
+                  <dt className="text-(--ui-text-tertiary)">Revision</dt>
+                  <dd className="mt-1 break-all font-mono">{selected.identity.provenance.revision}</dd>
+                </div>
+                <div>
+                  <dt className="text-(--ui-text-tertiary)">Manifest SHA-256</dt>
+                  <dd className="mt-1 font-mono">{shortHash(selected.identity.provenance.sha256)}</dd>
+                </div>
+                <div>
+                  <dt className="text-(--ui-text-tertiary)">Approved SHA-256</dt>
+                  <dd className="mt-1 font-mono">{shortHash(selected.identity.approvedManifestSha256)}</dd>
+                </div>
+                <div>
+                  <dt className="text-(--ui-text-tertiary)">Trust state</dt>
+                  <dd className="mt-1">{selected.identity.trustState}</dd>
+                </div>
+                <div>
+                  <dt className="text-(--ui-text-tertiary)">Health</dt>
+                  <dd className="mt-1">{selected.identity.healthState}</dd>
+                </div>
+              </dl>
+            </Panel>
+
+            <Panel title="Declared capabilities">
+              {selected.identity.declaredCapabilities.length ? (
+                <div className="grid gap-2 sm:grid-cols-2">
+                  {selected.identity.declaredCapabilities.map(capability => (
+                    <label
+                      className="flex items-center gap-2 rounded-md border border-(--ui-stroke-secondary) px-3 py-2 text-xs"
+                      key={capability}
+                    >
+                      <input
+                        checked={capabilities.includes(capability)}
+                        disabled={!managed || selected.identity.trustState === 'built-in-verified'}
+                        onChange={() => toggleCapability(capability)}
+                        type="checkbox"
+                      />
+                      <span className="font-mono">{capability}</span>
+                    </label>
+                  ))}
+                </div>
+              ) : (
+                <p className="text-xs text-(--ui-text-tertiary)">No capabilities are declared for this item.</p>
+              )}
+              {selected.unknownCapabilities?.length ? (
+                <div className="mt-3 flex items-start gap-2 rounded-md border border-amber-500/30 bg-amber-500/10 p-3 text-xs">
+                  <IconAlertTriangle className="mt-0.5 size-4 shrink-0" />
+                  Unknown capability declarations are denied: {selected.unknownCapabilities.join(', ')}
+                </div>
+              ) : null}
+            </Panel>
+
+            {managed ? (
+              <Panel title="Permission policy">
+                <div className="grid gap-3 md:grid-cols-3">
+                  <label className="text-xs">
+                    <span className="mb-1 block text-(--ui-text-tertiary)">Trust state</span>
+                    <select
+                      className="w-full rounded-md border border-(--ui-stroke-secondary) bg-(--ui-control-background) px-2 py-2"
+                      onChange={event => setState(event.target.value as Exclude<TrustState, 'built-in-verified'>)}
+                      value={state}
+                    >
+                      {MUTABLE_STATES.map(item => (
+                        <option key={item} value={item}>{item}</option>
+                      ))}
+                    </select>
+                  </label>
+                  <label className="text-xs">
+                    <span className="mb-1 block text-(--ui-text-tertiary)">Confirmation</span>
+                    <select
+                      className="w-full rounded-md border border-(--ui-stroke-secondary) bg-(--ui-control-background) px-2 py-2"
+                      onChange={event => setConfirmation(event.target.value as TrustConfirmation)}
+                      value={confirmation}
+                    >
+                      {CONFIRMATIONS.map(item => (
+                        <option key={item} value={item}>{item}</option>
+                      ))}
+                    </select>
+                  </label>
+                  <label className="text-xs">
+                    <span className="mb-1 block text-(--ui-text-tertiary)">Scope</span>
+                    <select
+                      className="w-full rounded-md border border-(--ui-stroke-secondary) bg-(--ui-control-background) px-2 py-2"
+                      onChange={event => setScopeKind(event.target.value as TrustScopeKind)}
+                      value={scopeKind}
+                    >
+                      {SCOPES.map(item => (
+                        <option key={item} value={item}>{item}</option>
+                      ))}
+                    </select>
+                  </label>
+                </div>
+                {scopeKind !== 'global' ? (
+                  <label className="mt-3 block text-xs">
+                    <span className="mb-1 block text-(--ui-text-tertiary)">Scope id</span>
+                    <input
+                      className="w-full rounded-md border border-(--ui-stroke-secondary) bg-(--ui-control-background) px-2 py-2"
+                      onChange={event => setScopeId(event.target.value)}
+                      value={scopeId}
+                    />
+                  </label>
+                ) : null}
+                <div className="mt-4 flex gap-2">
+                  <Button disabled={busy} onClick={() => void applyPolicy()} size="sm">
+                    Save policy
+                  </Button>
+                  <Button
+                    disabled={busy}
+                    onClick={() => void applyPolicy({ capabilities: [], confirmation: 'never', state: 'disabled' })}
+                    size="sm"
+                    variant="outline"
+                  >
+                    Disable now
+                  </Button>
+                </div>
+              </Panel>
+            ) : null}
+          </div>
+        ) : null}
+      </div>
+
+      <div className="grid gap-4 lg:grid-cols-2">
+        <Panel title="Alerts">
+          <div className="space-y-2 text-xs">
+            {snapshot.alerts.length ? snapshot.alerts.map((alert, index) => (
+              <div className="rounded-md border border-(--ui-stroke-secondary) p-2" key={`${alert.integrationId}-${index}`}>
+                <span className="font-medium">{alert.severity}</span> · {alert.integrationId || 'global'} · {alert.reason}
+              </div>
+            )) : <p className="text-(--ui-text-tertiary)">No current trust alerts.</p>}
+          </div>
+        </Panel>
+        <Panel title="Recent audit activity">
+          <div className="max-h-64 space-y-2 overflow-auto text-xs">
+            {snapshot.auditSummary.recent.length ? snapshot.auditSummary.recent.map(event => (
+              <div className="rounded-md border border-(--ui-stroke-secondary) p-2" key={event.id}>
+                <div className="font-medium">{event.eventType}</div>
+                <div className="text-(--ui-text-tertiary)">{event.timestamp} · {event.outcome}</div>
+              </div>
+            )) : <p className="text-(--ui-text-tertiary)">No trust audit events recorded yet.</p>}
+          </div>
+        </Panel>
+      </div>
+    </div>
+  )
+}
-- 
