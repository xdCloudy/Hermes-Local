diff --git a/apps/desktop/src/app/local-workstation/about-hub.tsx b/apps/desktop/src/app/local-workstation/about-hub.tsx
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/apps/desktop/src/app/local-workstation/about-hub.tsx
@@ -0,0 +1,574 @@
+import {
+  IconActivityHeartbeat,
+  IconAlertTriangle,
+  IconCheck,
+  IconDatabase,
+  IconFileAnalytics,
+  IconFolder,
+  IconRefresh,
+  IconShieldCheck
+} from '@tabler/icons-react'
+import { type ReactNode, useMemo, useState } from 'react'
+
+import { Button } from '@/components/ui/button'
+import { ExternalLink } from '@/lib/external-link'
+import { cn } from '@/lib/utils'
+
+import type { LocalAction, LocalWorkstationSnapshot } from './types'
+
+interface AboutHubProps {
+  onNavigate: (path: string) => void
+  onRun: (action: LocalAction, input?: Record<string, unknown>) => void
+  snapshot: LocalWorkstationSnapshot
+}
+
+interface VersionManifest {
+  product?: {
+    channel?: string
+    name?: string
+    status?: string
+    version?: string
+  }
+  recordedAt?: string
+  runtime?: {
+    accelerationDefault?: string
+    cudaToolkit?: string
+    node?: string
+    python?: string
+    sqlite?: string
+  }
+  sources?: {
+    hermesAgent?: {
+      branch?: string
+      commit?: string
+      integrationBranch?: string
+      integrationCommit?: string
+      integrationTree?: string
+      patchSeries?: string
+      repository?: string
+    }
+    llamaCpp?: {
+      branch?: string
+      commit?: string
+      repository?: string
+    }
+  }
+  starterModel?: {
+    filename?: string
+    license?: string
+    repository?: string
+    revision?: string
+  }
+}
+
+interface ModelRecord {
+  alias?: string
+  displayName?: string
+  filename?: string
+  id?: string
+  localPath?: string
+  metadata?: {
+    quantization?: string
+  }
+  resolvedPath?: string
+  revision?: string
+}
+
+interface SettingsRecord {
+  network?: {
+    hermesPort?: number
+    host?: string
+    modelPort?: number
+  }
+  runtime?: {
+    acceleration?: string
+  }
+  selectedProfile?: string
+}
+
+const PROJECT_URL = 'https://github.com/xdCloudy/Hermes-Local'
+const AGENT_URL = 'https://github.com/NousResearch/hermes-agent'
+const LLAMA_URL = 'https://github.com/ggml-org/llama.cpp'
+
+const IMPORTANT_PATHS = [
+  ['Installation root', '.'],
+  ['User data', 'data'],
+  ['Models', 'models'],
+  ['Logs', 'logs'],
+  ['Reports', 'reports'],
+  ['Backups', 'backups'],
+  ['Configuration', 'config'],
+  ['Integration source', 'source\\hermes-agent']
+] as const
+
+function joinRoot(root: string, relative: string): string {
+  if (relative === '.') {
+    return root
+  }
+
+  return `${root.replace(/[\\/]+$/, '')}\\${relative}`
+}
+
+function short(value: null | string | undefined): string {
+  return value ? value.slice(0, 12) : 'Unavailable'
+}
+
+function parseRuntimeVersions() {
+  const userAgent = typeof navigator === 'undefined' ? '' : navigator.userAgent
+
+  return {
+    chromium: userAgent.match(/Chrome\/([0-9.]+)/)?.[1] || 'Unavailable',
+    electron: userAgent.match(/Electron\/([0-9.]+)/)?.[1] || 'Unavailable'
+  }
+}
+
+export function detectInstallationType(executable: string): 'Installed' | 'Portable' {
+  return /portable/i.test(executable) ? 'Portable' : 'Installed'
+}
+
+export function buildSupportSummary(snapshot: LocalWorkstationSnapshot, includeExactPaths = false): string {
+  const version = snapshot.version as unknown as VersionManifest | null
+  const model = snapshot.model as unknown as ModelRecord | null
+  const settings = snapshot.settings as SettingsRecord
+  const root = includeExactPaths ? snapshot.root : '<INSTALLATION_ROOT>'
+  const health = [
+    `model=${snapshot.health.model ? 'healthy' : 'offline'}`,
+    `agent=${snapshot.health.hermes ? 'healthy' : 'offline'}`,
+    `dashboard=${snapshot.health.dashboard ? 'healthy' : 'offline'}`
+  ].join(', ')
+
+  return [
+    '# Hermes Local support summary',
+    '',
+    `Product: ${version?.product?.name || 'Hermes Launcher'} ${version?.product?.version || 'Unavailable'}`,
+    `Release channel: ${version?.product?.channel || 'Not declared'}`,
+    `Release status: ${version?.product?.status || 'Unavailable'}`,
+    `Build recorded: ${version?.recordedAt || 'Unavailable'}`,
+    `Hermes Agent base: ${short(snapshot.updates.installed.baseCommit || version?.sources?.hermesAgent?.commit)}`,
+    `Hermes Agent integration: ${short(snapshot.updates.installed.integrationCommit || version?.sources?.hermesAgent?.integrationCommit)}`,
+    `Integration tree: ${short(snapshot.updates.installed.integrationTree || version?.sources?.hermesAgent?.integrationTree)}`,
+    `Patch series: ${snapshot.updates.installed.patchCount} patches`,
+    `llama.cpp: ${short(version?.sources?.llamaCpp?.commit)}`,
+    `Selected model: ${model?.displayName || model?.alias || model?.id || model?.filename || 'Unavailable'}`,
+    `Selected profile: ${settings?.selectedProfile || snapshot.profiles?.selected || 'Unavailable'}`,
+    `Acceleration: ${settings?.runtime?.acceleration || version?.runtime?.accelerationDefault || 'Unavailable'}`,
+    `Health: ${health}`,
+    `CPU: ${snapshot.hardware.cpu} (${snapshot.hardware.logicalProcessors} logical processors)`,
+    `RAM: ${Math.round(snapshot.hardware.memoryTotalBytes / 1024 ** 3)} GiB`,
+    `GPU: ${snapshot.gpu ? `${snapshot.gpu.name} (${Math.round(snapshot.gpu.memoryTotalMiB / 1024)} GiB VRAM)` : 'Unavailable'}`,
+    `Installation root: ${root}`,
+    `Data path: ${includeExactPaths ? joinRoot(snapshot.root, 'data') : '<INSTALLATION_ROOT>\\data'}`,
+    `Logs path: ${includeExactPaths ? joinRoot(snapshot.root, 'logs') : '<INSTALLATION_ROOT>\\logs'}`,
+    '',
+    'Privacy: generated locally. Tokens, passwords, cookies, conversation contents, private files, hostname, username and environment values are not included.'
+  ].join('\n')
+}
+
+function Card({
+  children,
+  className,
+  title
+}: {
+  children: ReactNode
+  className?: string
+  title: string
+}) {
+  return (
+    <section className={cn('overflow-hidden rounded-xl border border-(--ui-stroke-secondary)', className)}>
+      <header className="border-b border-(--ui-stroke-secondary) px-4 py-3">
+        <h3 className="text-xs font-semibold uppercase tracking-[0.08em] text-(--ui-text-tertiary)">{title}</h3>
+      </header>
+      {children}
+    </section>
+  )
+}
+
+function Value({ label, value }: { label: string; value: ReactNode }) {
+  return (
+    <div className="min-w-0 rounded-lg border border-(--ui-stroke-secondary) px-3 py-2.5">
+      <dt className="text-[0.6875rem] font-medium text-(--ui-text-tertiary)">{label}</dt>
+      <dd className="mt-1 min-w-0 break-words font-mono text-xs font-semibold">{value}</dd>
+    </div>
+  )
+}
+
+function HealthRow({ label, ok, detail }: { label: string; ok: boolean; detail: string }) {
+  return (
+    <div className="flex items-start gap-3 border-b border-(--ui-stroke-secondary) px-4 py-3 last:border-0">
+      <div className={cn('mt-0.5 grid size-6 shrink-0 place-items-center rounded-full', ok ? 'bg-emerald-500/10 text-emerald-500' : 'bg-red-500/10 text-red-500')}>
+        {ok ? <IconCheck className="size-3.5" /> : <IconAlertTriangle className="size-3.5" />}
+      </div>
+      <div className="min-w-0">
+        <p className="text-xs font-semibold">{label}</p>
+        <p className="mt-0.5 text-[0.6875rem] leading-5 text-(--ui-text-tertiary)">{detail}</p>
+      </div>
+    </div>
+  )
+}
+
+export function AboutHub({ onNavigate, onRun, snapshot }: AboutHubProps) {
+  const version = snapshot.version as unknown as VersionManifest | null
+  const model = snapshot.model as unknown as ModelRecord | null
+  const settings = snapshot.settings as SettingsRecord
+  const runtimeVersions = useMemo(parseRuntimeVersions, [])
+  const [includeExactPaths, setIncludeExactPaths] = useState(false)
+  const [previewDiagnostics, setPreviewDiagnostics] = useState(false)
+  const [copyState, setCopyState] = useState<'idle' | 'copied'>('idle')
+  const latestUpdate = snapshot.updates.latest
+  const installationType = detectInstallationType(snapshot.startup.executable)
+  const supportSummary = useMemo(
+    () => buildSupportSummary(snapshot, includeExactPaths),
+    [includeExactPaths, snapshot]
+  )
+
+  const copy = async (value: string) => {
+    await navigator.clipboard.writeText(value)
+    setCopyState('copied')
+    window.setTimeout(() => setCopyState('idle'), 1500)
+  }
+
+  const openRelative = (relative: string) => {
+    const bridge = window.hermesDesktop.localWorkstation as unknown as {
+      openPath?: (relativePath: string) => Promise<unknown>
+    }
+
+    if (bridge.openPath) {
+      void bridge.openPath(relative)
+    } else {
+      void window.hermesDesktop.localWorkstation.openRoot()
+    }
+  }
+
+  const healthChecks = [
+    {
+      detail: version ? `Manifest loaded for ${version.product?.version || 'unknown version'}.` : 'VERSION.json could not be loaded.',
+      label: 'Launcher files and version metadata',
+      ok: Boolean(version?.product?.version)
+    },
+    {
+      detail: snapshot.updates.installed.integrationTree
+        ? `${snapshot.updates.installed.patchCount} integration patches pinned to ${short(snapshot.updates.installed.integrationTree)}.`
+        : 'No pinned integration tree is available.',
+      label: 'Integration revision',
+      ok: Boolean(snapshot.updates.installed.integrationTree && snapshot.updates.installed.patchCount)
+    },
+    {
+      detail: snapshot.actions.start && snapshot.actions.stop
+        ? 'Managed start and stop entrypoints are installed.'
+        : 'One or more managed runtime entrypoints are missing.',
+      label: 'Runtime entrypoints',
+      ok: Boolean(snapshot.actions.start && snapshot.actions.stop)
+    },
+    {
+      detail: model
+        ? `${model.displayName || model.alias || model.id || model.filename || 'Selected model'} is registered.`
+        : 'No selected model metadata is available.',
+      label: 'Selected model metadata',
+      ok: Boolean(model)
+    },
+    {
+      detail: settings ? 'Portable workstation configuration was loaded.' : 'Workstation settings were not exposed in this snapshot.',
+      label: 'Configuration',
+      ok: Boolean(settings)
+    },
+    {
+      detail: `State database ${snapshot.storage.stateDatabaseBytes ? 'is readable' : 'is empty or not present'}; ${snapshot.storage.memoryFiles} memory files indexed.`,
+      label: 'Data/runtime state',
+      ok: snapshot.storage.stateDatabaseBytes >= 0 && snapshot.storage.memoryFiles >= 0
+    },
+    {
+      detail: latestUpdate
+        ? `${latestUpdate.mode} operation ${latestUpdate.status}; last observed ${latestUpdate.updatedAt || latestUpdate.requestedAt}.`
+        : 'No update operation has been recorded yet.',
+      label: 'Update metadata',
+      ok: !latestUpdate || Boolean(latestUpdate.status)
+    }
+  ]
+
+  const componentRows = [
+    ['Launcher', version?.product?.version || 'Unavailable', version?.product?.version || 'Unavailable', 'Product release channel'],
+    [
+      'Hermes Agent',
+      short(snapshot.updates.installed.integrationCommit || version?.sources?.hermesAgent?.integrationCommit),
+      snapshot.health.hermes ? short(snapshot.updates.installed.integrationCommit || version?.sources?.hermesAgent?.integrationCommit) : 'Not running',
+      latestUpdate?.target?.candidate ? short(latestUpdate.target.candidate) : 'Not checked'
+    ],
+    [
+      'llama.cpp',
+      short(version?.sources?.llamaCpp?.commit),
+      snapshot.health.model ? short(version?.sources?.llamaCpp?.commit) : 'Not running',
+      'Pinned by build'
+    ],
+    [
+      'Model',
+      model?.displayName || model?.alias || model?.filename || 'Unavailable',
+      snapshot.health.model ? model?.alias || model?.id || 'Running' : 'Not running',
+      model?.revision ? short(model.revision) : version?.starterModel?.revision ? short(version.starterModel.revision) : 'Unavailable'
+    ],
+    ['Python', version?.runtime?.python || 'Unavailable', version?.runtime?.python || 'Unavailable', 'Pinned by build'],
+    ['Node.js', version?.runtime?.node || 'Unavailable', version?.runtime?.node || 'Unavailable', 'Pinned by build'],
+    ['CUDA toolkit', version?.runtime?.cudaToolkit || 'Unavailable', version?.runtime?.cudaToolkit || 'Unavailable', 'Pinned by build'],
+    ['Electron', runtimeVersions.electron, runtimeVersions.electron, 'Bundled'],
+    ['Chromium', runtimeVersions.chromium, runtimeVersions.chromium, 'Bundled']
+  ]
+
+  return (
+    <div className="grid min-w-0 gap-4">
+      <Card title="Product identity">
+        <div className="grid gap-5 p-5 lg:grid-cols-[1fr_auto] lg:items-start">
+          <div className="min-w-0">
+            <div className="flex items-center gap-2">
+              <IconActivityHeartbeat className="size-5 text-(--ui-accent)" />
+              <h3 className="text-base font-semibold">{version?.product?.name || 'Hermes Launcher'}</h3>
+            </div>
+            <p className="mt-2 max-w-3xl text-sm leading-6 text-(--ui-text-secondary)">
+              Product, build and diagnostics metadata from the running Hermes Local installation. This page is informational;
+              live service controls remain on Home/Services and long-running work remains in Task Centre.
+            </p>
+            {!version && (
+              <p className="mt-3 rounded-lg border border-amber-500/25 bg-amber-500/8 px-3 py-2 text-xs text-amber-500">
+                Build metadata is unavailable. Diagnostics and local paths remain usable.
+              </p>
+            )}
+            <dl className="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
+              <Value label="Version" value={version?.product?.version || 'Unavailable'} />
+              <Value label="Release channel" value={version?.product?.channel || 'Not declared'} />
+              <Value label="Build recorded" value={version?.recordedAt || 'Unavailable'} />
+              <Value label="Installation type" value={installationType} />
+              <Value label="Release status" value={version?.product?.status || 'Unavailable'} />
+              <Value label="Integration commit" value={short(snapshot.updates.installed.integrationCommit)} />
+              <Value label="Integration tree" value={short(snapshot.updates.installed.integrationTree)} />
+              <Value label="Patch series" value={`${snapshot.updates.installed.patchCount} patches`} />
+            </dl>
+          </div>
+          <Button className="gap-2" onClick={() => openRelative('.')} variant="outline">
+            <IconFolder className="size-4" />
+            Open installation folder
+          </Button>
+        </div>
+      </Card>
+
+      <Card title="Components">
+        <div className="overflow-x-auto">
+          <table className="w-full min-w-[42rem] text-left text-xs">
+            <thead className="border-b border-(--ui-stroke-secondary) text-[0.6875rem] uppercase tracking-[0.06em] text-(--ui-text-tertiary)">
+              <tr>
+                <th className="px-4 py-2.5 font-semibold">Component</th>
+                <th className="px-4 py-2.5 font-semibold">Installed</th>
+                <th className="px-4 py-2.5 font-semibold">Running</th>
+                <th className="px-4 py-2.5 font-semibold">Available / source</th>
+              </tr>
+            </thead>
+            <tbody>
+              {componentRows.map(([component, installed, running, available]) => (
+                <tr className="border-b border-(--ui-stroke-secondary) last:border-0" key={component}>
+                  <th className="px-4 py-3 font-semibold">{component}</th>
+                  <td className="px-4 py-3 font-mono">{installed}</td>
+                  <td className="px-4 py-3 font-mono">{running}</td>
+                  <td className="px-4 py-3 font-mono">{available}</td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+      </Card>
+
+      <div className="grid gap-4 xl:grid-cols-2">
+        <Card title="System">
+          <dl className="grid gap-3 p-4 sm:grid-cols-2">
+            <Value label="OS" value={typeof navigator !== 'undefined' && /Windows/i.test(navigator.userAgent) ? 'Windows' : 'Unavailable'} />
+            <Value label="CPU" value={snapshot.hardware.cpu} />
+            <Value label="Logical processors" value={snapshot.hardware.logicalProcessors} />
+            <Value label="RAM" value={`${(snapshot.hardware.memoryTotalBytes / 1024 ** 3).toFixed(1)} GiB`} />
+            <Value label="GPU" value={snapshot.gpu?.name || 'Unavailable'} />
+            <Value label="VRAM" value={snapshot.gpu ? `${(snapshot.gpu.memoryTotalMiB / 1024).toFixed(1)} GiB` : 'Unavailable'} />
+            <Value label="Selected profile" value={settings?.selectedProfile || snapshot.profiles?.selected || 'Unavailable'} />
+            <Value label="Acceleration" value={settings?.runtime?.acceleration || version?.runtime?.accelerationDefault || 'Unavailable'} />
+            <Value label="Model endpoint" value={settings?.network ? `${settings.network.host}:${settings.network.modelPort}` : 'Unavailable'} />
+            <Value label="Agent/dashboard endpoint" value={settings?.network ? `${settings.network.host}:${settings.network.hermesPort}` : 'Unavailable'} />
+          </dl>
+        </Card>
+
+        <Card title="Installation health">
+          <div>
+            {healthChecks.map(check => (
+              <HealthRow detail={check.detail} key={check.label} label={check.label} ok={check.ok} />
+            ))}
+          </div>
+        </Card>
+      </div>
+
+      <Card title="Paths">
+        <div className="divide-y divide-(--ui-stroke-secondary)">
+          {IMPORTANT_PATHS.map(([label, relative]) => {
+            const fullPath = joinRoot(snapshot.root, relative)
+            return (
+              <div className="flex min-w-0 flex-wrap items-center gap-3 px-4 py-3" key={label}>
+                <div className="min-w-0 flex-1">
+                  <p className="text-xs font-semibold">{label}</p>
+                  <p className="mt-1 break-all font-mono text-[0.6875rem] text-(--ui-text-tertiary)">{fullPath}</p>
+                </div>
+                <Button onClick={() => void copy(fullPath)} size="sm" variant="outline">Copy</Button>
+                <Button onClick={() => openRelative(relative)} size="sm" variant="outline">Reveal</Button>
+              </div>
+            )
+          })}
+        </div>
+      </Card>
+
+      <Card title="Diagnostics & support">
