+def test_session_cwd_set_empty_detaches_profile_session(monkeypatch, tmp_path):
+    profile_home = tmp_path / "profiles" / "worker"
+    profile_home.mkdir(parents=True)
+    workspace = tmp_path / "workspace"
+    workspace.mkdir()
+    captured = {}
+
+    class ProfileDB:
+        def clear_session_cwd(self, session_id):
+            captured["cleared"] = session_id
+
+        def close(self):
+            captured["closed"] = True
+
+    session = {
+        "agent": None,
+        "cwd": str(workspace),
+        "explicit_cwd": True,
+        "profile_home": str(profile_home),
+        "running": False,
+        "session_key": "stored-profile-session",
+        "source": "desktop",
+    }
+    server._sessions["runtime-session"] = session
+    monkeypatch.setattr("hermes_state.SessionDB", lambda db_path=None: ProfileDB())
+    monkeypatch.setattr(server, "_register_session_cwd", lambda _session: None)
+    monkeypatch.setattr(server, "_emit", lambda *args, **kwargs: None)
+
+    import tools.terminal_tool as terminal_tool
+
+    monkeypatch.setattr(terminal_tool, "cleanup_vm", lambda key: captured.setdefault("cleanup", key))
+
+    try:
+        resp = server.handle_request(
+            {
+                "id": "1",
+                "method": "session.cwd.set",
+                "params": {"session_id": "runtime-session", "cwd": ""},
+            }
+        )
+
+        assert "error" not in resp
+        assert resp["result"]["cwd"] == ""
+        assert resp["result"]["branch"] == ""
+        assert resp["result"]["project"] is None
+        assert resp["result"]["desktop_contract"] == 7
+        assert session["explicit_cwd"] is False
+        assert session["cwd"] == str(Path.home())
+        assert captured["cleared"] == "stored-profile-session"
+        assert captured["cleanup"] == "stored-profile-session"
+        assert captured["closed"] is True
+    finally:
+        server._sessions.pop("runtime-session", None)
+
+
