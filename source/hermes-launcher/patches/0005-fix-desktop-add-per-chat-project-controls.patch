+    def test_clear_session_cwd_removes_workspace_and_git_metadata(self, db):
+        db.create_session(session_id="s1", source="desktop")
+        db.update_session_cwd(
+            "s1",
+            "/work/repo",
+            git_branch="main",
+            git_repo_root="/work/repo",
+        )
+
+        db.clear_session_cwd("s1")
+
+        session = db.get_session("s1")
+        assert session["cwd"] is None
+        assert session["git_branch"] is None
+        assert session["git_repo_root"] is None
