     return resolved
 
 
+def _clear_session_cwd(session: dict) -> None:
+    """Detach a desktop chat from its workspace while keeping tools runnable."""
+    neutral = os.path.abspath(os.path.expanduser("~"))
+    if not os.path.isdir(neutral):
+        neutral = os.getcwd()
+
+    session["cwd"] = neutral
+    session["explicit_cwd"] = False
+    _register_session_cwd(session)
+    with _session_db(session) as db:
+        if db is not None:
+            try:
+                db.clear_session_cwd(session.get("session_key", ""))
+            except Exception:
+                logger.debug("failed to clear session cwd", exc_info=True)
+    try:
+        from tools.terminal_tool import cleanup_vm
+
+        cleanup_vm(session["session_key"])
+    except Exception:
+        pass
+
+
