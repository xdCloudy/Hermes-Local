+export interface CloneProjectInput {
+  name: string
+  repositoryUrl: string
+  parentPath: string
+  directoryName?: string
+  use?: boolean
+}
+
+export async function cloneProject(input: CloneProjectInput): Promise<ProjectInfo | null> {
+  const res = await gatewayRequest<{ project: ProjectInfo | null }>('projects.clone', {
+    name: input.name,
+    repository_url: input.repositoryUrl,
+    parent_path: input.parentPath,
+    directory_name: input.directoryName,
+    use: input.use ?? true
+  })
+  const created = res.project
+
+  if (created) {
+    $projects.set([...$projects.get().filter(project => project.id !== created.id), created])
+    if (!$projectTree.get().some(node => node.id === created.id)) {
+      $projectTree.set([projectInfoToTreeNode(created), ...$projectTree.get()])
+    }
+    if (input.use ?? true) {
+      $activeProjectId.set(created.id)
+    }
+  }
+
+  reconcileProjects()
+  return created
+}
