 export async function renameProject(id: string, name: string): Promise<void> {
@@ -990,4 +990,44 @@
   return repaired
 }
 
+interface ProjectCentrePayload extends ProjectsPayload {
+  pinned_ids?: string[]
+  deleted_paths?: string[]
+}
+
+function applyProjectCentrePayload(payload: ProjectCentrePayload): void {
+  applyPayload(payload)
+  $pinnedProjectIds.set(new Set(payload.pinned_ids ?? []))
+}
+
+export async function refreshProjectCentre(): Promise<void> {
+  applyProjectCentrePayload(await gatewayRequest<ProjectCentrePayload>('projects.centre'))
+}
+
+export async function setProjectPinned(id: string, pinned: boolean): Promise<void> {
+  applyProjectCentrePayload(await gatewayRequest<ProjectCentrePayload>('projects.pin', { id, pinned }))
+}
+
+export async function setProjectArchived(id: string, archived: boolean): Promise<void> {
+  applyPayload(
+    await gatewayRequest<ProjectsPayload>('projects.archive', {
+      id,
+      restore: !archived
+    })
+  )
+  void refreshProjectTree()
+}
+
+export async function removeProjectRegistration(id: string): Promise<void> {
+  applyProjectCentrePayload(await gatewayRequest<ProjectCentrePayload>('projects.remove', { id }))
+  void refreshProjectTree()
+}
+
+export async function deleteProjectFiles(id: string, confirmation: string): Promise<string[]> {
+  const payload = await gatewayRequest<ProjectCentrePayload>('projects.delete_files', { id, confirmation })
+  applyProjectCentrePayload(payload)
+  void refreshProjectTree()
+  return payload.deleted_paths ?? []
+}
