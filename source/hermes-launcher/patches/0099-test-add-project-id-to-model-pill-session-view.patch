Subject: [PATCH] test(desktop): add project id to model pill session view

Keep the ModelPill tile fixture aligned with the SessionView contract now that
project identity is a first-class per-surface runtime field.
---
 apps/desktop/src/app/chat/composer/model-pill.test.tsx | 1 +
 1 file changed, 1 insertion(+)

diff --git a/apps/desktop/src/app/chat/composer/model-pill.test.tsx b/apps/desktop/src/app/chat/composer/model-pill.test.tsx
--- a/apps/desktop/src/app/chat/composer/model-pill.test.tsx
+++ b/apps/desktop/src/app/chat/composer/model-pill.test.tsx
@@ -91,9 +91,10 @@ describe('ModelPill per-surface model label', () => {
       $lastVisibleIsUser: atom(false),
       $messages: atom([]),
       $messagesEmpty: atom(true),
       $model: atom('tile/claude-sonnet'),
+      $projectId: atom(null),
       $provider: atom('anthropic'),
       $reasoningEffort: atom('high'),
       $runtimeId: atom('tile-runtime'),
       $storedId: atom('stored-tile')
     }
