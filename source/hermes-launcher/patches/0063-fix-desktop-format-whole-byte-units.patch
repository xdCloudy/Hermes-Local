Date: Wed, 5 Aug 2026 12:19:00 +0100
Subject: [PATCH] fix(desktop): format whole byte units without decimals

---
 apps/desktop/src/app/local-workstation/model-download-card.tsx | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/apps/desktop/src/app/local-workstation/model-download-card.tsx b/apps/desktop/src/app/local-workstation/model-download-card.tsx
--- a/apps/desktop/src/app/local-workstation/model-download-card.tsx
+++ b/apps/desktop/src/app/local-workstation/model-download-card.tsx
@@ -38,3 +38,4 @@ function bytes(value: null | number | undefined): string {
   }
-  return `${amount >= 10 || unit === 0 ? amount.toFixed(0) : amount.toFixed(1)} ${units[unit]}`
+  const precision = amount >= 10 || unit === 0 || Number.isInteger(amount) ? 0 : 1
+  return `${amount.toFixed(precision)} ${units[unit]}`
 }
