From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hermes Local Integration <hermes-local-ci@localhost>
Date: Mon, 10 Aug 2026 21:14:00 +0100
Subject: [PATCH] feat(desktop): wire Project Centre creation and menus

Add empty, attach and clone creation paths and expose non-destructive Project
Centre lifecycle actions from the existing project controls.

diff --git a/apps/desktop/src/app/chat/sidebar/project-dialog.tsx b/apps/desktop/src/app/chat/sidebar/project-dialog.tsx
--- a/apps/desktop/src/app/chat/sidebar/project-dialog.tsx
+++ b/apps/desktop/src/app/chat/sidebar/project-dialog.tsx
@@ -24,9 +24,13 @@
 import {
   $projectDialog,
   addProjectFolder,
+  cloneProject,
   closeProjectDialog,
   createProject,
   generateProjectIdea,
+  openProjectCentre,
   pickProjectFolder,
   renameProject
 } from '@/store/projects'
+
+import { ProjectCentreDialog } from './project-centre-dialog'
@@ -50,4 +50,7 @@
   const [name, setName] = useState('')
   const [folders, setFolders] = useState<string[]>([])
   const [idea, setIdea] = useState('')
+  const [createFlow, setCreateFlow] = useState<'attach' | 'clone' | 'empty'>('empty')
+  const [repositoryUrl, setRepositoryUrl] = useState('')
+  const [cloneParent, setCloneParent] = useState('')
   const [templates, setTemplates] = useState<ProjectIdeaTemplate[]>([])
@@ -62,4 +62,7 @@
       setName(state?.name ?? '')
       setFolders([])
       setIdea('')
+      setCreateFlow('empty')
+      setRepositoryUrl('')
+      setCloneParent('')
       setTemplates(randomIdeaTemplates())
@@ -100,9 +100,14 @@
+      if (mode === 'create' && createFlow === 'clone') {
+        setCloneParent(dir)
+        return
+      }
+
       const projectId = state?.projectId
 
       if (mode === 'add-folder' && projectId) {
         await runSubmit(() => addProjectFolder(projectId, dir))
 
         return
       }
 
-      setFolders(prev => (prev.includes(dir) ? prev : [...prev, dir]))
+      setFolders(prev => (createFlow === 'attach' ? [dir] : prev.includes(dir) ? prev : [...prev, dir]))
@@ -132,5 +132,30 @@
-    // A project owns sessions by folder (cwd-prefix), so creation requires at
-    // least one — a folder-less project couldn't hold a session anyway.
-    if (mode === 'create' && trimmed && folders.length) {
-      await runSubmit(() => createProject({ folders, idea: idea.trim() || undefined, name: trimmed, use: true }))
+    if (mode !== 'create' || !trimmed) {
+      return
     }
+
+    if (createFlow === 'clone') {
+      if (repositoryUrl.trim() && cloneParent) {
+        await runSubmit(() =>
+          cloneProject({
+            name: trimmed,
+            parentPath: cloneParent,
+            repositoryUrl: repositoryUrl.trim(),
+            use: true
+          })
+        )
+      }
+      return
+    }
+
+    if (createFlow === 'attach') {
+      if (folders.length) {
+        await runSubmit(() =>
+          createProject({ folders, idea: idea.trim() || undefined, name: trimmed, primaryPath: folders[0], use: true })
+        )
+      }
+      return
+    }
+
+    // Empty non-Git projects are valid registry entries. They can gain a folder
+    // later through Add folder / missing-path repair without changing identity.
+    await runSubmit(() => createProject({ folders: [], idea: idea.trim() || undefined, name: trimmed, use: true }))
@@ -168,2 +168,3 @@
   return (
-    <Dialog onOpenChange={onOpenChange} open={open}>
+    <>
+      <Dialog onOpenChange={onOpenChange} open={open}>
@@ -178,3 +178,26 @@
         </DialogHeader>
 
+        {mode === 'create' && (
+          <div className="flex flex-wrap items-center gap-1">
+            {([
+              ['empty', 'Empty project'],
+              ['attach', 'Attach folder'],
+              ['clone', 'Clone repository']
+            ] as const).map(([id, label]) => (
+              <Button
+                key={id}
+                onClick={() => setCreateFlow(id)}
+                size="sm"
+                type="button"
+                variant={createFlow === id ? 'default' : 'ghost'}
+              >
+                {label}
+              </Button>
+            ))}
+            <Button className="ml-auto" onClick={openProjectCentre} size="sm" type="button" variant="ghost">
+              Project Centre
+            </Button>
+          </div>
+        )}
+
         {mode !== 'add-folder' && (
@@ -220,3 +220,3 @@
-        {mode === 'create' && (
+        {mode === 'create' && createFlow === 'attach' && (
           <div className="flex flex-col gap-1.5">
             <span className="text-[0.6875rem] font-medium text-(--ui-text-tertiary)">{p.foldersLabel}</span>
@@ -270,5 +270,27 @@
         )}
 
-        {mode === 'create' && (
+        {mode === 'create' && createFlow === 'clone' && (
+          <div className="space-y-2">
+            <Input
+              disabled={submitting}
+              onChange={event => setRepositoryUrl(event.target.value)}
+              placeholder="Repository URL (HTTPS or SSH)"
+              value={repositoryUrl}
+            />
+            <div className="flex min-w-0 items-center gap-2">
+              <Input
+                className="min-w-0 flex-1"
+                disabled
+                placeholder="Clone destination parent folder"
+                value={cloneParent}
+              />
+              <Button disabled={submitting} onClick={() => void pickFolder()} type="button" variant="ghost">
+                Choose…
+              </Button>
+            </div>
+          </div>
+        )}
+
+        {mode === 'create' && createFlow !== 'clone' && (
           <div className="flex flex-col gap-1.5">
             <span className="text-[0.6875rem] font-medium text-(--ui-text-tertiary)">{p.ideaLabel}</span>
@@ -340,7 +340,13 @@
             <Button
-              disabled={submitting || !name.trim() || (mode === 'create' && folders.length === 0)}
+              disabled={
+                submitting ||
+                !name.trim() ||
+                (mode === 'create' &&
+                  ((createFlow === 'attach' && folders.length === 0) ||
+                    (createFlow === 'clone' && (!repositoryUrl.trim() || !cloneParent))))
+              }
               onClick={() => void submit()}
               type="button"
             >
-              {mode === 'rename' ? t.common.save : p.create}
+              {mode === 'rename' ? t.common.save : createFlow === 'clone' ? 'Clone & create' : p.create}
             </Button>
@@ -360,4 +360,6 @@
       </DialogContent>
-    </Dialog>
+      </Dialog>
+      <ProjectCentreDialog />
+    </>
   )
 }
diff --git a/apps/desktop/src/app/chat/sidebar/projects/project-menu.tsx b/apps/desktop/src/app/chat/sidebar/projects/project-menu.tsx
--- a/apps/desktop/src/app/chat/sidebar/projects/project-menu.tsx
+++ b/apps/desktop/src/app/chat/sidebar/projects/project-menu.tsx
@@ -24,9 +24,13 @@
 import {
+  $pinnedProjectIds,
   copyPath,
-  deleteProject,
   openProjectAddFolder,
+  openProjectCentre,
   openProjectRename,
+  removeProjectRegistration,
   revealPath,
   setActiveProject,
-  setProjectAppearance
+  setProjectAppearance,
+  setProjectArchived,
+  setProjectPinned
 } from '@/store/projects'
@@ -55,3 +55,5 @@
   const { t } = useI18n()
   const p = t.sidebar.projects
+  const pinnedProjectIds = useStore($pinnedProjectIds)
+  const pinned = pinnedProjectIds.has(project.id)
   const target = { id: project.id, name: project.label }
@@ -72,7 +72,7 @@
   const confirmDelete = async () => {
-    await deleteProject(project.id)
+    await removeProjectRegistration(project.id)
 
     if (scoped) {
       onExitScope?.()
     }
   }
@@ -85,18 +85,42 @@
   const identityItems: ActionItemSpec[] = project.isAuto
     ? []
     : [
         { icon: 'edit', key: 'rename', label: p.menuRename, onSelect: () => openProjectRename(target) },
+        {
+          icon: 'pin',
+          key: 'pin',
+          label: pinned ? 'Unpin project' : 'Pin project',
+          onSelect: () => void setProjectPinned(project.id, !pinned)
+        },
         {
           icon: 'new-folder',
           key: 'add-folder',
           label: p.menuAddFolder,
           onSelect: () => openProjectAddFolder(target)
         },
         {
           disabled: isActive,
           icon: 'target',
           key: 'set-active',
           label: p.menuSetActive,
           onSelect: () => void setActiveProject(project.id)
+        },
+        {
+          icon: 'archive',
+          key: 'archive',
+          label: 'Archive project',
+          onSelect: () => {
+            void setProjectArchived(project.id, true).then(() => {
+              if (scoped) {
+                onExitScope?.()
+              }
+            })
+          }
+        },
+        {
+          icon: 'folder',
+          key: 'project-centre',
+          label: 'Open Project Centre',
+          onSelect: openProjectCentre
         }
       ]
@@ -130,19 +130,19 @@
     : {
-        icon: 'trash',
-        key: 'delete',
-        label: `${p.menuDelete}…`,
+        icon: 'remove-close',
+        key: 'remove-registration',
+        label: 'Remove project…',
         onSelect: () => setConfirmDeleteOpen(true),
         variant: 'destructive'
       }
 
   const confirmDialog = (
     <ConfirmDialog
-      confirmLabel={p.menuDelete}
-      description={p.deleteConfirm}
+      confirmLabel="Remove registration"
+      description="This removes the Project Centre registration only. Files and Git repositories remain on disk."
       destructive
       onClose={() => setConfirmDeleteOpen(false)}
       onConfirm={confirmDelete}
       open={confirmDeleteOpen}
-      title={`${p.menuDelete} "${project.label}"?`}
+      title={`Remove "${project.label}" from Project Centre?`}
     />
   )
