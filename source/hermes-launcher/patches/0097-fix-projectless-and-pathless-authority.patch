Subject: [PATCH] fix(projects): enforce projectless and pathless authority

---
 apps/desktop/src/app/chat/composer/index.tsx                |  2 +-
 apps/desktop/src/app/chat/composer/status-stack/project-row.tsx |  9 ++++----
 tests/tui_gateway/test_project_tree.py                      | 13 +++++++++++
 tests/tui_gateway/test_projects_rpc.py                      | 28 +++++++++++++++++++++++
 tui_gateway/project_tree.py                                 | 14 +++++++-----
 tui_gateway/server.py                                       | 10 +++++----
 6 files changed, 62 insertions(+), 14 deletions(-)

diff --git a/apps/desktop/src/app/chat/composer/index.tsx b/apps/desktop/src/app/chat/composer/index.tsx
--- a/apps/desktop/src/app/chat/composer/index.tsx
+++ b/apps/desktop/src/app/chat/composer/index.tsx
@@ -1222,3 +1222,3 @@ export function ChatBar({
                 />
-                {selectedProjectId && (
+                {selectedProjectId && cwd?.trim() && (
                 <CodingStatusRow

diff --git a/apps/desktop/src/app/chat/composer/status-stack/project-row.tsx b/apps/desktop/src/app/chat/composer/status-stack/project-row.tsx
--- a/apps/desktop/src/app/chat/composer/status-stack/project-row.tsx
+++ b/apps/desktop/src/app/chat/composer/status-stack/project-row.tsx
@@ -31,8 +31,8 @@ export function selectedProjectIdForCwd(
   cwd: null | string | undefined,
   preferredId: null | string | undefined
 ): null | string {
-  const preferred = preferredId?.trim()
-  if (preferred) {
-    return projects.some(project => !project.archived && project.id === preferred) ? preferred : null
+  if (preferredId !== undefined) {
+    const preferred = preferredId?.trim() || null
+    return preferred && projects.some(project => !project.archived && project.id === preferred) ? preferred : null
   }
 
@@ -80,5 +80,4 @@ export const ProjectStatusRow = memo(function ProjectStatusRow({
           key: project.id,
           label: <span className="truncate">{project.name}</span>,
-          disabled: !cwd,
           onSelect: () => void onSelectProject(project.id, cwd)
         })
diff --git a/tui_gateway/project_tree.py b/tui_gateway/project_tree.py
--- a/tui_gateway/project_tree.py
+++ b/tui_gateway/project_tree.py
@@ -582,15 +582,17 @@ def build_tree(
     unowned: list[dict] = []
     identity_orphans: list[dict] = []
     for session in sessions:
+        has_project_identity = "project_id" in session
         selected_project_id = str(session.get("project_id") or "").strip()
         owner = (
             project_by_id.get(selected_project_id)
-            if selected_project_id
-            else _project_for_session(session, folder_index, resolve)
+            if has_project_identity and selected_project_id
+            else None
+            if has_project_identity
+            else _project_for_session(session, folder_index, resolve)
         )
         if owner:
             by_project.setdefault(owner["id"], []).append(session)
-        elif selected_project_id:
+        elif has_project_identity:
             identity_orphans.append(session)
         else:
             unowned.append(session)
@@ -634,3 +636,3 @@ def build_tree(
-    # Explicit-but-missing project ids never fall back to cwd/repo heuristics.
-    # Keep those rows visible under Home until the user reattaches them.
+    # Explicit projectless or missing project identities never fall back to cwd/repo heuristics.
+    # Keep those rows visible under Home until the user attaches or reattaches them.
     homeless: list[dict] = list(identity_orphans)
diff --git a/tui_gateway/server.py b/tui_gateway/server.py
--- a/tui_gateway/server.py
+++ b/tui_gateway/server.py
@@ -2933,9 +2933,11 @@ def _set_session_project(
 
     project_cwd = str(project.get("primary_path") or "").strip()
-    if not project_cwd:
-        raise ValueError(f"project has no usable primary folder: {selected}")
-
-    resolved = _set_session_cwd(session, project_cwd)
+    if project_cwd:
+        resolved = _set_session_cwd(session, project_cwd)
+    else:
+        # Pathless/non-Git projects are valid identities with no file/Git scope.
+        _clear_session_cwd(session)
+        resolved = ""
     session["project_id"] = selected
     with _session_db(session) as db:
diff --git a/tests/tui_gateway/test_project_tree.py b/tests/tui_gateway/test_project_tree.py
--- a/tests/tui_gateway/test_project_tree.py
+++ b/tests/tui_gateway/test_project_tree.py
@@ -570,2 +570,15 @@ def test_stale_stable_project_id_does_not_path_fallback():
     assert one_project["sessionCount"] == 0
     assert "chat" in tree["scoped_session_ids"]
+
+
+def test_explicit_projectless_session_does_not_path_fallback():
+    projects = [{"id": "p_one", "name": "One", "folders": [{"path": "/one"}]}]
+    session = {
+        "id": "chat", "project_id": None, "cwd": "/one/src",
+        "git_repo_root": "/one", "git_branch": "main", "started_at": 1, "last_active": 2,
+    }
+    tree = pt.build_tree(projects, [session], [], resolve=lambda _cwd: "/one", hydrate=True)
+    one_project = next(node for node in tree["projects"] if node["id"] == "p_one")
+    assert one_project["sessionCount"] == 0
+    assert "chat" in tree["scoped_session_ids"]
diff --git a/tests/tui_gateway/test_projects_rpc.py b/tests/tui_gateway/test_projects_rpc.py
--- a/tests/tui_gateway/test_projects_rpc.py
+++ b/tests/tui_gateway/test_projects_rpc.py
@@ -548,2 +548,30 @@ def test_desktop_session_project_switch_persists_stable_identity(monkeypatch, tmp_path):
     finally:
         server._sessions.pop(sid, None)
+
+
+def test_desktop_session_can_attach_pathless_project(monkeypatch):
+    project = _call("projects.create", {"name": "Notes only"})["project"]
+
+    monkeypatch.setattr(server, "_schedule_agent_build", lambda *_args, **_kwargs: None)
+    monkeypatch.setattr(server, "_schedule_session_cap_enforcement", lambda: None)
+
+    created = _call(
+        "session.create",
+        {"source": "desktop", "project_id": project["id"]},
+    )
+    sid = created["session_id"]
+
+    try:
+        assert created["info"]["project_id"] == project["id"]
+        assert created["info"]["project"]["id"] == project["id"]
+        assert created["info"]["cwd"] == ""
+        assert created["info"]["branch"] == ""
+
+        detached = _call(
+            "session.cwd.set",
+            {"session_id": sid, "cwd": "", "project_id": None},
+        )
+        assert detached["project_id"] is None
+        assert detached["project"] is None
+    finally:
+        server._sessions.pop(sid, None)
