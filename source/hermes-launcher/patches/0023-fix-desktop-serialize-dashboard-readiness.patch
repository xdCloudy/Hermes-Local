From 2222222222222222222222222222222222222222 Mon Sep 17 00:00:00 2001
From: OpenAI <noreply@openai.com>
Date: Fri, 31 Jul 2026 03:08:00 +0000
Subject: [PATCH] fix(desktop): serialize dashboard readiness

Use the completed successful main-frame request as an authoritative readiness
signal and coalesce concurrent Desktop show/reload calls onto one navigation.
This prevents repeated loadURL races from leaving a fully loaded hidden
WebContentsView behind the renderer's loading state.
---
 .../electron/hermes-local-dashboard-view.ts | 30 +++++++++++++++++----
 1 file changed, 25 insertions(+), 5 deletions(-)

diff --git a/apps/desktop/electron/hermes-local-dashboard-view.ts b/apps/desktop/electron/hermes-local-dashboard-view.ts
--- a/apps/desktop/electron/hermes-local-dashboard-view.ts
+++ b/apps/desktop/electron/hermes-local-dashboard-view.ts
@@ -154,6 +154,7 @@ export function createHermesLocalDashboardViewController(
   let desiredVisible = false
   let lastMainFrameStatus: null | number = null
   let mainFrameDomReady = false
+  let loadPromise: Promise<void> | null = null
 
   const publish = (next: Partial<HermesLocalDashboardState>): HermesLocalDashboardState => {
     state = { ...state, ...next }
@@ -207,6 +208,7 @@ export function createHermesLocalDashboardViewController(
 
   const destroyView = () => {
     clearRetry()
+    loadPromise = null
 
     if (!view) {
       return
@@ -300,6 +302,11 @@ export function createHermesLocalDashboardViewController(
 
     if (details.resourceType === 'mainFrame') {
       lastMainFrameStatus = details.statusCode
+
+      if (details.statusCode >= 200 && details.statusCode < 400) {
+        mainFrameDomReady = true
+        markReadyIfUsable(true)
+      }
     }
 
     if (details.statusCode === 401 || details.statusCode === 403) {
@@ -426,5 +434,12 @@ export function createHermesLocalDashboardViewController(
       state.phase === 'restarting'
     ) {
+      if (loadPromise) {
+        await loadPromise
+        attachToCurrentWindow()
+
+        return { ...state }
+      }
+
       setViewVisibility(false)
       publish({
         canRetry: true,
@@ -435,10 +449,16 @@ export function createHermesLocalDashboardViewController(
       })
 
-      try {
-        await view.webContents.loadURL(currentConfig.url)
-      } catch {
-        // did-fail-load owns the recoverable state and retry schedule.
-      }
+      const loadingView = view
+      loadPromise = loadingView.webContents
+        .loadURL(currentConfig.url)
+        .then(() => undefined)
+        .catch(() => undefined)
+        .finally(() => {
+          if (view === loadingView) {
+            loadPromise = null
+          }
+        })
+      await loadPromise
     } else {
       attachToCurrentWindow()
     }
-- 
