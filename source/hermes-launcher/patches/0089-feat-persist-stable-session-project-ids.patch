+def _projects_db_path_for_session(session: dict | None) -> Path | None:
+    profile_home = str((session or {}).get("profile_home") or "").strip()
+    return Path(profile_home) / "projects.db" if profile_home else None
+
+
+def _project_from_id(project_id: str, session: dict | None = None):
+    selected = str(project_id or "").strip()
+    if not selected:
+        return None
+    from hermes_cli import projects_db as pdb
+
+    with pdb.connect_closing(_projects_db_path_for_session(session)) as conn:
+        project = pdb.get_project(conn, selected)
+    if project is None or getattr(project, "archived", False):
+        return None
+    return project
+
+
+def _project_payload(project) -> dict | None:
+    if project is None:
+        return None
+    return {
+        "id": project.id,
+        "slug": project.slug,
+        "name": project.name,
+        "primary_path": project.primary_path,
+    }
+
+
+def _project_info_for_id(
+    project_id: str | None, session: dict | None = None
+) -> dict | None:
+    return _project_payload(_project_from_id(str(project_id or ""), session))
+
+
+def _set_session_project(
+    session: dict, project_id: str | None
+) -> tuple[str, dict | None]:
+    """Attach a session to a stable Project id and select an available folder."""
+    selected = str(project_id or "").strip()
+    if not selected:
+        _clear_session_cwd(session)
+        return "", None
+
+    project = _project_from_id(selected, session)
+    if project is None:
+        raise ValueError(f"project does not exist or is archived: {selected}")
+
+    candidates: list[str] = []
+    if getattr(project, "primary_path", None):
+        candidates.append(str(project.primary_path))
+    candidates.extend(
+        str(folder.path)
+        for folder in (getattr(project, "folders", None) or [])
+        if str(getattr(folder, "path", "") or "").strip()
+    )
+
+    resolved = ""
+    for candidate in dict.fromkeys(candidates):
+        try:
+            resolved = _set_session_cwd(session, candidate)
+            break
+        except ValueError:
+            continue
+    if not resolved:
+        raise ValueError(f"project has no available workspace folder: {selected}")
+
+    session["project_id"] = project.id
+    with _session_db(session) as db:
+        if db is not None:
+            db.update_session_project(session.get("session_key", ""), project.id)
+    return resolved, _project_payload(project)
+
+
