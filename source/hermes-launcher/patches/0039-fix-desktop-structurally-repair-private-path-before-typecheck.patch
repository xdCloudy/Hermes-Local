From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hermes Local Integration <hermes-local-ci@localhost>
Date: Tue, 4 Aug 2026 20:02:00 +0100
Subject: [PATCH 39/39] fix(desktop): rewrite private-path redaction with generated literals

The composed launcher overlay can emit an odd backslash sequence that TypeScript
parses as an unterminated string. Avoid manual escape counting entirely.

Add a build-local repair script that locates the complete private-path redaction
line, regenerates its string literals through JSON.stringify, writes the line
back unconditionally, and asks the installed TypeScript parser to validate the
entire file before the launcher build continues.

---
 .../scripts/repair-hermes-local-control.mjs   | 69 +++++++++++++++++++
 1 file changed, 69 insertions(+)
 create mode 100644 apps/desktop/scripts/repair-hermes-local-control.mjs

diff --git a/apps/desktop/scripts/repair-hermes-local-control.mjs b/apps/desktop/scripts/repair-hermes-local-control.mjs
new file mode 100644
index 0000000..e76a93d
--- /dev/null
+++ b/apps/desktop/scripts/repair-hermes-local-control.mjs
@@ -0,0 +1,69 @@
+import { readFile, writeFile } from 'node:fs/promises'
+import { fileURLToPath } from 'node:url'
+import ts from 'typescript'
+
+const controlUrl = new URL('../electron/hermes-local-control.ts', import.meta.url)
+const controlPath = fileURLToPath(controlUrl)
+const source = await readFile(controlPath, 'utf8')
+const newline = source.includes('\r\n') ? '\r\n' : '\n'
+const lines = source.split(/\r?\n/)
+const candidates = []
+
+for (let index = 0; index < lines.length; index += 1) {
+  const line = lines[index]
+  if (
+    line.includes('safe = safe.replaceAll(privatePath') &&
+    line.includes('privatePath.replaceAll(')
+  ) {
+    candidates.push(index)
+  }
+}
+
+if (candidates.length !== 1) {
+  throw new Error(
+    `Expected exactly one private-path redaction line in ${controlPath}; found ${candidates.length}.`,
+  )
+}
+
+const lineIndex = candidates[0]
+const indentation = lines[lineIndex].match(/^\s*/)?.[0] ?? ''
+const privateMarker = JSON.stringify('[PRIVATE-PATH]')
+const backslashLiteral = JSON.stringify('\\')
+const slashLiteral = JSON.stringify('/')
+const canonical =
+  `${indentation}safe = safe.replaceAll(privatePath, ${privateMarker}).replaceAll(` +
+  `privatePath.replaceAll(${backslashLiteral}, ${slashLiteral}), ${privateMarker})`
+
+lines[lineIndex] = canonical
+const updated = lines.join(newline)
+await writeFile(controlPath, updated, 'utf8')
+
+const parsed = ts.createSourceFile(
+  controlPath,
+  updated,
+  ts.ScriptTarget.Latest,
+  true,
+  ts.ScriptKind.TS,
+)
+
+if (parsed.parseDiagnostics.length > 0) {
+  const details = parsed.parseDiagnostics.slice(0, 5).map((diagnostic) => {
+    const start = diagnostic.start ?? 0
+    const position = parsed.getLineAndCharacterOfPosition(start)
+    const message = ts.flattenDiagnosticMessageText(diagnostic.messageText, ' ')
+    const line = lines[position.line] ?? ''
+    return `${position.line + 1}:${position.character + 1} ${message}; line=${JSON.stringify(line)}`
+  })
+  throw new Error(
+    `Desktop control source still has TypeScript parse errors after repair:\n${details.join('\n')}`,
+  )
+}
+
+const verified = await readFile(controlPath, 'utf8')
+if ((verified.split(/\r?\n/)[lineIndex] ?? '') !== canonical) {
+  throw new Error(`Private-path redaction rewrite did not persist in ${controlPath}.`)
+}
+
+process.stdout.write(
+  `Rewrote and parsed private-path redaction before Desktop typecheck: ${controlPath}\n`,
+)
-- 
