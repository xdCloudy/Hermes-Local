From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hermes Local Integration <hermes-local-ci@localhost>
Date: Tue, 4 Aug 2026 19:50:00 +0100
Subject: [PATCH 39/39] fix(desktop): structurally repair private-path redaction before typecheck

The composed launcher overlay can emit a malformed TypeScript string literal
whose exact slash sequence is unsafe to match from PowerShell. Add a temporary
npm pretypecheck hook that identifies the complete redaction statement by its
stable structure and replaces it with a canonical escaped form.

The launcher build already snapshots and restores this source file, so the
repair remains build-local.

---
 apps/desktop/package.json                              |  1 +
 .../scripts/repair-hermes-local-control.mjs           | 43 ++++++++++++++++++
 2 files changed, 44 insertions(+)
 create mode 100644 apps/desktop/scripts/repair-hermes-local-control.mjs

diff --git a/apps/desktop/package.json b/apps/desktop/package.json
--- a/apps/desktop/package.json
+++ b/apps/desktop/package.json
@@ -42,6 +42,7 @@
     "test:desktop:nsis": "node scripts/test-desktop.mjs nsis",
     "test:desktop:existing": "node scripts/test-desktop.mjs existing",
     "test:desktop:fresh": "node scripts/test-desktop.mjs fresh",
+    "pretypecheck": "node scripts/repair-hermes-local-control.mjs",
     "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
     "lint": "eslint src/ electron/",
     "lint:fix": "eslint src/ electron/ --fix",
diff --git a/apps/desktop/scripts/repair-hermes-local-control.mjs b/apps/desktop/scripts/repair-hermes-local-control.mjs
new file mode 100644
--- /dev/null
+++ b/apps/desktop/scripts/repair-hermes-local-control.mjs
@@ -0,0 +1,43 @@
+import { readFile, writeFile } from 'node:fs/promises'
+import { fileURLToPath } from 'node:url'
+
+const controlUrl = new URL('../electron/hermes-local-control.ts', import.meta.url)
+const controlPath = fileURLToPath(controlUrl)
+const source = await readFile(controlPath, 'utf8')
+const statementPattern =
+  /^([ \t]*)safe\s*=\s*safe\.replaceAll\(privatePath,\s*'\[PRIVATE-PATH\]'\)\.replaceAll\(privatePath\.replaceAll\([^\r\n]*$/gm
+const matches = [...source.matchAll(statementPattern)]
+
+if (matches.length !== 1) {
+  throw new Error(
+    `Expected exactly one private-path redaction statement in ${controlPath}; found ${matches.length}.`,
+  )
+}
+
+const match = matches[0]
+const canonical =
+  `${match[1]}safe = safe.replaceAll(privatePath, '[PRIVATE-PATH]').replaceAll(` +
+  `privatePath.replaceAll('\\\\', '/'), '[PRIVATE-PATH]')`
+const updated =
+  source.slice(0, match.index) +
+  canonical +
+  source.slice(match.index + match[0].length)
+
+const verificationMatches = [...updated.matchAll(statementPattern)]
+if (
+  verificationMatches.length !== 1 ||
+  verificationMatches[0][0] !== canonical
+) {
+  throw new Error(
+    `Private-path redaction repair verification failed for ${controlPath}.`,
+  )
+}
+
+if (updated !== source) {
+  await writeFile(controlPath, updated, 'utf8')
+  process.stdout.write(
+    `Repaired private-path redaction statement before Desktop typecheck: ${controlPath}\n`,
+  )
+}
+
+const verified = await readFile(controlPath, 'utf8')
+if (!verified.includes(canonical)) {
+  throw new Error(
+    `Canonical private-path redaction statement is missing from ${controlPath}.`,
+  )
+}
-- 
