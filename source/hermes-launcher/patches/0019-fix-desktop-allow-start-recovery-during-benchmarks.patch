From 0d6942cfe48c3baf5cb44a12438054ffa5c1e9c1 Mon Sep 17 00:00:00 2001
From: xdCloudy <52116030+xdCloudy@users.noreply.github.com>
Date: Thu, 30 Jul 2026 19:05:00 +0000
Subject: [PATCH 19/26] fix(desktop): allow start recovery during benchmarks

---
 .../electron/hermes-local-control.test.ts     | 30 +++++++++++++++----
 apps/desktop/electron/hermes-local-control.ts |  9 +++++-
 2 files changed, 32 insertions(+), 7 deletions(-)

diff --git a/apps/desktop/electron/hermes-local-control.test.ts b/apps/desktop/electron/hermes-local-control.test.ts
index f4ec0e9de..ae9ca57f7 100644
--- a/apps/desktop/electron/hermes-local-control.test.ts
+++ b/apps/desktop/electron/hermes-local-control.test.ts
@@ -138,17 +138,35 @@ describe('Hermes Local Electron boundary', () => {
     expect(settled).toBe(true)
   })
 
-  it('returns the running task for matching and overlapping action requests', () => {
-    const running = {
+  it('returns conflicting tasks but permits idempotent start recovery during a benchmark', () => {
+    const backup = {
       action: 'backup',
       status: 'running'
     }
 
-    const taskMap = new Map([['backup-task', running]])
-    const actionIds = new Map([['backup', 'backup-task']])
+    const backupTaskMap = new Map([['backup-task', backup]])
+    const backupActionIds = new Map([['backup', 'backup-task']])
 
-    expect(hermesLocalControlTest.runningTask('backup', actionIds as never, taskMap as never)).toBe(running)
-    expect(hermesLocalControlTest.runningTask('restart', actionIds as never, taskMap as never)).toBe(running)
+    expect(hermesLocalControlTest.runningTask('backup', backupActionIds as never, backupTaskMap as never)).toBe(backup)
+    expect(hermesLocalControlTest.runningTask('restart', backupActionIds as never, backupTaskMap as never)).toBe(backup)
+
+    const benchmark = {
+      action: 'benchmark',
+      status: 'running'
+    }
+
+    const benchmarkTaskMap = new Map([['benchmark-task', benchmark]])
+    const benchmarkActionIds = new Map([['benchmark', 'benchmark-task']])
+
+    expect(
+      hermesLocalControlTest.runningTask('start', benchmarkActionIds as never, benchmarkTaskMap as never)
+    ).toBeNull()
+    expect(
+      hermesLocalControlTest.runningTask('restart', benchmarkActionIds as never, benchmarkTaskMap as never)
+    ).toBe(benchmark)
+    expect(
+      hermesLocalControlTest.runningTask('benchmark', benchmarkActionIds as never, benchmarkTaskMap as never)
+    ).toBe(benchmark)
   })
 
   it('retains running tasks while bounding completed task history', () => {
diff --git a/apps/desktop/electron/hermes-local-control.ts b/apps/desktop/electron/hermes-local-control.ts
index 02f0c781c..9c4cfb8c2 100644
--- a/apps/desktop/electron/hermes-local-control.ts
+++ b/apps/desktop/electron/hermes-local-control.ts
@@ -207,6 +207,13 @@ function publicTask(task: ActionTask) {
   }
 }
 
+function actionsConflict(requestedAction: ActionName, activeAction: ActionName): boolean {
+  // Start is an idempotent readiness/recovery action. It may join the stack
+  // while a benchmark owns model resources, but disruptive actions remain
+  // mutually exclusive with the benchmark.
+  return !(requestedAction === 'start' && activeAction === 'benchmark')
+}
+
 function runningTask(
   requestedAction: ActionName,
   actionIds: Map<ActionName, string> = runningActions,
@@ -222,7 +229,7 @@ function runningTask(
   for (const taskId of actionIds.values()) {
     const task = taskMap.get(taskId)
 
-    if (task?.status === 'running') {
+    if (task?.status === 'running' && actionsConflict(requestedAction, task.action)) {
       return task
     }
   }
-- 
