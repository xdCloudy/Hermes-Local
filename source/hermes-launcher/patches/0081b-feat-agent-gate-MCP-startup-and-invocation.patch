From 3939393939393939393939393939393939393939 Mon Sep 17 00:00:00 2001
From: OpenAI <openai@localhost>
Date: Sat, 8 Aug 2026 02:24:00 +0100
Subject: [PATCH] feat(agent): gate MCP startup and invocation

---
 tools/mcp_tool.py | 35 ++++++++++++++++++++++++++++++++++-
 1 file changed, 34 insertions(+), 1 deletion(-)

diff --git a/tools/mcp_tool.py b/tools/mcp_tool.py
--- a/tools/mcp_tool.py
+++ b/tools/mcp_tool.py
@@ -4665,4 +4665,9 @@ def _load_mcp_config() -> Dict[str, dict]:
                 _warn_hidden_whitespace(name, interpolated)
                 safe_servers[name] = interpolated
-        return safe_servers
+        try:
+            from hermes_cli.hermes_local_trust import filter_authorized_mcp_servers
+            return filter_authorized_mcp_servers(safe_servers)
+        except Exception as trust_exc:
+            logger.warning("Hermes Local MCP trust gate failed closed: %s", trust_exc)
+            return {}
     except Exception as exc:
@@ -4881,3 +4886,31 @@ def _make_tool_handler(server_name: str, tool_name: str, tool_timeout: float):
 
     def _handler(args: dict, **kwargs) -> str:
+        try:
+            from hermes_cli.hermes_local_trust import authorize_mcp_operation
+            decision = authorize_mcp_operation(server_name, "tool.call", interactive=True)
+        except Exception as trust_exc:
+            logger.error("Hermes Local MCP authorization failed closed: %s", trust_exc)
+            return tool_error(
+                f"MCP integration '{server_name}' was blocked because native trust authorization failed."
+            )
+        if not decision.allowed:
+            return tool_error(
+                f"MCP integration '{server_name}' is denied by Hermes Local Trust Centre: "
+                f"{decision.reason}. Review source, capabilities and grants before retrying."
+            )
+        if decision.requires_confirmation:
+            try:
+                from tools.approval import request_tool_approval
+                approval = request_tool_approval(
+                    f"mcp:{server_name}:{tool_name}",
+                    f"Trust Centre requires confirmation before MCP tool '{tool_name}' "
+                    f"on integration '{server_name}' may create an external side effect.",
+                    rule_key=f"hermes-local-trust:{server_name}:{tool_name}",
+                )
+            except Exception as approval_exc:
+                logger.error("Hermes Local MCP confirmation failed closed: %s", approval_exc)
+                return tool_error(f"MCP tool '{tool_name}' was blocked because confirmation was unavailable.")
+            if not approval.get("approved"):
+                return tool_error(approval.get("message") or f"The user did not approve MCP tool '{tool_name}'.")
+
         # Circuit breaker: if this server has failed too many times
         # consecutively, short-circuit with a clear message so the model
-- 
