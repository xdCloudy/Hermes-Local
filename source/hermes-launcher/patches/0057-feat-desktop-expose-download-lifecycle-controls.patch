index a35958a..7fc20d4 100644
--- a/apps/desktop/src/app/local-workstation/types.ts
+++ b/apps/desktop/src/app/local-workstation/types.ts
@@ -25,6 +25,7 @@ export type LocalAction =
   | 'backup'
   | 'benchmark'
   | 'diagnostics'
+  | 'model-download'
   | 'repair'
   | 'restart'
   | 'restore'
@@ -100,18 +101,24 @@ export interface LocalActionTask {
     pid: null | number
   }
   progress?: null | {
+    bytesCompleted?: null | number
+    bytesTotal?: null | number
     cancellable?: boolean
     completedUnits: null | number
     counters: Record<string, number>
+    etaSeconds?: null | number
     message: null | string
     mode: 'determinate' | 'indeterminate'
+    pauseSupported?: boolean
     percent: null | number
+    rateBytesPerSecond?: null | number
+    resumeSupported?: boolean
     totalUnits: null | number
   }
   queuedAt: string
   resources: {
     mode: 'exclusive' | 'shared'
-    resource: 'installation' | 'model-runtime' | 'user-data' | 'workstation'
+    resource: 'installation' | 'model-runtime' | 'model-storage' | 'user-data' | 'workstation'
   }[]
   result: null | {
     kind: 'archive' | 'report' | 'runtime-state'
@@ -120,7 +127,7 @@ export interface LocalActionTask {
   schemaVersion: 1
   stage?: null | string
   startedAt: null | string
-  status: 'cancelled' | 'cancelling' | 'failed' | 'interrupted' | 'queued' | 'running' | 'succeeded'
+  status: 'cancelled' | 'cancelling' | 'failed' | 'interrupted' | 'paused' | 'queued' | 'running' | 'succeeded'
   updatedAt: string
 }
 
