From 33e66c5af7d4cd9c232bbb82148fd4740265ae86 Mon Sep 17 00:00:00 2001
From: OpenAI <openai@localhost>
Date: Wed, 5 Aug 2026 09:37:00 +0100
Subject: [PATCH] feat(desktop): expose download lifecycle controls

---
 apps/desktop/electron/preload.ts              |  2 +
 apps/desktop/src/app/chat/sidebar/index.tsx   |  8 ++-
 .../src/app/local-workstation/index.tsx       |  8 +++
 .../src/app/local-workstation/task-centre.tsx | 57 ++++++++++++++++---
 .../src/app/local-workstation/types.ts        | 11 +++-
 apps/desktop/src/global.d.ts                  |  2 +
 6 files changed, 75 insertions(+), 13 deletions(-)

diff --git a/apps/desktop/electron/preload.ts b/apps/desktop/electron/preload.ts
index 41f2d67..38e56aa 100644
--- a/apps/desktop/electron/preload.ts
+++ b/apps/desktop/electron/preload.ts
@@ -114,6 +114,8 @@ contextBridge.exposeInMainWorld('hermesDesktop', {
     actionStatus: taskId => ipcRenderer.invoke('hermes:local:action:status', taskId),
     listActions: () => ipcRenderer.invoke('hermes:local:action:list'),
     cancelAction: taskId => ipcRenderer.invoke('hermes:local:action:cancel', taskId),
+    pauseAction: taskId => ipcRenderer.invoke('hermes:local:action:pause', taskId),
+    resumeAction: taskId => ipcRenderer.invoke('hermes:local:action:resume', taskId),
     retryAction: taskId => ipcRenderer.invoke('hermes:local:action:retry', taskId),
     openActionResult: taskId => ipcRenderer.invoke('hermes:local:action:open-result', taskId),
     logs: (name, lines) => ipcRenderer.invoke('hermes:local:logs', name, lines),
diff --git a/apps/desktop/src/app/chat/sidebar/index.tsx b/apps/desktop/src/app/chat/sidebar/index.tsx
index d8c42ef..e070821 100644
--- a/apps/desktop/src/app/chat/sidebar/index.tsx
+++ b/apps/desktop/src/app/chat/sidebar/index.tsx
@@ -398,8 +398,12 @@ export function ChatSidebar({
 
         if (mounted) {
           setActiveTaskCount(
-            tasks.filter(task => task.status === 'queued' || task.status === 'running' || task.status === 'cancelling')
-              .length
+            tasks.filter(task =>
+              task.status === 'queued' ||
+              task.status === 'running' ||
+              task.status === 'cancelling' ||
+              task.status === 'paused'
+            ).length
           )
         }
       } catch {
diff --git a/apps/desktop/src/app/local-workstation/index.tsx b/apps/desktop/src/app/local-workstation/index.tsx
index 0c9135b..70638fe 100644
--- a/apps/desktop/src/app/local-workstation/index.tsx
+++ b/apps/desktop/src/app/local-workstation/index.tsx
@@ -1778,6 +1778,14 @@ function SectionContent({
         onOpenResult={async taskId => {
           await window.hermesDesktop.localWorkstation.openActionResult(taskId)
         }}
+        onPause={async taskId => {
+          await window.hermesDesktop.localWorkstation.pauseAction(taskId)
+          onRefresh()
+        }}
+        onResume={async taskId => {
+          await window.hermesDesktop.localWorkstation.resumeAction(taskId)
+          onRefresh()
+        }}
         onRetry={async taskId => {
           await window.hermesDesktop.localWorkstation.retryAction(taskId)
           onRefresh()
diff --git a/apps/desktop/src/app/local-workstation/task-centre.tsx b/apps/desktop/src/app/local-workstation/task-centre.tsx
index ccb96f7..689a2e8 100644
--- a/apps/desktop/src/app/local-workstation/task-centre.tsx
+++ b/apps/desktop/src/app/local-workstation/task-centre.tsx
@@ -32,12 +32,13 @@ export const TASK_FILTERS: { id: TaskFilter; label: string }[] = [
   { id: 'cancelled', label: 'Cancelled' }
 ]
 
-const activeStates = new Set<LocalActionTask['status']>(['cancelling', 'queued', 'running'])
+const activeStates = new Set<LocalActionTask['status']>(['cancelling', 'paused', 'queued', 'running'])
 
 const ACTION_COPY: Record<LocalActionTask['action'], { feature: string; label: string; route: string }> = {
   backup: { feature: 'Services', label: 'Backup', route: '/services' },
   benchmark: { feature: 'Benchmarks', label: 'Benchmark', route: '/benchmarks' },
   diagnostics: { feature: 'Services', label: 'Diagnostics', route: '/services' },
+  'model-download': { feature: 'Models', label: 'Model download', route: '/models' },
   repair: { feature: 'Services', label: 'Repair', route: '/services' },
   restart: { feature: 'Services', label: 'Restart', route: '/services' },
   restore: { feature: 'Restore', label: 'Restore', route: '/restore' },
@@ -54,6 +55,7 @@ const STATUS_COPY: Record<LocalActionTask['status'], string> = {
   cancelling: 'Cancelling',
   failed: 'Failed',
   interrupted: 'Interrupted',
+  paused: 'Paused',
   queued: 'Queued',
   running: 'Running',
   succeeded: 'Completed'
@@ -119,7 +121,11 @@ function taskStage(task: LocalActionTask): string {
     return task.action === 'restore' ? 'Waiting for a safe restore cancellation boundary' : 'Stopping owned process'
   }
 
-  if (task.status === 'running') {return task.stage || `${ACTION_COPY[task.action].label} in progress`}
+  if (task.status === 'paused') {return task.progress?.message || 'Paused with resumable partial data'}
+
+  if (task.status === 'running') {
+    return task.progress?.message || task.stage || `${ACTION_COPY[task.action].label} in progress`
+  }
 
   if (task.status === 'interrupted') {return 'Owner exited without a conclusive result'}
 
@@ -149,7 +155,7 @@ function statusTone(status: LocalActionTask['status']): string {
 
   if (status === 'failed') {return 'text-red-500'}
 
-  if (status === 'interrupted' || status === 'cancelled') {return 'text-amber-500'}
+  if (status === 'interrupted' || status === 'cancelled' || status === 'paused') {return 'text-amber-500'}
 
   if (status === 'queued' || status === 'cancelling') {return 'text-amber-500'}
 
@@ -167,6 +173,8 @@ function StatusIcon({ status }: { status: LocalActionTask['status'] }) {
 
   if (status === 'cancelled') {return <IconBan className="size-4" />}
 
+  if (status === 'paused') {return <IconPlayerPause className="size-4" />}
+
   return <IconClock className="size-4" />
 }
 
@@ -188,6 +196,8 @@ interface TaskCentreProps {
   onError: (message: string) => void
   onNavigate: (path: string) => void
   onOpenResult: (taskId: string) => Promise<void>
+  onPause: (taskId: string) => Promise<void>
+  onResume: (taskId: string) => Promise<void>
   onRetry: (taskId: string) => Promise<void>
   profileName: string
   tasks: LocalActionTask[]
@@ -199,6 +209,8 @@ export function TaskCentre({
   onError,
   onNavigate,
   onOpenResult,
+  onPause,
+  onResume,
   onRetry,
   profileName,
   tasks
@@ -215,7 +227,7 @@ export function TaskCentre({
 
   const selected =
     visibleTasks.find(task => task.id === selectedTaskId) ||
-    visibleTasks.find(task => task.status === 'running' || task.status === 'cancelling') ||
+    visibleTasks.find(task => task.status === 'running' || task.status === 'cancelling' || task.status === 'paused') ||
     visibleTasks[0]
 
   const selectedProgressPercent =
@@ -382,11 +394,25 @@ export function TaskCentre({
                     {pendingControl === 'cancel' ? <IconLoader2 className="size-3.5 animate-spin" /> : <IconX className="size-3.5" />}
                     Cancel
                   </Button>
-                  <Button className="h-8 gap-1.5 px-3 text-xs" disabled size="sm" title="Pause is not supported by this action" variant="outline">
-                    <IconPlayerPause className="size-3.5" /> Pause
+                  <Button
+                    className="h-8 gap-1.5 px-3 text-xs"
+                    disabled={!selected.capabilities.pause || Boolean(pendingControl)}
+                    onClick={() => void invoke('pause', () => onPause(selected.id))}
+                    size="sm"
+                    title={selected.capabilities.pause ? 'Pause after the current safe write boundary' : 'Pause is unavailable in this stage'}
+                    variant="outline"
+                  >
+                    {pendingControl === 'pause' ? <IconLoader2 className="size-3.5 animate-spin" /> : <IconPlayerPause className="size-3.5" />} Pause
                   </Button>
-                  <Button className="h-8 gap-1.5 px-3 text-xs" disabled size="sm" title="Resume is not supported by this action" variant="outline">
-                    <IconPlayerPlay className="size-3.5" /> Resume
+                  <Button
+                    className="h-8 gap-1.5 px-3 text-xs"
+                    disabled={!selected.capabilities.resume || Boolean(pendingControl)}
+                    onClick={() => void invoke('resume', () => onResume(selected.id))}
+                    size="sm"
+                    title={selected.capabilities.resume ? 'Resume this task from its retained partial data' : 'Resume is unavailable'}
+                    variant="outline"
+                  >
+                    {pendingControl === 'resume' ? <IconLoader2 className="size-3.5 animate-spin" /> : <IconPlayerPlay className="size-3.5" />} Resume
                   </Button>
                   {selected.capabilities.retry && (
                     <Button
@@ -418,11 +444,12 @@ export function TaskCentre({
                   className={cn(
                     'h-full bg-(--ui-accent) transition-[width]',
                     activeStates.has(selected.status) &&
+                      selected.status !== 'paused' &&
                       selectedProgressPercent === null &&
                       'w-1/3 animate-pulse motion-reduce:animate-none',
                     selected.status === 'succeeded' && 'w-full bg-emerald-500',
                     (selected.status === 'failed' || selected.status === 'interrupted') && 'w-full bg-red-500',
-                    selected.status === 'cancelled' && 'w-full bg-amber-500'
+                    (selected.status === 'cancelled' || selected.status === 'paused') && 'bg-amber-500'
                   )}
                   style={
                     activeStates.has(selected.status) && selectedProgressPercent !== null
@@ -463,6 +490,18 @@ export function TaskCentre({
               <DetailRow icon={IconClock} label="Elapsed">
                 <span className="font-mono">{taskElapsed(selected)}</span>
               </DetailRow>
+              {selected.action === 'model-download' && selected.progress && (
+                <DetailRow icon={IconFile} label="Transfer">
+                  <span className="font-mono">
+                    {selected.progress.bytesCompleted?.toLocaleString() || 0}
+                    {selected.progress.bytesTotal ? ` / ${selected.progress.bytesTotal.toLocaleString()} bytes` : ' bytes'}
+                    {selected.progress.rateBytesPerSecond
+                      ? ` · ${Math.round(selected.progress.rateBytesPerSecond).toLocaleString()} B/s`
+                      : ''}
+                    {selected.progress.etaSeconds ? ` · ETA ${Math.ceil(selected.progress.etaSeconds)}s` : ''}
+                  </span>
+                </DetailRow>
+              )}
               <DetailRow icon={IconServer} label="Owner">
                 <span className="font-mono">
                   {selected.owner.kind === 'external-process' ? 'External process' : 'Desktop process'}
