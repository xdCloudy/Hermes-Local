From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hermes Local Integration <hermes-local-ci@localhost>
Date: Tue, 4 Aug 2026 19:15:00 +0100
Subject: [PATCH 38/38] fix(desktop): restore private-path backslash literal

The integrated Desktop source can contain a collapsed single backslash in the
private-path redactor after source activation on Windows. That escapes the
closing quote and leaves hermes-local-control.ts syntactically invalid.

Restore the intended TypeScript string literal before launcher typechecking.

---
 apps/desktop/electron/hermes-local-control.ts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/apps/desktop/electron/hermes-local-control.ts b/apps/desktop/electron/hermes-local-control.ts
--- a/apps/desktop/electron/hermes-local-control.ts
+++ b/apps/desktop/electron/hermes-local-control.ts
@@ -244,7 +244,7 @@ function redacted(text: string): string {
   }
 
   for (const privatePath of privatePaths.filter((value): value is string => Boolean(value))) {
-    safe = safe.replaceAll(privatePath, '[PRIVATE-PATH]').replaceAll(privatePath.replaceAll('\', '/'), '[PRIVATE-PATH]')
+    safe = safe.replaceAll(privatePath, '[PRIVATE-PATH]').replaceAll(privatePath.replaceAll('\\', '/'), '[PRIVATE-PATH]')
   }
 
   return safe
-- 
2.50.1
