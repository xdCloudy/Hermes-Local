@@ -478,6 +511,154 @@ def _skill_inventory() -> list[dict[str, Any]]:
     return output
 
 
+def _bundled_skill_hashes() -> set[tuple[str, str]]:
+    repo = Path(__file__).resolve().parents[1]
+    output: set[tuple[str, str]] = set()
+    for root in (repo / "skills", repo / "optional-skills"):
+        if not root.is_dir():
+            continue
+        for skill_file in root.rglob("SKILL.md"):
+            try:
+                output.add((skill_file.parent.name, hashlib.sha256(skill_file.read_bytes()).hexdigest()))
+            except OSError:
+                continue
+    return output
+
+
+def sync_skill_identity(name: str, skill_md: str | Path) -> dict[str, Any]:
+    path = Path(skill_md).expanduser().resolve()
+    if path.name != "SKILL.md" or not path.is_file():
+        raise ValueError("skill identity requires an existing SKILL.md")
+    digest = hashlib.sha256(path.read_bytes()).hexdigest()
+    path_key = hashlib.sha256(str(path).casefold().encode("utf-8")).hexdigest()[:24]
+    integration_id = f"skill:{path_key}"
+    bundled = (path.parent.name, digest) in _bundled_skill_hashes()
+    with _LOCK:
+        store = _integrations()
+        previous = next(
+            (record for record in store["integrations"] if record.get("identity", {}).get("id") == integration_id),
+            None,
+        )
+        previous_identity = previous.get("identity", {}) if previous else {}
+        changed = bool(previous and previous.get("configurationSha256") != digest)
+        if bundled:
+            state = "built-in-verified"
+        elif changed or not previous:
+            state = "restricted"
+        else:
+            state = str(previous_identity.get("trustState", "restricted"))
+        identity = {
+            "kind": "integrationIdentity",
+            "schemaVersion": 1,
+            "id": integration_id,
+            "displayName": str(name or path.parent.name)[:120],
+            "integrationType": "skill",
+            "provenance": {
+                "sourceType": "built-in" if bundled else "local-path",
+                "provenanceId": integration_id,
+                "revision": digest,
+                "sha256": digest,
+            },
+            "declaredCapabilities": [],
+            "trustState": state if state in TRUST_STATES else "unknown",
+            "healthState": "healthy",
+            "manifestRevision": max(
+                1,
+                int(previous_identity.get("manifestRevision", 0)) + (1 if changed else 0),
+            ),
+        }
+        if bundled:
+            identity["approvedManifestSha256"] = digest
+        elif previous_identity.get("approvedManifestSha256") and not changed:
+            identity["approvedManifestSha256"] = previous_identity["approvedManifestSha256"]
+        record = {
+            "identity": identity,
+            "configurationSha256": digest,
+            "sourceLabel": "bundled:" + identity["displayName"] if bundled else str(path.parent),
+            "skillPath": str(path),
+            "lastSeenAt": _now(),
+        }
+        if previous and not changed:
+            if previous.get("accessPrincipals"):
+                record["accessPrincipals"] = previous["accessPrincipals"]
+            if previous.get("accessScopes"):
+                record["accessScopes"] = previous["accessScopes"]
+        if previous:
+            store["integrations"][store["integrations"].index(previous)] = record
+        else:
+            store["integrations"].append(record)
+        _write("integrations.json", store)
+        if changed:
+            _revoke(integration_id, "manifest-changed")
+            _audit("integration.updated", "success", integration_id, manifestRevision=identity["manifestRevision"])
+        elif not previous:
+            _audit("integration.installed", "success", integration_id)
+        return record
+
+
+def sync_skill_inventory() -> list[dict[str, Any]]:
+    roots: list[Path] = []
+    try:
+        from hermes_constants import get_hermes_home
+        roots.append(Path(get_hermes_home()) / "skills")
+    except Exception:
+        pass
+    try:
+        from agent.skill_utils import get_external_skills_dirs
+        roots.extend(Path(value) for value in get_external_skills_dirs())
+    except Exception:
+        pass
+    records: list[dict[str, Any]] = []
+    seen: set[Path] = set()
+    for root in roots:
+        if not root.is_dir():
+            continue
+        for skill_file in root.rglob("SKILL.md"):
+            try:
+                resolved = skill_file.resolve()
+                if resolved in seen or skill_file.stat().st_size > 2 * 1024 * 1024:
+                    continue
+                seen.add(resolved)
+                records.append(sync_skill_identity(skill_file.parent.name, skill_file))
+            except (OSError, ValueError):
+                continue
+    return records
+
+
+def authorize_skill_load(name: str, skill_md: str | Path) -> AuthorizationDecision:
+    try:
+        record = sync_skill_identity(name, skill_md)
+    except Exception as exc:
+        decision = AuthorizationDecision(False, f"skill identity failed: {exc}", "skill:unknown", "")
+        _audit("authorization.denied", "denied", decision.integration_id, reason=decision.reason, operation="skill.load")
+        return decision
+    identity = record.get("identity", {})
+    integration_id = str(identity.get("id") or "skill:unknown")
+    state = str(identity.get("trustState") or "unknown")
+    if state == "built-in-verified":
+        decision = AuthorizationDecision(True, "built-in verified skill", integration_id, "")
+    elif state not in {"reviewed-managed", "user-trusted"}:
+        decision = AuthorizationDecision(False, f"trust state is {state}", integration_id, "")
+    else:
+        principal = _principal()
+        principals = record.get("accessPrincipals", [])
+        scopes = record.get("accessScopes", [])
+        if principal not in principals:
+            decision = AuthorizationDecision(False, "no matching agent access", integration_id, "")
+        elif not any(scope in _scope_candidates() for scope in scopes):
+            decision = AuthorizationDecision(False, "no matching scope access", integration_id, "")
+        else:
+            decision = AuthorizationDecision(True, "matching skill access", integration_id, "")
+    _audit(
+        "authorization.allowed" if decision.allowed else "authorization.denied",
+        "allowed" if decision.allowed else "denied",
+        integration_id,
+        reason=decision.reason,
+        operation="skill.load",
+    )
+    return decision
+
+
 def _audit_tail(limit: int = 100) -> list[dict[str, Any]]:
     path = _root() / "audit.jsonl"
     if not path.is_file():
@@ -504,7 +685,8 @@ def trust_snapshot() -> dict[str, Any]:
             sync_mcp_inventory(servers)
     except Exception:
         pass
-    integrations = _integrations()["integrations"] + _skill_inventory()
+    sync_skill_inventory()
+    integrations = _integrations()["integrations"]
     grants = [grant for grant in _grants()["grants"] if not grant.get("revokedAt")]
     audit = _audit_tail()
     counts: dict[str, int] = {}
