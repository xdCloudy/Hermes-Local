+                },
+                ensure_ascii=False,
+            )
+        if not trust_decision.allowed:
+            return json.dumps(
+                {
+                    "success": False,
+                    "error": f"Skill '{resolved_name}' is denied by Hermes Local Trust Centre: {trust_decision.reason}",
+                },
+                ensure_ascii=False,
+            )
+
