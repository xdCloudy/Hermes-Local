         "argumentCount": len(config.get("args") or []) if isinstance(config.get("args"), list) else 0,
+        "argumentsSha256": hashlib.sha256(json.dumps(config.get("args") or [], sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8")).hexdigest(),
@@ -179,2 +181,4 @@ def _scope_candidates() -> list[dict[str, str]]:
     result: list[dict[str, str]] = []
