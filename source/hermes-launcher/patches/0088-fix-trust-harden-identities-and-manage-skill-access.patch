+            principal = {"kind": "agent", "id": str(scope["id"])}
@@ -388,2 +403,4 @@ def set_integration_policy(
         identity = record["identity"]
+        if identity.get("trustState") == "built-in-verified":
+            raise ValueError("built-in verified integrations are immutable")
         if not set(requested).issubset(set(identity.get("declaredCapabilities", []))):
@@ -391,2 +408,18 @@ def set_integration_policy(
         _revoke(integration_id, "policy-replaced")
+        if identity.get("integrationType") == "skill":
+            identity["trustState"] = trust_state
+            identity["manifestRevision"] = int(identity.get("manifestRevision", 1)) + 1
