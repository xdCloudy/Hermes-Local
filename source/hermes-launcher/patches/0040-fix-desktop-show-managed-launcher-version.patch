--- /dev/null
+++ b/apps/desktop/src/app/shell/hooks/managed-local-version.test.ts
@@ -0,0 +1,49 @@
+import { describe, expect, it } from 'vitest'
+
+import {
+  isManagedLocalWorkstationConnection,
+  resolveHermesLocalClientVersion
+} from './managed-local-version'
+
+describe('managed Hermes Local version identity', () => {
+  it('prefers the Hermes Local product version over the upstream Desktop package version', () => {
+    expect(resolveHermesLocalClientVersion('0.18.36', '0.20.0')).toBe('0.18.36')
+  })
+
+  it('falls back to the packaged Desktop version before update status is available', () => {
+    expect(resolveHermesLocalClientVersion(undefined, '0.20.0')).toBe('0.20.0')
+  })
+
+  it.each([
+    '127.0.0.1:9119',
+    'localhost:9119',
+    'http://127.0.0.1:9119',
+    'https://localhost:9119/dashboard',
+    '[::1]:9119'
+  ])('recognises the managed loopback backend %s', remoteHost => {
+    expect(
+      isManagedLocalWorkstationConnection({
+        mode: 'remote',
+        remoteHost
+      })
+    ).toBe(true)
+  })
+
+  it.each(['agent.example.com:443', '10.0.0.5:9119', 'ssh://hermes.example'])(
+    'keeps a genuine external backend independently versioned: %s',
+    remoteHost => {
+      expect(
+        isManagedLocalWorkstationConnection({
+          mode: 'remote',
+          remoteHost
+        })
+      ).toBe(false)
+    }
+  )
+
+  it('does not classify a normal local Desktop connection as a remote backend', () => {
+    expect(
+      isManagedLocalWorkstationConnection({
+        mode: 'local',
+        remoteHost: '127.0.0.1:9119'
+      })
+    ).toBe(false)
+  })
+})
diff --git a/apps/desktop/src/app/shell/hooks/managed-local-version.ts b/apps/desktop/src/app/shell/hooks/managed-local-version.ts
new file mode 100644
index 0000000..cb861c6
--- /dev/null
+++ b/apps/desktop/src/app/shell/hooks/managed-local-version.ts
@@ -0,0 +1,35 @@
+interface DesktopConnectionIdentity {
+  mode?: string
+  remoteHost?: null | string
+}
+
+const LOOPBACK_WORKSTATION =
+  /^(?:https?:\/\/)?(?:localhost|127(?:\.\d{1,3}){3}|\[?::1\]?)(?::\d+)?(?:\/.*)?$/i
+
+function cleanVersion(value: null | string | undefined): string | undefined {
+  const clean = value?.trim()
+
+  return clean || undefined
+}
+
+export function resolveHermesLocalClientVersion(
+  productVersion: null | string | undefined,
+  packagedVersion: null | string | undefined
+): string | undefined {
+  return cleanVersion(productVersion) ?? cleanVersion(packagedVersion)
+}
+
+export function isManagedLocalWorkstationConnection(
+  connection: DesktopConnectionIdentity | null | undefined
+): boolean {
+  if (connection?.mode !== 'remote') {
+    return false
+  }
+
+  const remoteHost = connection.remoteHost?.trim()
+
+  return Boolean(remoteHost && LOOPBACK_WORKSTATION.test(remoteHost))
+}

