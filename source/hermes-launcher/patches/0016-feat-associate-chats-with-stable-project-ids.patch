+    def update_session_project(self, session_id: str, project_id: Optional[str]) -> None:
+        """Persist the stable Project owning a session, or detach it."""
+        if not session_id:
+            return
+        value = str(project_id or "").strip() or None
+
+        def _do(conn):
+            conn.execute(
+                "UPDATE sessions SET project_id = ? WHERE id = ?",
+                (value, session_id),
+            )
+
+        self._execute_write(_do)
+
