From c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0 Mon Sep 17 00:00:00 2001
From: OpenAI <openai@localhost>
Date: Sat, 8 Aug 2026 03:20:00 +0100
Subject: [PATCH] fix(trust): complete user scope and local confirmation

---
diff --git a/hermes_cli/hermes_local_trust.py b/hermes_cli/hermes_local_trust.py
index be2ba80c9010899684bbcd768bb8b690713689e0..8910af0eb75a34db8b815482dd3976627f3844d2 100644
--- a/hermes_cli/hermes_local_trust.py
+++ b/hermes_cli/hermes_local_trust.py
@@ -190,6 +190,10 @@ def _scope_candidates() -> list[dict[str, str]]:
     result: list[dict[str, str]] = []
     principal = _principal()
     result.append({"kind": "agent", "id": principal["id"]})
+    local_user = str(os.getenv("USERNAME") or os.getenv("USER") or "").strip()
+    if local_user:
+        result.append({"kind": "user", "id": _safe_id(local_user, "user")})
+
     project = os.getenv("HERMES_PROJECT_ID", "").strip()
     if project:
         result.append({"kind": "project", "id": _safe_id(project, "project")})
@@ -365,7 +369,10 @@ def authorize_mcp_operation(server_name: str, operation: str, *, interactive: bo
                 else:
                     order = {"never": 0, "local-only": 1, "writes-or-side-effects": 2, "always": 3}
                     confirmation = max((str(g.get("confirmation", "always")) for g in allows), key=lambda v: order.get(v, 3))
-                    requires = interactive and (confirmation == "always" or (confirmation == "writes-or-side-effects" and capability in RISKY))
+                    requires = interactive and (
+                        confirmation in {"always", "local-only"}
+                        or (confirmation == "writes-or-side-effects" and capability in RISKY)
+                    )
                     decision = AuthorizationDecision(True, "matching grant", integration_id, capability, requires, confirmation)
     _audit(
         "authorization.allowed" if decision.allowed else "authorization.denied",
diff --git a/tests/hermes_cli/test_hermes_local_trust.py b/tests/hermes_cli/test_hermes_local_trust.py
index 63aa521a70a5465dabf40f00c96a6eb7782faf7f..aef0cac5bc816409dc26db5f22a46f80b104bd48 100644
--- a/tests/hermes_cli/test_hermes_local_trust.py
+++ b/tests/hermes_cli/test_hermes_local_trust.py
@@ -247,3 +247,28 @@ def test_user_skill_disable_revokes_load_immediately(tmp_path):
 
     trust.set_integration_policy(record["identity"]["id"], "disabled", [], "never", {"kind": "global"})
     assert not trust.authorize_skill_load("disable-skill", skill_md).allowed
+
+
+def test_user_scope_matches_trusted_local_user_identity(monkeypatch):
+    monkeypatch.setenv("USERNAME", "Hermes User")
+    record = trust.sync_mcp_server_identity("local", local_config())
+    trust.set_integration_policy(
+        record["identity"]["id"],
+        "reviewed-managed",
+        record["identity"]["declaredCapabilities"],
+        "never",
+        {"kind": "user", "id": "Hermes User"},
+    )
+    assert trust.authorize_mcp_operation("local", "transport.local", interactive=False).allowed
+
+    monkeypatch.setenv("USERNAME", "Other User")
+    assert not trust.authorize_mcp_operation("local", "transport.local", interactive=False).allowed
+
+
+def test_local_only_confirmation_is_conservative_until_remote_context_exists():
+    record = trust.sync_mcp_server_identity("local", local_config())
+    approve(record, confirmation="local-only")
+    interactive = trust.authorize_mcp_operation("local", "tool.call", interactive=True)
+    background = trust.authorize_mcp_operation("local", "tool.call", interactive=False)
+    assert interactive.allowed and interactive.requires_confirmation
+    assert background.allowed and not background.requires_confirmation
