From 4f15d43c7d0a3c9731350e22c11f246b4fdde500 Mon Sep 17 00:00:00 2001
From: xdCloudy <52116030+xdCloudy@users.noreply.github.com>
Date: Thu, 30 Jul 2026 19:48:00 +0000
Subject: [PATCH] fix(desktop): coordinate recovery with benchmarks

Desktop readiness recovery must not start a second workstation while the
benchmark harness owns the stack for exclusive llama-bench access. Wait for
the active benchmark task to release the lifecycle lock, then join or start
the restored workstation normally.

---
 .../electron/hermes-local-control.test.ts     | 34 +++++++++++++++++--
 apps/desktop/electron/hermes-local-control.ts | 25 ++++++++++----
 2 files changed, 50 insertions(+), 9 deletions(-)

diff --git a/apps/desktop/electron/hermes-local-control.test.ts b/apps/desktop/electron/hermes-local-control.test.ts
--- a/apps/desktop/electron/hermes-local-control.test.ts
+++ b/apps/desktop/electron/hermes-local-control.test.ts
@@ -138,4 +138,4 @@ describe('Hermes Local Electron boundary', () => {
-  it('returns conflicting tasks but permits idempotent start recovery during a benchmark', () => {
+  it('returns the active task for matching and overlapping action requests', () => {
     const backup = {
       action: 'backup',
       status: 'running'
@@ -157,7 +157,7 @@ describe('Hermes Local Electron boundary', () => {
 
     expect(
       hermesLocalControlTest.runningTask('start', benchmarkActionIds as never, benchmarkTaskMap as never)
-    ).toBeNull()
+    ).toBe(benchmark)
     expect(
       hermesLocalControlTest.runningTask('restart', benchmarkActionIds as never, benchmarkTaskMap as never)
     ).toBe(benchmark)
@@ -166,4 +166,34 @@ describe('Hermes Local Electron boundary', () => {
     ).toBe(benchmark)
   })
 
+  it('waits for an active benchmark before workstation recovery continues', async () => {
+    const child = new EventEmitter()
+    const benchmark = {
+      action: 'benchmark',
+      child,
+      completedAt: null,
+      exitCode: null,
+      id: 'benchmark-task',
+      output: '',
+      startedAt: new Date().toISOString(),
+      status: 'running'
+    }
+    const taskMap = new Map([['benchmark-task', benchmark]])
+    const actionIds = new Map([['benchmark', 'benchmark-task']])
+    let settled = false
+
+    const waiting = hermesLocalControlTest.waitForBenchmarkTask(actionIds as never, taskMap as never).then(() => {
+      settled = true
+    })
+
+    await Promise.resolve()
+    expect(settled).toBe(false)
+
+    benchmark.status = 'succeeded'
+    child.emit('close', 0)
+    await waiting
+
+    expect(settled).toBe(true)
+  })
+
   it('retains running tasks while bounding completed task history', () => {
     const taskMap = new Map<string, { status: string }>()
 
diff --git a/apps/desktop/electron/hermes-local-control.ts b/apps/desktop/electron/hermes-local-control.ts
--- a/apps/desktop/electron/hermes-local-control.ts
+++ b/apps/desktop/electron/hermes-local-control.ts
@@ -207,10 +207,3 @@ function publicTask(task: ActionTask) {
-function actionsConflict(requestedAction: ActionName, activeAction: ActionName): boolean {
-  // Start is an idempotent readiness/recovery action. It may join the stack
-  // while a benchmark owns model resources, but disruptive actions remain
-  // mutually exclusive with the benchmark.
-  return !(requestedAction === 'start' && activeAction === 'benchmark')
-}
-
 function runningTask(
   requestedAction: ActionName,
   actionIds: Map<ActionName, string> = runningActions,
@@ -226,7 +219,7 @@ function runningTask(
   for (const taskId of actionIds.values()) {
     const task = taskMap.get(taskId)
 
-    if (task?.status === 'running' && actionsConflict(requestedAction, task.action)) {
+    if (task?.status === 'running') {
       return task
     }
   }
@@ -350,7 +343,21 @@ function waitForActionTask(task: ActionTask): Promise<ActionTask> {
   })
 }
 
+async function waitForBenchmarkTask(
+  actionIds: Map<ActionName, string> = runningActions,
+  taskMap: Map<string, ActionTask> = tasks
+): Promise<void> {
+  const benchmarkId = actionIds.get('benchmark')
+  const benchmark = benchmarkId ? taskMap.get(benchmarkId) : null
+
+  if (benchmark?.status === 'running') {
+    await waitForActionTask(benchmark)
+  }
+}
+
 export async function ensureHermesLocalWorkstationReady(): Promise<void> {
+  await waitForBenchmarkTask()
+
   const started = startActionTask('start', null)
   const task = tasks.get(started.id)
 
@@ -742,5 +749,6 @@ export const hermesLocalControlTest = {
   sanitizeEditableProfile,
   serviceHealth,
   setLoginItem,
-  waitForActionTask
+  waitForActionTask,
+  waitForBenchmarkTask
 }
-- 
2.51.0
