From 4bb8f0bf7b5f8d3cdd25fe98a9eb58502fa2971e Mon Sep 17 00:00:00 2001
From: xdCloudy <connerabery@gmail.com>
Date: Sat, 8 Aug 2026 18:31:00 +0100
Subject: [PATCH] test(projects): keep stale project sessions visible

A session carrying an explicit but now-missing stable project ID must not be
silently reassigned by cwd heuristics. It still belongs in the project tree's
Home/projectless bucket so the user can see it and explicitly reattach it.

The implementation already does this; the regression assertion incorrectly
expected the session to disappear from scoped_session_ids entirely.
---
 tests/tui_gateway/test_project_tree.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tests/tui_gateway/test_project_tree.py b/tests/tui_gateway/test_project_tree.py
--- a/tests/tui_gateway/test_project_tree.py
+++ b/tests/tui_gateway/test_project_tree.py
@@ -571,4 +571,4 @@ def test_stale_stable_project_id_does_not_path_fallback():
     tree = pt.build_tree(projects, [session], [], resolve=lambda _cwd: None, hydrate=True)
     one_project = next(node for node in tree["projects"] if node["id"] == "p_one")
     assert one_project["sessionCount"] == 0
-    assert "chat" not in tree["scoped_session_ids"]
+    assert "chat" in tree["scoped_session_ids"]
