@@ -632,6 +632,45 @@ def sync_skill_inventory() -> list[dict[str, Any]]:
     return records
 
 
+def skill_requires_authorization(skill_md: str | Path) -> bool:
+    """Return whether a skill path belongs to a Hermes-managed trust root.
+
+    The upstream SKILLS_DIR symbol is intentionally patchable by embedders and
+    tests. Trust Centre owns the real profile skills directory plus explicit
+    external skill roots; an injected alternate discovery root remains the
+    responsibility of the caller that installed it. Plugin skill serving has
+    its own unconditional Trust Centre gate.
+    """
+    try:
+        resolved = Path(skill_md).expanduser().resolve()
+    except (OSError, RuntimeError):
+        return False
+
+    roots: list[Path] = []
+    try:
+        from hermes_constants import get_hermes_home
+        roots.append((Path(get_hermes_home()) / "skills").expanduser().resolve())
+    except (ImportError, OSError, RuntimeError):
+        pass
+    try:
+        from agent.skill_utils import get_external_skills_dirs
+        for value in get_external_skills_dirs():
+            try:
+                roots.append(Path(value).expanduser().resolve())
+            except (OSError, RuntimeError):
+                continue
+    except (ImportError, OSError, RuntimeError):
+        pass
+
+    for root in roots:
+        try:
+            resolved.relative_to(root)
+            return True
+        except ValueError:
+            continue
+    return False
+
+
 def authorize_skill_load(name: str, skill_md: str | Path) -> AuthorizationDecision:
     try:
         record = sync_skill_identity(name, skill_md)
diff --git a/tests/hermes_cli/test_hermes_local_trust.py b/tests/hermes_cli/test_hermes_local_trust.py
index aef0cac5b..30111bc6a 100644
--- a/tests/hermes_cli/test_hermes_local_trust.py
+++ b/tests/hermes_cli/test_hermes_local_trust.py
@@ -272,3 +272,29 @@ def test_local_only_confirmation_is_conservative_until_remote_context_exists():
     background = trust.authorize_mcp_operation("local", "tool.call", interactive=False)
     assert interactive.allowed and interactive.requires_confirmation
     assert background.allowed and not background.requires_confirmation
+
+def test_skill_root_classifier_enforces_managed_roots_but_not_injected_fixtures(tmp_path, monkeypatch):
+    import hermes_constants
+    from agent import skill_utils
+
+    managed_home = tmp_path / "home"
+    managed_skill = managed_home / "skills" / "managed" / "SKILL.md"
+    managed_skill.parent.mkdir(parents=True)
+    managed_skill.write_text("# managed\n", encoding="utf-8")
+
+    external_root = tmp_path / "external"
+    external_skill = external_root / "ext" / "SKILL.md"
+    external_skill.parent.mkdir(parents=True)
+    external_skill.write_text("# external\n", encoding="utf-8")
+
+    fixture_skill = tmp_path / "pytest-injected" / "fixture" / "SKILL.md"
+    fixture_skill.parent.mkdir(parents=True)
+    fixture_skill.write_text("# fixture\n", encoding="utf-8")
+
+    monkeypatch.setattr(hermes_constants, "get_hermes_home", lambda: managed_home)
+    monkeypatch.setattr(skill_utils, "get_external_skills_dirs", lambda: [external_root])
+
+    assert trust.skill_requires_authorization(managed_skill)
+    assert trust.skill_requires_authorization(external_skill)
+    assert not trust.skill_requires_authorization(fixture_skill)
+
