From 1111111111111111111111111111111111111111 Mon Sep 17 00:00:00 2001
From: OpenAI <noreply@openai.com>
Date: Fri, 31 Jul 2026 02:31:00 +0000
Subject: [PATCH] fix(desktop): complete dashboard on DOM readiness

Do not keep the embedded dashboard hidden while waiting indefinitely for
Electron's did-finish-load event. Track the committed main-frame response and
complete a successful same-origin load when its DOM is ready, while retaining
did-finish-load as a compatibility fallback.
---
 .../hermes-local-dashboard-view.test.ts       | 25 +++++++++++--
 .../electron/hermes-local-dashboard-view.ts   | 52 ++++++++++++++++++---------
 2 files changed, 58 insertions(+), 19 deletions(-)

diff --git a/apps/desktop/electron/hermes-local-dashboard-view.test.ts b/apps/desktop/electron/hermes-local-dashboard-view.test.ts
--- a/apps/desktop/electron/hermes-local-dashboard-view.test.ts
+++ b/apps/desktop/electron/hermes-local-dashboard-view.test.ts
@@ -22,12 +22,18 @@ const TOKEN = 'A'.repeat(48)
 class FakeWebContents extends EventEmitter {
   closed = false
   currentUrl = ''
+  finishLoad = true
   id = Math.floor(Math.random() * 100_000)
   loadURL = vi.fn(async (url: string) => {
     this.emit('did-start-loading')
     this.currentUrl = url
-    this.emit('did-finish-load')
+    this.emit('did-navigate', {}, url, 200, 'OK')
+    this.emit('dom-ready')
+
+    if (this.finishLoad) {
+      this.emit('did-finish-load')
+    }
   })
   windowOpenHandler: ((details: { url: string }) => { action: string }) | null = null
 
@@ -92,7 +98,7 @@ function fakeSession() {
   }
 }
 
-function harness() {
+function harness(options: { finishLoad?: boolean } = {}) {
   const views: FakeView[] = []
   const childViews = new Set<FakeView>()
   const renderer = {}
@@ -114,6 +120,7 @@ function harness() {
     clearTimeout: vi.fn(),
     createView: () => {
       const view = new FakeView()
+      view.webContents.finishLoad = options.finishLoad ?? true
       views.push(view)
 
       return view as never
@@ -219,6 +226,20 @@ describe('Hermes Local embedded dashboard policy', () => {
     expect(views[0].webContents.loadURL).toHaveBeenCalledTimes(1)
   })
 
+  it('shows a successful dashboard when DOM readiness arrives without did-finish-load', async () => {
+    const { controller, views } = harness({ finishLoad: false })
+
+    await controller.show(
+      { token: TOKEN, url: 'http://127.0.0.1:9119' },
+      { height: 500, width: 800, x: 20, y: 100 }
+    )
+
+    expect(controller.getState().phase).toBe('ready')
+    expect(controller.getState().message).toMatch(/connected/i)
+    expect(views[0].visible).toBe(true)
+    expect(views[0].webContents.loadURL).toHaveBeenCalledTimes(1)
+  })
+
   it('recreates the view after a renderer crash and after a configured connection change', async () => {
     const { controller, timers, views } = harness()
     const bounds = { height: 500, width: 800, x: 20, y: 100 }
