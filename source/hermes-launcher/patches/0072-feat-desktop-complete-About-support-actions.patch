+              <Value label="Published-build match" value={publishedBuildState} />
+              <Value label="Launch at sign-in" value={snapshot.startup.available ? snapshot.startup.enabled ? 'Enabled' : 'Disabled' : 'Unavailable'} />
+              <Value label="Executable" value={snapshot.startup.executable || 'Unavailable'} />
               <Value label="Last update check" value={latest?.updatedAt || latest?.requestedAt || 'Never'} />
