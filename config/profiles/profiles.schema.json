{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.hermes.invalid/schemas/profiles.schema.json",
  "title": "Hermes Local inference profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "selected", "profiles"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "selected": { "type": "string", "minLength": 1 },
    "selectionStatus": { "type": "string" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "profile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "contextTokens",
          "kvCache",
          "threads",
          "batch",
          "gpu",
          "flashAttention",
          "promptCache",
          "speculativeDecoding"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "contextTokens": { "type": "integer", "minimum": 2048, "maximum": 262144 },
          "kvCache": {
            "type": "object",
            "additionalProperties": false,
            "required": ["keyType", "valueType"],
            "properties": {
              "keyType": { "enum": ["f16", "q8_0", "q4_0"] },
              "valueType": { "enum": ["f16", "q8_0", "q4_0"] }
            }
          },
          "threads": {
            "type": "object",
            "additionalProperties": false,
            "required": ["generation", "batch"],
            "properties": {
              "generation": {
                "oneOf": [
                  { "const": "auto" },
                  { "type": "integer", "minimum": 1, "maximum": 512 }
                ]
              },
              "batch": {
                "oneOf": [
                  { "const": "auto" },
                  { "type": "integer", "minimum": 1, "maximum": 512 }
                ]
              }
            }
          },
          "batch": {
            "type": "object",
            "additionalProperties": false,
            "required": ["logical", "physical"],
            "properties": {
              "logical": { "type": "integer", "minimum": 32 },
              "physical": { "type": "integer", "minimum": 16 }
            }
          },
          "gpu": {
            "type": "object",
            "additionalProperties": false,
            "required": ["layers", "vramReserveMiB"],
            "properties": {
              "layers": {
                "oneOf": [
                  { "const": "auto" },
                  { "type": "integer", "minimum": 0, "maximum": 999 }
                ]
              },
              "vramReserveMiB": {
                "oneOf": [
                  { "const": "auto" },
                  { "type": "integer", "minimum": 0, "maximum": 131072 }
                ]
              }
            }
          },
          "flashAttention": { "type": "boolean" },
          "promptCache": { "type": "boolean" },
          "speculativeDecoding": { "type": "boolean" },
          "experimental": { "type": "boolean" },
          "seed": { "type": "integer" }
        }
    }
  }
}
