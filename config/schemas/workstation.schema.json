{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.hermes.invalid/schemas/workstation.schema.json",
  "title": "Hermes Local workstation settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": { "enum": ["127.0.0.1", "::1", "localhost"] },
        "modelPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "hermesPort": { "type": "integer", "minimum": 1024, "maximum": 65535 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acceleration": { "enum": ["auto", "cpu", "cuda"] },
        "buildParallelism": {
          "oneOf": [
            { "const": "auto" },
            { "type": "integer", "minimum": 1, "maximum": 512 }
          ]
        },
        "cudaArchitecture": {
          "oneOf": [
            { "const": "auto" },
            { "type": "string", "pattern": "^[0-9]{2,3}$" }
          ]
        },
        "pythonVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "verifyModelOnStart": { "type": "boolean" }
      }
    },
    "selectedModelId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "selectedProfile": { "type": "string", "minLength": 1, "maxLength": 64 },
    "models": {
      "type": "array",
      "items": { "$ref": "model.schema.json" }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "profiles.schema.json#/$defs/profile" }
    }
  }
}
