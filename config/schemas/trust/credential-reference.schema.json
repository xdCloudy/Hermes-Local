{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.hermes.invalid/schemas/trust/credential-reference.schema.json",
  "title": "Hermes Local credential reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "id", "provider", "storage", "handle", "scope", "allowedIntegrationIds", "accessMode", "createdAt", "revision"],
  "properties": {
    "kind": { "const": "credentialReference" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "https://local.hermes.invalid/schemas/trust/common.schema.json#/$defs/recordId" },
    "provider": { "type": "string", "minLength": 1, "maxLength": 120 },
    "storage": { "type": "string", "enum": ["dpapi-current-user", "windows-credential-manager", "os-keyring", "external-broker"] },
    "handle": { "type": "string", "minLength": 1, "maxLength": 512 },
    "scope": { "$ref": "https://local.hermes.invalid/schemas/trust/common.schema.json#/$defs/scope" },
    "allowedIntegrationIds": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "https://local.hermes.invalid/schemas/trust/common.schema.json#/$defs/recordId" }
    },
    "accessMode": { "type": "string", "enum": ["never-export", "request-header", "environment", "stdin", "brokered-call"] },
    "createdAt": { "$ref": "https://local.hermes.invalid/schemas/trust/common.schema.json#/$defs/timestamp" },
    "rotatedAt": { "$ref": "https://local.hermes.invalid/schemas/trust/common.schema.json#/$defs/timestamp" },
    "expiresAt": { "$ref": "https://local.hermes.invalid/schemas/trust/common.schema.json#/$defs/timestamp" },
    "revokedAt": { "$ref": "https://local.hermes.invalid/schemas/trust/common.schema.json#/$defs/timestamp" },
    "revision": { "type": "integer", "minimum": 1 }
  }
}
