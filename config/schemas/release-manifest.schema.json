{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xdCloudy/Hermes-Local/config/schemas/release-manifest.schema.json",
  "title": "Hermes Local release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "release",
    "sources",
    "dependencyLocks",
    "build",
    "provenance",
    "signing",
    "sboms",
    "artifacts",
    "checksums"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "channel",
        "createdAt"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "enum": [
            "stable",
            "beta",
            "nightly",
            "development"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hermesLocal",
        "hermesAgent",
        "llamaCpp"
      ],
      "properties": {
        "hermesLocal": {
          "$ref": "#/$defs/source"
        },
        "hermesAgent": {
          "$ref": "#/$defs/source"
        },
        "llamaCpp": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "dependencyLocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hashRecord"
      }
    },
    "build": {
      "type": "object",
      "required": [
        "workflow",
        "runId",
        "runner",
        "commands",
        "toolchains"
      ],
      "properties": {
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": [
            "string",
            "integer"
          ]
        },
        "runner": {
          "type": "object"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "toolchains": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "repository",
        "workflow",
        "runId",
        "sourceCommit",
        "required",
        "denySelfHostedRunners"
      ],
      "properties": {
        "provider": {
          "const": "github-artifact-attestations"
        },
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": [
            "string",
            "integer"
          ]
        },
        "sourceCommit": {
          "$ref": "#/$defs/commit"
        },
        "required": {
          "const": true
        },
        "denySelfHostedRunners": {
          "const": true
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "authenticode"
      ],
      "properties": {
        "manifest": {
          "const": "github-artifact-attestation"
        },
        "authenticode": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requiredFor",
            "timestampRequired",
            "certificateProvisioned"
          ],
          "properties": {
            "requiredFor": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/safePath"
              },
              "uniqueItems": true
            },
            "timestampRequired": {
              "const": true
            },
            "certificateProvisioned": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "sboms": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/hashRecord"
          },
          {
            "type": "object",
            "required": [
              "scope",
              "format"
            ],
            "properties": {
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "const": "CycloneDX"
              }
            }
          }
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sizeBytes",
          "sha256",
          "authenticodeRequired",
          "sboms",
          "provenanceRequired"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/safePath"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "authenticodeRequired": {
            "type": "boolean"
          },
          "sboms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provenanceRequired": {
            "const": true
          },
          "authenticode": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "subject",
              "thumbprint",
              "timestampSubject"
            ],
            "properties": {
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "thumbprint": {
                "type": "string",
                "minLength": 1
              },
              "timestampSubject": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "authenticodeRequired": {
                  "const": true
                }
              },
              "required": [
                "authenticodeRequired"
              ]
            },
            "then": {
              "required": [
                "authenticode"
              ]
            }
          }
        ]
      }
    },
    "checksums": {
      "$ref": "#/$defs/safePath"
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^[A-Za-z]:|^[/\\\\]|(^|[/\\\\])\\.\\.([/\\\\]|$))"
      }
    },
    "source": {
      "type": "object",
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "branch": {
          "type": "string"
        },
        "upstreamCommit": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "hashRecord": {
      "type": "object",
      "required": [
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/safePath"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
