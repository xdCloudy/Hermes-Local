{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.hermes.invalid/schemas/llama-runtime-catalog.schema.json",
  "title": "Hermes Local llama.cpp runtime catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "component", "catalogVersion", "packages"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "component": { "const": "llama.cpp" },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/package" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "version", "distribution", "sourceRepository", "sourceCommit",
        "platform", "acceleration", "priority", "buildFlags", "cudaArchitectures",
        "compatibility", "artifacts", "licenses"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$" },
        "version": { "type": "string", "minLength": 1 },
        "distribution": { "enum": ["official"] },
        "sourceRepository": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/" },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "platform": { "const": "windows-x64" },
        "acceleration": { "enum": ["cpu", "cuda"] },
        "priority": { "type": "integer", "minimum": 0 },
        "buildFlags": { "type": "array", "items": { "type": "string" } },
        "cudaArchitectures": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{2,3}$" } },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimumWindowsBuild", "cpuFeatures", "runtimeRange"],
          "properties": {
            "minimumWindowsBuild": { "type": "integer", "minimum": 19045 },
            "cpuFeatures": { "type": "array", "items": { "enum": ["sse4.2", "avx", "avx2", "fma", "bmi2"] } },
            "minimumComputeCapability": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
            "maximumComputeCapability": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
            "minimumDriver": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$" },
            "runtimeRange": { "type": "string", "minLength": 1 }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "tag", "asset"],
            "properties": {
              "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
              "tag": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
              "asset": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,159}\\.zip$" },
              "expectedSha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "licenses": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
